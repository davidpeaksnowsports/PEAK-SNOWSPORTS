# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_READ_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=

# Formspree (contact form)
PUBLIC_FORMSPREE_ENDPOINT=

# Plausible (cookieless analytics — no consent banner required)
PUBLIC_PLAUSIBLE_DOMAIN=peaksnowsports.com

# Retargeting pixels — consent-gated (load only after the visitor accepts the
# cookie banner). Leave blank to disable both the pixels AND the banner.
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=

# Weglot
PUBLIC_WEGLOT_API_KEY=

# SkiOperator booking embed — server-only. Never expose to client (no PUBLIC_
# prefix). Set on Vercel (Preview + Production). This is the `sec_…` key
# issued in the SkiOperator admin; enter it directly in the secret manager,
# never paste it into chat or commit it.
SKI_OPERATOR_SECURE_KEY=
