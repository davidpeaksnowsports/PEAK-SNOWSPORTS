# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_READ_TOKEN=

# Resend (transactional email)
RESEND_API_KEY=

# Formspree (contact form)
PUBLIC_FORMSPREE_ENDPOINT=

# Plausible (cookieless analytics — no consent banner required)
PUBLIC_PLAUSIBLE_DOMAIN=peaksnowsports.com

# Retargeting pixels — consent-gated (load only after the visitor accepts the
# cookie banner). Leave blank to disable both the pixels AND the banner.
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=

# Weglot
PUBLIC_WEGLOT_API_KEY=

# SkiOperator booking embed — publishable-key mode.
# Optional overrides. The component (src/components/booking/SkiOperatorEmbed.astro)
# has the Peak Snowsports tenant + pub_ key hardcoded as defaults — pub_ keys
# are browser-safe per the SkiOperator docs, security is enforced by the
# origin allowlist in SkiOperator admin → Settings → Embed. Only set these
# if you need to point a build at a different tenant/key without editing
# the component (multi-tenant future, key rotation without code change, etc).
PUBLIC_SKI_OPERATOR_TENANT=
PUBLIC_SKI_OPERATOR_PUBLIC_KEY=
