---
import { PortableText } from 'astro-portabletext';
import JournalLayout from '../../layouts/JournalLayout.astro';
import Section from '../../components/ui/Section.astro';
import PostCard from '../../components/journal/PostCard.astro';
import { formatDate, portableTextReadingTime } from '../../lib/utils';
import { sanity, allPostsQuery, postBySlugQuery } from '../../lib/sanity';

interface PostSummary {
  _id: string;
  title: string;
  slug: string;
  hero?: { asset?: { _ref?: string } };
  publishedAt: string;
  category: string;
  author?: { name?: string; slug?: string };
  body?: unknown;
}

interface PostFull extends PostSummary {
  excerpt?: string;
  seoTitle?: string;
  seoDescription?: string;
}

export async function getStaticPaths() {
  const posts = await sanity.fetch<{ slug: string }[]>(allPostsQuery);
  return (posts ?? [])
    .filter((p) => !!p.slug)
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const { post, moreFromAuthor } = await sanity.fetch<{
  post: PostFull | null;
  moreFromAuthor: PostSummary[];
}>(postBySlugQuery, { slug });

if (!post) {
  return Astro.redirect('/journal');
}
---

<JournalLayout
  title={post.title}
  seoTitle={post.seoTitle ?? `${post.title} · Peak Journal`}
  description={post.seoDescription ?? post.excerpt}
  category={post.category}
  author={post.author?.name}
  publishedAt={post.publishedAt}
  date={formatDate(post.publishedAt)}
  hero={post.hero}
  heroAlt={post.title}
  readingMinutes={portableTextReadingTime(post.body)}
  slug={post.slug}
>
  <PortableText value={(post.body as any) ?? []} />
</JournalLayout>

{moreFromAuthor && moreFromAuthor.length > 0 && (
  <Section kicker={`More from ${post.author?.name ?? 'the team'}`} title="Keep reading.">
    <div class="grid gap-12 md:grid-cols-3">
      {moreFromAuthor.map((p) => (
        <PostCard
          title={p.title}
          category={p.category}
          author={p.author?.name}
          date={formatDate(p.publishedAt)}
          href={`/journal/${p.slug}`}
          hero={p.hero}
          readingMinutes={portableTextReadingTime(p.body)}
        />
      ))}
    </div>
  </Section>
)}
