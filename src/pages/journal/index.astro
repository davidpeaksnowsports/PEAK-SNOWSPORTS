---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Section from '../../components/ui/Section.astro';
import PostCard from '../../components/journal/PostCard.astro';
import heroImage from '../../assets/images/hero-journal.jpg';
import { formatDate, portableTextReadingTime } from '../../lib/utils';
import { sanity, allPostsQuery } from '../../lib/sanity';

interface Post {
  _id: string;
  title: string;
  slug: string;
  hero?: { asset?: { _ref?: string } };
  excerpt?: string;
  publishedAt: string;
  category: string;
  author?: { name?: string; slug?: string };
  body?: unknown;
}

const posts = (await sanity.fetch<Post[]>(allPostsQuery)) ?? [];

// Categories with counts, only show categories that have at least one post.
const categoryCounts = new Map<string, number>();
posts.forEach((p) => {
  categoryCounts.set(p.category, (categoryCounts.get(p.category) ?? 0) + 1);
});
const categories = [{ label: 'All', href: '/journal', count: posts.length }];
[...categoryCounts.keys()].sort().forEach((c) => {
  categories.push({
    label: c,
    href: `/journal/category/${c.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
    count: categoryCounts.get(c) ?? 0,
  });
});

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Peak Journal · Ski guides, kit reviews & technique notes · Peak Snowsports"
  description="Long-form posts from the Peak Snowsports team. Resort guides, kit reviews, season updates, technique tips, GAP stories and instructor profiles."
  image="/images/og/journal.jpg"
>
  <Hero
    kicker="Journal"
    headline="Words from the team."
    sub="Resort guides, kit reviews, technique notes, season updates, written by the people teaching."
    variant="compact"
    image={heroImage}
    imageAlt="Snow-laden pine forest against a pale alpine sky."
  />

  <Section>
    <div class="flex flex-wrap gap-3">
      {categories.map((c, i) => (
        <a
          href={c.href}
          class={`meta rounded-sm border px-4 py-2 no-underline transition ${i === 0 ? 'border-accent bg-accent text-snow' : 'border-ink/20 text-ink-70 hover:border-accent hover:text-accent'}`}
        >
          {c.label}
          <span class="ml-1 text-olive-deep/40">{c.count}</span>
        </a>
      ))}
    </div>

    {featured && (
      <div class="mt-16">
        <PostCard
          title={featured.title}
          category={featured.category}
          author={featured.author?.name}
          date={formatDate(featured.publishedAt)}
          href={`/journal/${featured.slug}`}
          hero={featured.hero}
          readingMinutes={portableTextReadingTime(featured.body)}
          featured
        />
      </div>
    )}

    {rest.length > 0 && (
      <div class="mt-16 grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <PostCard
            title={p.title}
            category={p.category}
            author={p.author?.name}
            date={formatDate(p.publishedAt)}
            href={`/journal/${p.slug}`}
            hero={p.hero}
            readingMinutes={portableTextReadingTime(p.body)}
          />
        ))}
      </div>
    )}

    {posts.length === 0 && (
      <p class="mt-16 text-olive/60">No posts yet. Check back soon.</p>
    )}
  </Section>
</BaseLayout>
