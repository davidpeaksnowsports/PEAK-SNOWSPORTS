---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/hero/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import PostCard from '../../../components/journal/PostCard.astro';
import heroImage from '../../../assets/images/hero-journal.jpg';
import { formatDate, portableTextReadingTime } from '../../../lib/utils';
import { sanity, allPostsQuery } from '../../../lib/sanity';

interface Post {
  _id: string;
  title: string;
  slug: string;
  hero?: { asset?: { _ref?: string } };
  publishedAt: string;
  category: string;
  author?: { name?: string; slug?: string };
  body?: unknown;
}

export async function getStaticPaths() {
  const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  const posts = (await sanity.fetch<Post[]>(allPostsQuery)) ?? [];
  const uniqueCategories = [...new Set(posts.map((p) => p.category).filter(Boolean))];
  return uniqueCategories.map((category) => ({
    params: { category: toSlug(category) },
    props: { categoryName: category, allPosts: posts },
  }));
}

const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const { categoryName, allPosts } = Astro.props as { categoryName: string; allPosts: Post[] };
const posts = allPosts.filter((p) => p.category === categoryName);

const categoryCounts = new Map<string, number>();
allPosts.forEach((p) => {
  categoryCounts.set(p.category, (categoryCounts.get(p.category) ?? 0) + 1);
});

const categories = [{ label: 'All', href: '/journal', count: allPosts.length, isActive: false }];
[...categoryCounts.keys()].sort().forEach((c) => {
  categories.push({
    label: c,
    href: `/journal/category/${toSlug(c)}`,
    count: categoryCounts.get(c) ?? 0,
    isActive: c === categoryName,
  });
});
---

<BaseLayout title={`${categoryName}, Peak Journal`}>
  <Hero
    kicker={`Journal · ${categoryName}`}
    headline={categoryName + '.'}
    sub={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} in this category.`}
    variant="compact"
    image={heroImage}
    imageAlt="Snow-laden pine forest against a pale alpine sky."
  />

  <Section>
    <div class="flex flex-wrap gap-3">
      {categories.map((c) => (
        <a
          href={c.href}
          class={`meta rounded-full border px-4 py-2 no-underline transition ${c.isActive ? 'border-yellow bg-yellow text-olive-deep' : 'border-olive/20 text-olive/70 hover:border-yellow hover:bg-yellow hover:text-olive-deep'}`}
        >
          {c.label}
          <span class={`ml-1 ${c.isActive ? 'text-olive-deep/40' : 'text-olive/40'}`}>{c.count}</span>
        </a>
      ))}
    </div>

    <div class="mt-16 grid gap-12 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <PostCard
          title={p.title}
          category={p.category}
          author={p.author?.name}
          date={formatDate(p.publishedAt)}
          href={`/journal/${p.slug}`}
          hero={p.hero}
          readingMinutes={portableTextReadingTime(p.body)}
        />
      ))}
    </div>
  </Section>
</BaseLayout>
