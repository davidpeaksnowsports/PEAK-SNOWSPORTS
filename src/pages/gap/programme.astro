---
/**
 * Course programme.
 *
 * Three views, switched by query string rather than JavaScript, so each is a
 * real URL a student can bookmark or a coach can paste into WhatsApp:
 *
 *   today  the day's sessions as full cards
 *   week   one course week as a table (?week=n picks which, default current)
 *   all    the visual planner for the whole course, then every week's table
 *
 * The planner mirrors the coaches' spreadsheet; the tables carry the detail.
 */
export const prerender = false;

import GapLayout from '../../layouts/GapLayout.astro';
import Notice from '../../components/gap-portal/Notice.astro';
import PhotoBand from '../../components/gap-portal/PhotoBand.astro';
import ActivityCard from '../../components/gap-portal/ActivityCard.astro';
import CoursePlanner from '../../components/gap-portal/CoursePlanner.astro';
import WeekTable from '../../components/gap-portal/WeekTable.astro';
import { createGapClient, type GapUser } from '../../lib/gap/supabase';
import { courseWeek, dayKey, fmtLongDate } from '../../lib/gap/course';
import { buildPlan, type PlanActivity } from '../../lib/gap/programme';

const user = Astro.locals.gapUser as GapUser;
const cohort = user.cohort;
const db = createGapClient(Astro.cookies, Astro.request);

type View = 'today' | 'week' | 'all';
const raw = Astro.url.searchParams.get('view');
const view: View = raw === 'today' || raw === 'all' ? raw : 'week';

const week = cohort
  ? courseWeek(cohort)
  : { week: 0, totalWeeks: 0, daysUntilStart: 0, finished: false };

// The whole programme is ~70 rows, so every view fetches all of it and
// slices locally. That keeps the week maths in one place (buildPlan).
const { data } = cohort
  ? await db
      .from('gap_activities')
      .select('*')
      .eq('cohort_id', cohort.id)
      .order('starts_at')
  : { data: [] };

const activities = (data ?? []) as PlanActivity[];
const plan = cohort ? buildPlan(activities, cohort) : [];
const today = dayKey(new Date());

// Before the course starts, "this week" means its first week.
const currentWeek = Math.max(1, week.week);
const asked = Number(Astro.url.searchParams.get('week'));
const selectedWeek =
  Number.isInteger(asked) && asked >= 1 && asked <= plan.length ? asked : currentWeek;
const shownWeek = plan[selectedWeek - 1];

/** Planner cells on the full-course view jump to that day's table row. */
const dayLink = (_week: number, day: string) => `#day-${day}`;

const todays = activities.filter((a) => dayKey(a.starts_at) === today);

/**
 * A webcal-style .ics for the whole cohort programme, generated by the sibling
 * endpoint. Subscribing beats downloading each session one at a time, and a
 * subscription keeps updating when the coach moves things, which, given the
 * weather, is the normal case rather than the exception.
 */
const calendarUrl = '/gap/programme.ics';

const views: { key: View; label: string }[] = [
  { key: 'today', label: 'Today' },
  { key: 'week', label: `Week ${currentWeek}` },
  { key: 'all', label: 'Full course' },
];
---

<GapLayout
  title="Programme"
  kicker={cohort ? `${cohort.name} · ${cohort.resort}` : 'Peak GAP'}
  heading="Programme"
  intro="Sessions move when the weather and the snow move. This page is always the current version. Check it the night before."
>
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 pb-4">
    <nav aria-label="Programme view">
      <ul class="flex gap-1">
        {
          views.map((v) => (
            <li>
              <a
                href={`/gap/programme?view=${v.key}`}
                aria-current={view === v.key ? 'page' : undefined}
                class:list={[
                  'meta block px-4 py-2 no-underline transition-colors hover:no-underline',
                  view === v.key
                    ? 'bg-accent text-paper'
                    : 'border border-ink/20 text-ink-70 hover:border-ink hover:text-ink',
                ]}
              >
                {v.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={calendarUrl} class="meta text-accent">Add to calendar</a>
  </div>

  <PhotoBand
    photo="carving"
    alt="A skier in the olive uniform carving hard at speed, snow spraying off the skis, a chairlift overhead"
    aspect="aspect-[600/340]"
    width="w-full max-w-[600px]"
  />

  {
    !cohort || activities.length === 0 ? (
      <div class="mt-8">
        <Notice>
          <p>
            Nothing published yet. Coaches confirm each week once the forecast
            is in.
          </p>
        </Notice>
      </div>
    ) : view === 'today' ? (
      <div class="mt-10">
        <p class="meta text-ink-45">{fmtLongDate(new Date())}</p>
        {todays.length === 0 ? (
          <div class="mt-4">
            <Notice>
              <p>
                Nothing scheduled today.{' '}
                <a href="/gap/programme?view=week">See the week</a>.
              </p>
            </Notice>
          </div>
        ) : (
          <div class="mt-4">
            {todays.map((a) => (
              <ActivityCard activity={a} />
            ))}
          </div>
        )}
      </div>
    ) : view === 'week' && shownWeek ? (
      <div class="mt-10">
        <nav aria-label="Choose a week" class="mb-8 flex flex-wrap gap-1">
          {plan.map((w) => (
            <a
              href={`/gap/programme?view=week&week=${w.week}`}
              aria-current={w.week === selectedWeek ? 'page' : undefined}
              class:list={[
                'meta block px-3 py-1.5 no-underline transition-colors hover:no-underline',
                w.week === selectedWeek
                  ? 'bg-ink text-paper'
                  : 'border border-ink/20 text-ink-70 hover:border-ink hover:text-ink',
              ]}
            >
              Week {w.week}
            </a>
          ))}
        </nav>
        <WeekTable week={shownWeek} today={today} />
      </div>
    ) : (
      <div class="mt-10">
        <section aria-labelledby="planner-title">
          <p class="meta text-ink-45">
            {fmtLongDate(cohort.starts_on)} to {fmtLongDate(cohort.ends_on)}
          </p>
          <h2 id="planner-title" class="mt-1 font-display text-2xl font-bold md:text-3xl">
            Course planner
          </h2>
          <p class="mt-2 max-w-2xl text-ink-70">
            All six weeks at a glance. Tap any session to jump to that day.
          </p>
          <div class="mt-6">
            <CoursePlanner weeks={plan} today={today} linkFor={dayLink} />
          </div>
        </section>

        <div class="mt-16 space-y-16 border-t border-ink/10 pt-10">
          {plan.map((w) => (
            <WeekTable week={w} today={today} />
          ))}
        </div>
      </div>
    )
  }
</GapLayout>
