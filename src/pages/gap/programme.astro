---
/**
 * Course programme.
 *
 * Three views — today, this week, the whole course — switched by query string
 * rather than JavaScript, so each is a real URL a student can bookmark or a
 * coach can paste into WhatsApp.
 *
 * There is no separate month-grid calendar view. On the phone that most of
 * this traffic comes from, a grid of six-week cells shows less than the list
 * does; "add to calendar" hands the job to the app that is actually good at
 * it.
 */
export const prerender = false;

import GapLayout from '../../layouts/GapLayout.astro';
import Notice from '../../components/gap-portal/Notice.astro';
import PhotoBand from '../../components/gap-portal/PhotoBand.astro';
import carving from '../../assets/images/gap/carving.jpg';
import ActivityCard from '../../components/gap-portal/ActivityCard.astro';
import { createGapClient, type GapUser } from '../../lib/gap/supabase';
import { courseWeek, dayKey, fmtDate, fmtLongDate } from '../../lib/gap/course';

const user = Astro.locals.gapUser as GapUser;
const cohort = user.cohort;
const db = createGapClient(Astro.cookies, Astro.request);

type View = 'today' | 'week' | 'all';
const raw = Astro.url.searchParams.get('view');
const view: View = raw === 'today' || raw === 'all' ? raw : 'week';

const week = cohort
  ? courseWeek(cohort)
  : { week: 0, totalWeeks: 0, daysUntilStart: 0, finished: false };

// Which window each view covers. The week view is the course's own week —
// seven days from the cohort start date — not Monday to Sunday, because a
// course starting on a Sunday would otherwise show a one-day first week.
let from: Date;
let to: Date;
const start = cohort ? new Date(`${cohort.starts_on}T00:00:00`) : new Date();

if (view === 'today') {
  from = new Date();
  from.setHours(0, 0, 0, 0);
  to = new Date(from);
  to.setDate(to.getDate() + 1);
} else if (view === 'all') {
  from = start;
  to = cohort ? new Date(`${cohort.ends_on}T23:59:59`) : new Date();
} else {
  // Before the course starts, "this week" means its first week.
  const index = Math.max(0, week.week - 1);
  from = new Date(start);
  from.setDate(from.getDate() + index * 7);
  to = new Date(from);
  to.setDate(to.getDate() + 7);
}

const { data } = cohort
  ? await db
      .from('gap_activities')
      .select('*')
      .eq('cohort_id', cohort.id)
      .gte('starts_at', from.toISOString())
      .lt('starts_at', to.toISOString())
      .order('starts_at')
  : { data: [] };

const activities = data ?? [];

// Group into days so the list reads as a diary rather than a flat feed.
const days = new Map<string, typeof activities>();
for (const a of activities) {
  const key = dayKey(a.starts_at);
  if (!days.has(key)) days.set(key, []);
  days.get(key)!.push(a);
}

/**
 * A webcal-style .ics for the whole cohort programme, generated by the sibling
 * endpoint. Subscribing beats downloading each session one at a time, and a
 * subscription keeps updating when the coach moves things — which, given the
 * weather, is the normal case rather than the exception.
 */
const calendarUrl = '/gap/programme.ics';

const views: { key: View; label: string }[] = [
  { key: 'today', label: 'Today' },
  { key: 'week', label: `Week ${Math.max(1, week.week)}` },
  { key: 'all', label: 'Full course' },
];
---

<GapLayout
  title="Programme"
  kicker={cohort ? `${cohort.name} · ${cohort.resort}` : 'Peak GAP'}
  heading="Programme"
  intro="Sessions move when the weather and the snow move. This page is always the current version. Check it the night before."
>
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-ink/10 pb-4">
    <nav aria-label="Programme view">
      <ul class="flex gap-1">
        {
          views.map((v) => (
            <li>
              <a
                href={`/gap/programme?view=${v.key}`}
                aria-current={view === v.key ? 'page' : undefined}
                class:list={[
                  'meta block px-4 py-2 no-underline transition-colors hover:no-underline',
                  view === v.key
                    ? 'bg-accent text-paper'
                    : 'border border-ink/20 text-ink-70 hover:border-ink hover:text-ink',
                ]}
              >
                {v.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={calendarUrl} class="meta text-accent">Add to calendar</a>
  </div>

  {
    cohort && (
      <p class="meta mt-4 text-ink-45">
        {view === 'all'
          ? `${fmtLongDate(cohort.starts_on)} – ${fmtLongDate(cohort.ends_on)}`
          : `${fmtLongDate(from)} – ${fmtLongDate(new Date(to.getTime() - 1))}`}
      </p>
    )
  }

  <PhotoBand
    image={carving}
    alt="A skier in the olive uniform carving hard at speed, snow spraying off the skis, a chairlift overhead"
    aspect="aspect-[600/340]"
    width="w-full max-w-[600px]"
  />

  {
    days.size === 0 ? (
      <div class="mt-8">
        <Notice>
          <p>
            Nothing published for this period yet. Coaches confirm each week
            once the forecast is in.
          </p>
        </Notice>
      </div>
    ) : (
      <div class="mt-10 space-y-12">
        {[...days.entries()].map(([day, items]) => (
          <section>
            <h2 class="font-display text-xl font-bold">{fmtDate(day)}</h2>
            <div class="mt-4">
              {items.map((a) => (
                <ActivityCard activity={a} />
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</GapLayout>
