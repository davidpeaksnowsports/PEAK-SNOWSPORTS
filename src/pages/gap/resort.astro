---
/**
 * Resort guide.
 *
 * Practical, not a destination guide: where to meet, where the pharmacy is,
 * which bus goes where. Grouped by category and driven entirely from the
 * database so a coach can correct a meeting point in the season rather than
 * waiting on a deploy.
 */
export const prerender = false;

import GapLayout from '../../layouts/GapLayout.astro';
import Notice from '../../components/gap-portal/Notice.astro';
import { createGapClient, type GapUser } from '../../lib/gap/supabase';

const user = Astro.locals.gapUser as GapUser;
const cohort = user.cohort;
const db = createGapClient(Astro.cookies, Astro.request);

const { data } = cohort
  ? await db
      .from('gap_guide_entries')
      .select('*')
      .eq('cohort_id', cohort.id)
      .order('sort')
      .order('name')
  : { data: [] };

const entries = data ?? [];

const categories = new Map<string, typeof entries>();
for (const e of entries) {
  if (!categories.has(e.category)) categories.set(e.category, []);
  categories.get(e.category)!.push(e);
}

// Anchor ids so the dashboard and essentials pages can link to a category.
const slug = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<GapLayout
  title="Resort guide"
  kicker={cohort ? `${cohort.resort}` : undefined}
  heading="Resort guide"
  intro="Where things are and how to get to them. Every entry has a map link — save them to your phone on day one and you will not think about it again."
>
  {
    entries.length === 0 ? (
      <Notice>
        <p>The guide for your resort hasn't been published yet.</p>
      </Notice>
    ) : (
      <>
        <nav aria-label="Categories" class="border-b border-ink/10 pb-4">
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {[...categories.keys()].map((c) => (
              <li>
                <a href={`#${slug(c)}`} class="meta text-ink-70 hover:text-ink">
                  {c}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="mt-10 space-y-14">
          {[...categories.entries()].map(([category, rows]) => (
            <section id={slug(category)} class="scroll-mt-6">
              <h2 class="font-display text-2xl font-bold">{category}</h2>
              <ul class="mt-5 grid gap-px border border-ink/10 bg-ink/10 sm:grid-cols-2">
                {rows.map((e) => (
                  <li class="bg-paper p-5">
                    <h3 class="font-display text-lg font-bold">{e.name}</h3>
                    {e.detail && <p class="mt-1 text-ink-70">{e.detail}</p>}
                    <dl class="mt-3 space-y-1 text-sm">
                      {e.address && (
                        <div>
                          <dt class="meta inline text-ink-45">Address </dt>
                          <dd class="inline text-ink-70">{e.address}</dd>
                        </div>
                      )}
                      {e.hours && (
                        <div>
                          <dt class="meta inline text-ink-45">Hours </dt>
                          <dd class="inline text-ink-70">{e.hours}</dd>
                        </div>
                      )}
                      {e.phone && (
                        <div>
                          <dt class="meta inline text-ink-45">Phone </dt>
                          <dd class="inline">
                            <a href={`tel:${e.phone.replace(/\s/g, '')}`} class="text-accent">
                              {e.phone}
                            </a>
                          </dd>
                        </div>
                      )}
                    </dl>
                    {e.map_url && (
                      <p class="mt-3">
                        <a href={e.map_url} target="_blank" rel="noopener" class="text-accent">
                          Open in Maps →
                        </a>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    )
  }
</GapLayout>
