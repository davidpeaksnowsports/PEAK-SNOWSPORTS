---
/**
 * Off-snow learning hub.
 *
 * Organised by course week, then by topic, because that is how the material is
 * actually taught — a student looking for last Tuesday's movement-analysis
 * workshop thinks "week two", not "video".
 *
 * Video is hosted elsewhere (Vimeo or unlisted YouTube) and linked, not
 * uploaded: hosting video is a phase-two problem and not one worth solving
 * before the first cohort sees the hub at all.
 */
export const prerender = false;

import GapLayout from '../../layouts/GapLayout.astro';
import Notice from '../../components/gap-portal/Notice.astro';
import VideoEmbed from '../../components/gap-portal/VideoEmbed.astro';
import { createGapClient, type GapUser } from '../../lib/gap/supabase';
import { courseWeek } from '../../lib/gap/course';

const user = Astro.locals.gapUser as GapUser;
const cohort = user.cohort;
const db = createGapClient(Astro.cookies, Astro.request);

const KIND_LABEL: Record<string, string> = {
  video: 'Video',
  slides: 'Slides',
  reading: 'Reading',
  exercise: 'Exercise',
  template: 'Template',
  link: 'Link',
};

const { data } = cohort
  ? await db
      .from('gap_resources')
      .select('*')
      .eq('cohort_id', cohort.id)
      .order('week', { nullsFirst: false })
      .order('sort')
      .order('title')
  : { data: [] };

const resources = data ?? [];

// Group by week, with everything week-less collected under "Any time" at the
// end — reference material that isn't tied to a session.
const weeks = new Map<number | null, typeof resources>();
for (const r of resources) {
  const key = (r.week as number | null) ?? null;
  if (!weeks.has(key)) weeks.set(key, []);
  weeks.get(key)!.push(r);
}
const ordered = [...weeks.entries()].sort(([a], [b]) => {
  if (a === null) return 1;
  if (b === null) return -1;
  return a - b;
});

const currentWeek = cohort ? courseWeek(cohort).week : 0;

/**
 * The YouTube id in a watch, short or embed URL, or null for anything else.
 * Videos hosted elsewhere keep working as ordinary links.
 */
function youtubeId(url: string | null): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname === 'youtu.be') return u.pathname.slice(1) || null;
    if (u.hostname.endsWith('youtube.com') || u.hostname.endsWith('youtube-nocookie.com')) {
      if (u.searchParams.get('v')) return u.searchParams.get('v');
      const m = u.pathname.match(/^\/(?:embed|shorts)\/([\w-]{6,})/);
      return m ? m[1] : null;
    }
  } catch {
    // Not a URL at all; treat it as a plain link.
  }
  return null;
}
---

<GapLayout
  title="Learning hub"
  kicker={cohort?.name}
  heading="Learning hub"
  intro="Lectures, workshop material and the reading behind it. Everything from a session appears here within a day of that session."
>
  {
    resources.length === 0 ? (
      <Notice>
        <p>
          Nothing published yet. Workshop recordings and slides land here as the
          course runs.
        </p>
      </Notice>
    ) : (
      <div class="space-y-14">
        {ordered.map(([week, items]) => (
          <section>
            <div class="flex items-baseline gap-4 border-b border-ink/10 pb-3">
              <h2 class="font-display text-2xl font-bold">
                {week === null ? 'Any time' : `Week ${week}`}
              </h2>
              {week === currentWeek && week !== null && (
                <span class="meta text-accent">This week</span>
              )}
            </div>

            <ul class="mt-6 space-y-6">
              {items.map((r) => (
                <li class="border-t border-ink/10 pt-5 first:border-t-0 first:pt-0">
                  <p class="meta text-ink-45">
                    {r.topic} · {KIND_LABEL[r.kind] ?? r.kind}
                    {r.storage_path && ' · Course material'}
                  </p>
                  <h3 class="mt-1 font-display text-lg font-bold">
                    <a
                      href={r.storage_path ? `/gap/resource/${r.id}` : r.url}
                      target="_blank"
                      rel="noopener"
                      class="text-ink hover:text-accent"
                    >
                      {r.title}
                    </a>
                  </h3>
                  {r.description && (
                    <p class="mt-1 max-w-2xl text-ink-70">{r.description}</p>
                  )}
                  {r.kind === 'video' && r.storage_path && (
                    <div class="mt-4 max-w-2xl bg-ink">
                      {/* Plays through the signing endpoint, so the file is
                          only reachable by a signed-in member. #t=0.1 asks the
                          browser to paint the first frame as a preview rather
                          than a black box. */}
                      <video
                        controls
                        playsinline
                        preload="metadata"
                        src={`/gap/resource/${r.id}#t=0.1`}
                        class="block w-full"
                        aria-label={r.title}
                      />
                    </div>
                  )}
                  {r.kind === 'video' && !r.storage_path && youtubeId(r.url) && (
                    <div class="mt-4">
                      <VideoEmbed videoId={youtubeId(r.url)!} title={r.title} />
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</GapLayout>
