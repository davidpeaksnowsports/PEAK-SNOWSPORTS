---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Section from '../components/ui/Section.astro';
import EnquiryForm from '../components/gap/EnquiryForm.astro';
import StickyCta from '../components/gap/StickyCta.astro';
import LeadMagnet from '../components/gap/LeadMagnet.astro';
import heroImage from '../assets/images/hero-gap.jpg';
import { whatsappHref } from '../lib/whatsapp';

const included = [
  {
    title: 'On-snow',
    items: [
      '100+ hours of training, BASI trainers only',
      'BASI Level 1 and Level 2 exams',
      '8:1 student-to-trainer maximum',
      'Racing, freestyle, piste performance, demos, off-piste',
      'Mock assessment days',
      'Teaching sessions to nail the assessment models',
    ],
  },
  {
    title: 'Off-snow',
    items: [
      'Outdoor First Aid Course',
      'Workshops on equipment, avalanche, career and more',
      'Video analysis sessions',
      'Theory sessions on technical + teaching concepts',
      'Team merch and team puffer',
      'Interview prep for teaching positions',
    ],
  },
  {
    title: 'Pastoral care',
    items: [
      '24/7 care line and WhatsApp community group',
      'In-resort pastoral care with weekly room reviews',
      'Weekly 1-2-1s with the training team',
      'Social events and supervised après parties',
      'Alumni channel',
      'Training mentality workshop',
    ],
  },
  {
    title: 'Living',
    items: [
      'Private Peak chalet in Morzine',
      'Proper community, not a block of apartments',
      'Easy access to Avoriaz lifts each morning',
      'Pro discount on skis, boots, poles, helmets, goggles, clothing and packs',
      'Morzine bars, restaurants and après on your doorstep',
      'End-of-course party',
      'One-way transfer from Geneva airport',
    ],
  },
];

// FAQs are ordered intent-first: the questions people actually search
// ("how do you become a ski instructor", "how much does it cost") lead, then
// the practical logistics. Each answer leads with a direct, extractable
// answer so it can be lifted into AI answers and featured snippets.
const faqs = [
  {
    q: 'How do you become a ski instructor?',
    a: "You qualify through a recognised instructor body, in the UK that's BASI (the British Association of Snowsport Instructors). The usual route is BASI Level 1 then Level 2: Level 1 lets you teach on indoor and dry slopes, Level 2 is the first mountain qualification and lets you teach parallel skiers on marked pistes. Our GAP course takes you through both in six weeks: 100+ hours of on-snow coaching from BASI trainers, the Level 1 and Level 2 exams, Outdoor First Aid, and the career workshops to get you working straight after.",
  },
  {
    q: 'Do I need experience to take a ski instructor course?',
    a: "No teaching experience, just solid skiing. You should arrive a confident parallel skier who can comfortably ski most red runs and link parallel turns. You don't need to be an expert or a racer, our coaching takes you from that level up to the Level 1 and Level 2 standard. If you're not sure whether you're ready, send us a video clip or book a call and we'll tell you honestly.",
  },
  {
    q: 'How much does it cost to become a ski instructor?',
    a: "The Peak GAP course is €8,999 for the standard package, or €9,499 for a single-occupancy upgraded room. That's all-in: 100+ hours of coaching, both BASI exam fees, Outdoor First Aid, six weeks in a private Peak chalet, kit discounts and your Geneva transfer. Staged payments start from a €150 deposit. On top of the course you'll budget separately for BASI membership, travel insurance, a lift pass and personal kit.",
  },
  {
    q: 'How long does it take to qualify as a ski instructor?',
    a: "Six weeks with us, start to qualified. Our GAP course runs the BASI Level 1 and Level 2 training and exams back-to-back, so you finish the six weeks holding both qualifications. The winter intake wraps just before February half-term, so you can be teaching a full week post-course.",
  },
  {
    q: 'What is the difference between BASI Level 1 and Level 2?',
    a: "BASI Level 1 qualifies you to teach beginners on indoor snow centres and dry slopes in a controlled environment. BASI Level 2 is the first mountain-based qualification, it qualifies you to teach parallel skiers on marked pistes at a resort, and it's the level most alpine ski schools hire from. Our course delivers both, so you leave able to work on the mountain, not just on indoor slopes.",
  },
  {
    q: 'How fit do I need to be?',
    a: "Reasonably fit, you'll be skiing six days a week for six weeks. You don't need to be an athlete, but the fitter you arrive the more you'll get out of every session and the faster you'll progress. We send a pre-course conditioning guide on enrolment so you turn up ready to ski hard from day one.",
  },
  {
    q: 'What do I need to do to pass?',
    a: "Trust the training. We've built a tested programme of technical and teaching sessions, off-snow workshops, and weekly benchmarking. The assessment criteria are set by BASI, for Level 1 and Level 2, and our curriculum is designed to get you above the required standard for both. Attendance at every session is what gets students through.",
  },
  {
    q: 'What’s the training system?',
    a: 'Learner-centred. We use a benchmarking approach so the wider curriculum stays consistent across the cohort, but every student gets personalised sessions within it. Open and closed skills are tested at regular intervals so you always know where you are.',
  },
  {
    q: 'Where can I work after qualifying, and can you make a living as a ski instructor?',
    a: "Level 1 lets you teach at UK snow centres and dry slopes. Level 2 is the first mountain-based qualification, you can teach parallel on marked pistes, and it's the level most alpine ski schools hire from. We've a partnership with a Champéry ski school that interviews on-course and takes BASI L2s directly, so plenty of students walk into paid work straight after. The winter intake finishes just before February half-term, so you can be working a full week post-course. Many instructors build a career chasing winters in the Alps and summers in the southern hemisphere, New Zealand, Switzerland, USA, Italy and Andorra all require work permits and have country-specific routes, we cover all of this in career workshops on course.",
  },
  {
    q: 'What do I pack?',
    a: "Avoriaz hits -20°C with a -30 wind chill in deep winter, bring warm, waterproof, layerable kit. The essentials: skis + boots + poles (or rent through our hire partners), helmet (mandatory), goggles, Gore-Tex jacket + pants, merino base layers, two sets of gloves and beanies, five pairs of ski socks, a 15L pack. A team down jacket is included with the course. You'll get the full checklist on enrolment.",
  },
  {
    q: 'What insurance do I need?',
    a: "At minimum: travel insurance covering medical and evacuation, accident/personal accident insurance for ski-related injury, and equipment cover. Liability insurance for instructing comes free with your BASI membership once you qualify. World Nomads, Allianz and AXA all cover sports professionals, confirm geographical scope (France + Switzerland) and off-piste coverage if applicable.",
  },
  {
    q: 'What if I fail an assessment?',
    a: "Rare, but it happens. If you fail Level 1, we organise a reassessment within your six-week window (small additional BASI fee, possibly extra training fees). If you fail Level 2, the official GAP programme has concluded, you book a standalone reassessment with BASI directly. Either way, reassessments must be taken within two years. We continue coaching at an additional fee if you need it.",
  },
  {
    q: 'What is the Peak community like?',
    a: "Important to us. You join the Peak alumni from day one, private Slack channels for trainees, instructors and mentors, ongoing workshops, mentorship pairings with seasoned coaches, peer learning groups. The community runs well past graduation: alumni stay in touch, share work opportunities, and there's always a space on our chairlifts for you.",
  },
];

// Single source of truth for testimonials: drives both the visible section and
// the Course schema's review list + reviewCount, so they can never drift apart.
// Only real, attributable graduate quotes belong here (Google penalises
// fabricated review markup).
const testimonials = [
  {
    name: 'Ella Mayhew',
    year: '2026',
    quote:
      'A great experience with Peak training. I highly recommend this ski school if you want to become a ski instructor. Excellent support and highly qualified instructors. In a word: I recommend PEAK.',
  },
  {
    name: 'Katie Work',
    year: '2026',
    quote:
      "The team at Peak are exceptional — they are extremely knowledgeable and can cater to a wide variety of levels and experience. Coming into the course I wasn't sure what to expect, but the team helped to outline the entire course with clear goals. They improved my skiing dramatically throughout the course and gave us all the tools needed to help through exams. Super professional and heaps of fun. Would recommend.",
  },
  {
    name: 'Neil',
    year: '2024',
    quote:
      'High quality of training first and foremost. Enthusiasm and humour of fellow students made it very memorable!',
  },
];

const SITE = 'https://www.peaksnowsports.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    '@id': `${SITE}/gap-course#course`,
    name: 'BASI Ski Instructor Course (GAP) · Six weeks to BASI Level 1 + 2',
    url: `${SITE}/gap-course`,
    description:
      'Six-week ski instructor training course covering BASI Level 1 and Level 2 qualifications. 100+ hours of on-snow training delivered by BASI trainers only, 8:1 student-to-trainer maximum. Two intakes per year: autumn pre-season in Hintertux, Austria, and winter in-season in Morzine + Avoriaz, France.',
    keywords:
      'ski instructor course, how to become a ski instructor, BASI Level 1, BASI Level 2, ski instructor gap year, ski instructor training, ski instructor internship',
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      bestRating: '5',
      worstRating: '1',
      reviewCount: String(testimonials.length),
    },
    review: testimonials.map((t) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: t.name },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: t.quote,
    })),
    provider: {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Peak Snowsports',
      url: SITE,
      telephone: '+44-1483-616522',
      logo: `${SITE}/images/logos/peak-menu-logo.png`,
      sameAs: SITE,
    },
    about: [
      { '@type': 'Thing', name: 'Ski instructor training' },
      { '@type': 'Thing', name: 'BASI qualification' },
    ],
    educationalCredentialAwarded:
      'BASI Level 1 and Level 2 (British Association of Snowsport Instructors)',
    occupationalCredentialAwarded:
      'BASI Alpine Level 1 and Level 2 ski instructor qualification',
    coursePrerequisites:
      'A confident parallel skier comfortable on most red runs. No prior teaching experience required.',
    audience: {
      '@type': 'EducationalAudience',
      educationalRole: 'student',
      audienceType: 'Aspiring ski instructors, gap-year students and career-changers',
    },
    timeRequired: 'P6W',
    inLanguage: 'en',
    teaches: [
      'BASI Level 1 and Level 2 assessment standard',
      'Teaching skiing technique on-piste',
      'Off-piste skiing and avalanche awareness',
      'Outdoor First Aid',
      'Career routes for newly-qualified ski instructors',
    ],
    offers: [
      {
        '@type': 'Offer',
        category: 'Standard package',
        price: '8999',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${SITE}/gap-course#book`,
      },
    ],
    hasCourseInstance: [
      {
        '@type': 'CourseInstance',
        name: 'Autumn pre-season intake · Hintertux, Austria',
        description:
          'Pre-season ski instructor course on the Hintertux glacier, Austria. BASI Level 1 + 2.',
        startDate: '2026-11-01',
        endDate: '2026-12-11',
        courseMode: 'In person',
        courseWorkload: 'P6W',
        location: {
          '@type': 'Place',
          name: 'Hintertux, Austria',
          address: { '@type': 'PostalAddress', addressCountry: 'AT' },
        },
        offers: [
          {
            '@type': 'Offer',
            name: 'Standard package',
            price: '8999',
            priceCurrency: 'EUR',
            availability: 'https://schema.org/InStock',
            url: `${SITE}/gap-course#book`,
          },
          {
            '@type': 'Offer',
            name: 'Upgraded room',
            price: '9499',
            priceCurrency: 'EUR',
            availability: 'https://schema.org/LimitedAvailability',
            url: `${SITE}/gap-course#book`,
          },
        ],
      },
      {
        '@type': 'CourseInstance',
        name: 'Winter in-season intake · Morzine + Avoriaz',
        description:
          'In-season ski instructor course based in Morzine, training in Avoriaz (Portes du Soleil), France. BASI Level 1 + 2.',
        startDate: '2027-01-03',
        endDate: '2027-02-12',
        courseMode: 'In person',
        courseWorkload: 'P6W',
        location: {
          '@type': 'Place',
          name: 'Morzine, France',
          address: { '@type': 'PostalAddress', addressLocality: 'Morzine', addressCountry: 'FR' },
        },
        offers: [
          {
            '@type': 'Offer',
            name: 'Standard package',
            price: '8999',
            priceCurrency: 'EUR',
            availability: 'https://schema.org/InStock',
            url: `${SITE}/gap-course#book`,
          },
        ],
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Ski Instructor Course', item: `${SITE}/gap-course` },
    ],
  },
];

const reasons = [
  {
    title: 'Coached by the examiners.',
    body: "Every session is delivered by current BASI trainers. You'll know exactly what they're looking for, because they're the ones looking for it.",
  },
  {
    title: '8:1 max group size.',
    body: 'Real coaching, not crowd management. We keep groups small so every student gets proper attention every session.',
  },
  {
    title: 'A job at the end of it.',
    body: 'Our partner ski schools across the Alps take BASI Level 2 instructors directly from our course. The winter intake wraps just before February half-term, so you can be working a full week straight after.',
  },
  {
    title: 'Alumni for life.',
    body: "Every Peak student joins the alumni network. There's always a space for you on our chairlifts.",
  },
];

// FAQ structured data — must come after `faqs` is declared
jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<BaseLayout
  title="How to Become a Ski Instructor in 6 Weeks · BASI Course · Peak Snowsports"
  description="Become a ski instructor in six weeks. BASI Level 1 + 2 ski instructor course, coached by BASI Trainers, 8:1 max, two intakes a year (Hintertux autumn / Morzine winter). From €8,999, staged payments from €150. Enquire today."
  image="/images/og/gap-course.jpg"
  jsonLd={jsonLd}
>
  <Hero
    kicker="Ski instructor course · BASI Level 1 + 2 · Hintertux or Morzine"
    headline="Become a ski instructor in six weeks."
    sub="The Peak GAP course takes you from confident skier to qualified BASI Level 1 and Level 2 instructor. Two intakes a year, coached by the people who run BASI exams."
    primaryCta={{ href: '#enquire', label: 'Enquire now' }}
    secondaryCta={{ href: '#book', label: 'See dates & pricing' }}
    variant="full"
    image={heroImage}
    imageAlt="A ski instructor course cohort regrouping below a rocky alpine face at dusk."
  />

  <!-- Welcome / overview -->
  <Section kicker="How it works" title="How to become a ski instructor with Peak.">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,460px)] lg:gap-20">
      <div class="space-y-10">
        <p class="text-xl font-medium leading-snug text-olive md:text-2xl">
          In six weeks you go from confident skier to qualified BASI Level 1 and Level 2 ski instructor. 100+ hours of coaching from the people who run BASI exams, both qualifications, and a job offer waiting at the end.
        </p>

        <dl class="grid gap-x-6 gap-y-6 border-y border-olive/10 py-6 sm:grid-cols-3">
          <div>
            <dt class="meta text-olive/50">Qualification</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">BASI L1 + L2</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Length</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">6 weeks</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Ratio</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">8:1 max</dd>
          </div>
        </dl>

        <div class="space-y-5 text-base leading-relaxed text-olive/75 md:text-lg">
          <p>
            <strong class="font-semibold text-olive">Two intakes this year.</strong> Autumn pre-season in Hintertux, Austria, or our winter course in Morzine. Same course, same standards, same price.
          </p>
          <p>
            For winter, the whole course moves into a private Peak chalet, students, coaches and the wider team under one roof. You train in Avoriaz, the heart of the 650 km Portes du Soleil, and come home to Morzine.
          </p>
          <p>
            New to all this? Start with our plain-English guides: <a href="/journal/how-to-become-a-ski-instructor" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">how to become a ski instructor</a>, <a href="/journal/how-much-does-a-ski-instructor-course-cost" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">what it costs</a>, and <a href="/journal/basi-level-1-vs-level-2" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">BASI Level 1 vs Level 2</a>.
          </p>
        </div>
      </div>
      <div class="space-y-4">
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Autumn · pre-season</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">Hintertux, Austria</p>
          <p class="mt-1 text-sm text-olive/70">Sun 1 Nov – Fri 11 Dec 2026 · provisional</p>
        </div>
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Winter · in-season</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">Morzine + Avoriaz</p>
          <p class="mt-1 text-sm text-olive/70">3 Jan – 12 Feb 2027</p>
        </div>
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Same for both intakes</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">8:1 max · same price</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- BASI accreditation -->
  <section class="border-y border-olive/10 bg-snow">
    <div class="mx-auto flex max-w-screen-2xl flex-col items-center gap-6 px-6 py-12 text-center sm:flex-row sm:gap-8 sm:text-left">
      <img src="/images/logos/basi-partner.png" alt="BASI Approved Partner" class="h-14 w-auto shrink-0" />
      <p class="max-w-3xl text-base leading-relaxed text-olive/80 md:text-lg">
        Peak Snowsports is a <strong class="font-semibold text-olive">BASI Business Partner</strong>, approved to deliver BASI training and assessments. Your Level 1 and Level 2 are coached and examined to the official BASI standard.
      </p>
    </div>
  </section>

  <!-- Enquiry form — the primary conversion point, kept high on the page -->
  <Section id="enquire" kicker="Enquire" title="Talk to us about the course.">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,440px)_1fr] lg:gap-20">
      <div class="space-y-6">
        <p class="text-lg leading-relaxed text-olive/80 md:text-xl">
          Tell us a little about yourself and we'll come back to you, no hard sell, just straight answers on dates, cost, kit and whether the course is right for you.
        </p>
        <ul class="space-y-3 text-base text-olive/75 md:text-lg">
          <li class="flex gap-3"><span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span><span>Reply usually within 30 minutes in office hours.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span><span>Not sure you're at the right level? Send a clip, we'll be honest.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span><span>Prefer to chat live? <a href="#talk" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">Book a call or WhatsApp us</a>.</span></li>
        </ul>
      </div>
      <EnquiryForm />
    </div>
  </Section>

  <!-- Book your place / pricing -->
  <Section id="book" kicker="Dates & pricing" title="How much the course costs.">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="flex flex-col rounded-3xl border border-olive bg-cream p-8">
        <p class="meta text-olive/55">Standard package</p>
        <p class="mt-3 font-display text-5xl font-bold tracking-tight md:text-6xl">€8,999</p>
        <p class="mt-5 text-base leading-relaxed text-olive/80">Six weeks, all course content, private Peak chalet accommodation, transfers, kit deal, everything below.</p>
        <a
          href="https://buy.stripe.com/9B6cN55XO8AC9qO67J2ZO0q"
          data-analytics-event="Book Standard"
          class="mt-8 inline-flex items-center justify-center rounded-full bg-yellow px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-olive"
        >
          Book the standard package →
        </a>
      </div>
      <div class="relative flex flex-col overflow-hidden rounded-3xl border border-olive bg-cream p-8 opacity-70">
        <span class="absolute right-6 top-6 inline-flex items-center rounded-full bg-olive-deep px-4 py-1.5 font-display text-xs font-bold uppercase tracking-tight text-salt">
          Sold out · 26/27
        </span>
        <p class="meta text-olive/55">Upgraded room</p>
        <p class="mt-3 font-display text-5xl font-bold tracking-tight text-olive/70 line-through decoration-2 md:text-6xl">€9,499</p>
        <p class="mt-5 text-base leading-relaxed text-olive/70">Same course, single-occupancy room with en-suite. Fully booked for 26/27 &mdash; joins next season's list on enquiry.</p>
        <a
          href="/contact?subject=GAP+single+room+waitlist"
          class="mt-8 inline-flex items-center justify-center rounded-full border border-olive bg-snow px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-olive no-underline transition hover:bg-olive hover:text-snow"
        >
          Join the waitlist →
        </a>
      </div>
    </div>

    <!-- Staged payments: standout block -->
    <div class="mt-10 rounded-3xl bg-olive-deep p-8 text-salt md:p-12">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="meta-pill">Not ready to pay in full?</p>
          <h3 class="mt-4 font-display text-3xl font-bold tracking-tight md:text-4xl">Staged payments. €150 deposit.</h3>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-salt/85 md:text-xl">
            We've kept the 2026 course price and added a staged payment plan as standard, so you can spread the cost rather than finding it all at once.
          </p>
        </div>
        <a
          href="https://buy.stripe.com/7sIcQ406IcKl4XCdRf"
          data-analytics-event="Deposit Click"
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-pink px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-ink hover:text-olive-deep"
        >
          Pay €150 deposit →
        </a>
      </div>

      <ul class="mt-10 grid gap-3 md:grid-cols-3">
        <li class="flex gap-4 rounded-2xl bg-olive p-5">
          <span aria-hidden="true" class="mt-1 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
          <span class="text-base leading-snug text-salt md:text-lg">A schedule that works for you, balance paid in instalments before the course starts.</span>
        </li>
        <li class="flex gap-4 rounded-2xl bg-olive p-5">
          <span aria-hidden="true" class="mt-1 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
          <span class="text-base leading-snug text-salt md:text-lg">10-day cooling-off period, change your mind, full refund, no questions.</span>
        </li>
        <li class="flex gap-4 rounded-2xl bg-olive p-5">
          <span aria-hidden="true" class="mt-1 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
          <span class="text-base leading-snug text-salt md:text-lg">All payments in EUR, by card or bank transfer.</span>
        </li>
      </ul>

      <p class="mt-8 max-w-2xl text-base leading-relaxed text-salt/80 md:text-lg">
        If a payment plan still doesn't make it work, talk to us early. We've helped plenty of students piece it together: sponsorships, family contributions, savings, and we'll do what we can.
      </p>
    </div>
  </Section>

  <!-- What's included -->
  <Section kicker="What's included" title="What the ski instructor course includes.">
    <div class="grid gap-6 md:grid-cols-2">
      {included.map((group) => (
        <div class="rounded-3xl border border-salt/10 bg-brown p-8 text-salt">
          <p class="font-display text-2xl font-bold tracking-tight text-salt">{group.title}</p>
          <ul class="mt-6 space-y-4">
            {group.items.map((item) => (
              <li class="flex gap-4 text-base leading-relaxed text-salt md:text-lg">
                <span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0 bg-accent" style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <!-- Lead magnet: capture emails earlier in the funnel with the kit list -->
  <LeadMagnet />

  <!-- Why students choose Peak -->
  <Section kicker="Why students choose Peak" title="Four reasons it works.">
    <ol class="space-y-16">
      {reasons.map((r, i) => (
        <li class="border-t border-olive/15 pt-10">
          <div class="grid gap-6 md:grid-cols-[5rem_1fr]">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-pink font-display text-xl font-bold tracking-tight text-snow">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-2xl font-bold tracking-tight md:text-4xl">{r.title}</h3>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-olive/85">{r.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Testimonials: social proof from last year's cohort -->
  <Section kicker="What students say" title="From our graduates.">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="flex flex-col rounded-3xl border border-olive bg-cream p-8 md:p-10">
          <span aria-hidden="true" class="font-display text-5xl leading-none text-pink">“</span>
          <blockquote class="mt-4 text-lg leading-relaxed text-olive/85 md:text-xl">
            {t.quote}
          </blockquote>
          <figcaption class="meta mt-6 text-olive/60">{t.name} · {t.year} GAP graduate</figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-8">
      <a href="#enquire" class="inline-flex items-center rounded-full bg-pink px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-olive">
        Start your enquiry →
      </a>
    </div>
  </Section>

  <!-- Gallery: showcase the experience -->
  <Section kicker="Life on course" title="Six weeks. One crew.">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
      <figure class="col-span-2 h-44 overflow-hidden rounded-2xl bg-brown sm:h-56 md:col-span-4 md:h-72">
        <img src="/images/gap/gap-1.jpg" alt="A Peak ski instructor coaching students on the piste" loading="lazy" class="h-full w-full object-cover" />
      </figure>
      <figure class="h-44 overflow-hidden rounded-2xl bg-brown sm:h-56 md:col-span-2 md:h-72">
        <img src="/images/gap/gap-2.jpg" alt="Ski instructor course students riding the chairlift on a bluebird day" loading="lazy" class="h-full w-full object-cover" />
      </figure>
      <figure class="h-44 overflow-hidden rounded-2xl bg-brown sm:h-56 md:col-span-2 md:h-72">
        <img src="/images/gap/gap-3.jpg" alt="The trainee instructor cohort regrouping mid-lesson on the mountain" loading="lazy" class="h-full w-full object-cover" />
      </figure>
      <figure class="h-44 overflow-hidden rounded-2xl bg-brown sm:h-56 md:col-span-2 md:h-72">
        <img src="/images/gap/gap-4.jpg" alt="A BASI trainer running a coaching session with the group" loading="lazy" class="h-full w-full object-cover" />
      </figure>
      <figure class="h-44 overflow-hidden rounded-2xl bg-brown sm:h-56 md:col-span-2 md:h-72">
        <img src="/images/gap/gap-5.jpg" alt="Trainee ski instructors below a rocky alpine face in low evening light" loading="lazy" class="h-full w-full object-cover" />
      </figure>
    </div>
  </Section>

  <!-- FAQs -->
  <Section kicker="FAQ" title="Becoming a ski instructor: your questions.">
    <ul class="divide-y divide-olive/10 border-y border-olive/10">
      {faqs.map((f) => (
        <li>
          <details class="group">
            <summary class="flex cursor-pointer items-baseline gap-6 py-6 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-display text-xl font-bold tracking-tight md:text-2xl">{f.q}</span>
              <span class="ml-auto font-display text-2xl text-olive/40 transition group-open:rotate-45">+</span>
            </summary>
            <p class="pb-8 pr-12 text-base leading-relaxed text-olive/75 md:text-lg">{f.a}</p>
          </details>
        </li>
      ))}
    </ul>
    <p class="meta mt-8 text-olive">
      For the full course details, packing checklists, working rights by country, BASI criteria, <a href="#enquire" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">get in touch with us today</a>.
    </p>
  </Section>

  <!-- Closing CTA: book a call -->
  <Section id="talk" kicker="Ready to talk it through?" title="Book a call.">
    <p class="max-w-2xl text-lg leading-relaxed text-olive/80">
      Book a video call with us and we'll walk you through the course, the chalet, the kit, and how to get the most out of your six weeks.
    </p>

    <div class="mt-12 flex flex-wrap gap-3">
      <a
        href="https://calendar.app.google/G5FHbvEGhBAQu7ud8"
        data-analytics-event="Book a Call"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-full bg-yellow px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-ink"
      >
        Book a call →
      </a>
      <a
        href={whatsappHref()}
        data-analytics-event="WhatsApp Click"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-full border border-olive/30 px-8 py-4 font-display text-base font-bold uppercase tracking-tight no-underline transition hover:border-yellow hover:bg-yellow hover:text-snow"
      >
        WhatsApp us
      </a>
    </div>

    <p class="meta mt-12 text-olive">
      Joining a Peak course means joining our community. You'll be added to our alumni network, and we'll always have a space on our chairlifts for you.
    </p>
  </Section>

  <StickyCta
    enquireHref="#enquire"
    whatsappHref={whatsappHref()}
  />
</BaseLayout>
