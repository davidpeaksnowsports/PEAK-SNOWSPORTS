---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Section from '../components/ui/Section.astro';
import PartnerEnquiryForm from '../components/partners/PartnerEnquiryForm.astro';
import heroImage from '../assets/images/hero-resorts.jpg';

// Full "already partnered with" list. URLs link out to each partner's own
// site; a null url renders as plain text (source needed / no website).
const chaletPartners = [
  { name: 'The Boutique Chalet Company', url: 'https://theboutiquechalet.com' },
  { name: 'More Mountain', url: 'https://www.moremountain.com' },
  { name: 'Elevation Alps', url: 'https://elevationalps.com' },
  { name: 'Atlas Ski Co', url: 'https://atlasskico.com' },
  { name: 'Jack & Jill Holidays', url: 'https://jackandjillholidays.com' },
  { name: 'TG Ski', url: 'https://www.tgski.com' },
  { name: 'The Chalet Edit', url: 'https://thechaletedit.com' },
  { name: 'Hunter Chalets', url: 'https://hunterchalets.com' },
  { name: 'Simply Morzine', url: 'https://simply-morzine.co.uk' },
  { name: 'Chilly Powder', url: 'https://www.chillypowder.com' },
  { name: 'The Fat Fox Lodge', url: 'https://fatfoxlodge.com' },
  { name: 'Alpichalets', url: 'https://alpichalets.com' },
  { name: 'Treeline Chalets', url: 'https://treelinechalets.com' },
  { name: 'The Nant', url: 'https://www.thenant.com' },
];

const bookingAgents = [
  { name: 'Ski Boutique', url: 'https://www.ski-boutique.co.uk' },
  { name: 'Powder Byrne', url: 'https://www.powderbyrne.com' },
  { name: 'Oxford Ski', url: 'https://www.oxfordski.com' },
  { name: 'Leo Trippi', url: 'https://www.leotrippi.com' },
  { name: 'Heidi', url: 'https://www.heidi.com' },
];

const resortBusinesses = [
  { name: 'Le Crepu', url: 'https://www.crepu-morzine.com' },
  { name: 'Ski Mobile', url: 'https://ski-mobile.com' },
];

const stats = [
  { label: 'Commission', value: '10%' },
  { label: 'Group size', value: '6 max' },
  { label: 'Every coach', value: 'Carte Pro' },
  { label: 'Led by', value: 'BASI trainers' },
  { label: 'Resorts', value: 'Portes du Soleil' },
  { label: 'Levels', value: 'Seven' },
];

const products = [
  {
    title: 'Private lessons',
    detail:
      'One instructor, one to six skiers. Half-days, full days, all seven levels. The bread and butter of what your guests will book.',
    duration: '2.5 h → full day',
  },
  {
    title: 'Groups & camps',
    detail:
      "Kids' school (three age brackets), adult courses, our five-day adult ski camp, and Local Kids' Club by the session. Small groups, PEAK medal system.",
    duration: 'Holiday weeks',
  },
  {
    title: 'Off-piste & experiences',
    detail:
      'Half-day guiding, sunset tours, ski touring days. Route choice and avalanche awareness delivered by BASI trainers.',
    duration: '2 h → 7 h',
  },
];

const channels = [
  {
    title: 'Affiliate link',
    body: 'Your unique link. Clicks are automatically attributed to you for the whole season.',
  },
  {
    title: 'Booking widget',
    body: 'Embed our SkiOperator widget on your own site. Guests book in place, you get credit.',
  },
  {
    title: 'Checkout dropdown',
    body: 'Guests who book directly can pick you as their referrer before payment.',
  },
  {
    title: 'Concierge email',
    body: "Send us the enquiry. It's matched to you in our CRM and worked through by our team.",
  },
  {
    title: 'Partner portal',
    body: 'Live availability, self-service booking, real-time reporting. Rolling out through the season.',
    soon: true,
  },
];

const sponsorTiers = [
  {
    name: 'Premier',
    accent: 'bg-pink',
    threeYr: '€20,000',
    fiveYr: '€35,000',
    highlights: [
      'Prime chest & arm logo placement',
      "Exclusive category partnership, so you're the only one in your industry",
      "Logo on kids' group bibs",
      '4+ dedicated social posts per season',
      'Direct client recommendations from instructors',
    ],
  },
  {
    name: 'Partner',
    accent: 'bg-olive',
    threeYr: '€9,000',
    fiveYr: '€16,000',
    highlights: [
      'Large arm logo placement',
      '2+ dedicated social posts per season',
      'Website listing on /partners',
      'Discounted ski lessons for your staff',
    ],
  },
  {
    name: 'Supporter',
    accent: 'bg-brown',
    threeYr: '€7,000',
    fiveYr: '€12,000',
    highlights: [
      'Smaller sleeve logo',
      '1 dedicated social post per season',
      'Website recognition',
      'Marketing & social mentions',
    ],
  },
];

const sponsorReach = [
  { label: 'Instagram views · monthly', value: '2.1M' },
  { label: 'Impressions per season', value: '200K+' },
  { label: 'Additional site visits · monthly', value: '850+' },
  { label: 'High-value leads · monthly', value: '17+' },
];

const partnerTypes = [
  {
    title: 'Tour operators',
    body: "You sell the Portes du Soleil. We're the ski school your clients will actually rave about.",
  },
  {
    title: 'Chalets & catered chalets',
    body: 'Every chalet week needs lessons. Bundle Peak in and your guests get named coaches, not luck-of-the-draw.',
  },
  {
    title: 'Hotels & apartments',
    body: 'A concierge-grade referral your front desk can hand out with confidence.',
  },
  {
    title: 'Ski & kit hire',
    body: 'Your guests need lessons. Ours need kit. A clean two-way referral relationship.',
  },
  {
    title: 'Transfers',
    body: 'The first and last conversation of the holiday. A good recommendation lands hard.',
  },
  {
    title: 'Restaurants & concierge',
    body: 'If you look after guests in resort, we should be your first-call ski school.',
  },
];

const faqs = [
  {
    q: 'What counts as a completed referred booking?',
    a: 'Any lesson, group course or experience that goes ahead and is paid in full, where the guest reached us via your unique affiliate link, embedded widget, checkout dropdown selection or a named concierge email introduction. Commission is calculated on the lesson value ex-TVA (ski lessons are TVA exempt).',
  },
  {
    q: 'When and how is commission paid?',
    a: 'We reconcile at season end and pay by 31 May each year. Payment is by bank transfer in EUR. Full statement provided showing every booking, cancellation and refund included in the calculation.',
  },
  {
    q: 'Is the partnership exclusive?',
    a: "No. We're happy for you to work with other providers. What we ask for is a fair chance at the recommendation, and honest feedback when we could serve your guests better. If exclusivity is something you'd like to talk about for your patch, get in touch; we'll consider it case by case.",
  },
  {
    q: "How do you handle guests who don't book through my channel?",
    a: 'If a guest tells our team you sent them, we log the referral against your account in our CRM and it counts toward commission at reconciliation. The affiliate link and widget make this automatic; the concierge and checkout routes are the fallback for people who prefer email or phone.',
  },
  {
    q: 'Can you co-brand the booking experience for our guests?',
    a: "Yes. The embedded booking widget can be styled to sit inside your own site, and we can pre-filter it to just the resorts, dates or product families that make sense for your audience. If you want a fully white-labelled booking experience powered by our system, ask us about SkiOperator. That's our booking product, and we license it separately.",
  },
  {
    q: 'How do you keep lesson quality up?',
    a: "Every coach holds a French Carte Pro (the legal instructor-teaching qualification for France) and our sessions are led by BASI trainers, the people who train and examine other instructors. Groups are capped at six. It's the quality standard we'd expect if we were sending our own family.",
  },
  {
    q: 'What resorts do you cover?',
    a: "Avoriaz-Morzine, Châtel and Les Gets, plus the wider Portes du Soleil ski area. If your guests are in a resort we don't currently serve, get in touch. We may still be able to help via our trainer network.",
  },
];

const SITE = 'https://www.peaksnowsports.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Partner Programme', item: `${SITE}/partners` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Partner Programme · 10% commission on every referred booking · Peak Snowsports"
  description="Partner with Peak Snowsports, the premium ski school across the Portes du Soleil. 10% commission on completed referred bookings, five booking channels, real coaches with real names. Request the 2026/27 rate card."
  jsonLd={jsonLd}
>
  <Hero
    kicker="Partner programme · 2026/27"
    headline="Experiences, not transactions."
    sub="We partner with tour operators, chalet companies and resort businesses across the Portes du Soleil. Real coaches, real names, every referred booking earns commission."
    primaryCta={{ href: '#enquire', label: 'Get the rate card' }}
    secondaryCta={{ href: '#how', label: 'How referrals work' }}
    variant="compact"
    image={heroImage}
    imageAlt="A Peak Snowsports coach with a small group of skiers on an alpine ridge."
  />

  <!-- Headline offer -->
  <Section size="tight" kicker="The offer" title="Ten percent, cleanly reconciled.">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,480px)_1fr] lg:gap-20">
      <div class="rounded-3xl border border-olive bg-cream p-8 md:p-10">
        <p class="meta text-olive/55">Commission, every booking</p>
        <p class="mt-3 font-display text-7xl font-bold tracking-tight text-pink md:text-8xl">10%</p>
        <p class="mt-6 text-base leading-relaxed text-olive/80 md:text-lg">
          On the lesson value of every completed, referred booking. Reconciled at season end, paid by 31 May.
        </p>
      </div>
      <div class="space-y-6 text-base leading-relaxed text-olive/85 md:text-lg">
        <p>
          Peak is the premium ski school across the Portes du Soleil. Twenty thousand-plus clients, twenty-five-plus instructors, three resorts, one standard. Named coaches, small groups, French Carte Pro across the board, sessions led by BASI trainers.
        </p>
        <p>
          The partner programme is the commercial side of that: a straight 10% on every completed booking your channel sends us. No tiered thresholds, no minimums, no reason not to recommend us to the guests who deserve a good ski school.
        </p>
        <p>
          Five ways to book, one rate card, one contact. Request the details below and we'll be in touch.
        </p>
      </div>
    </div>
  </Section>

  <!-- Stats band, matching the PDF -->
  <section class="border-y border-olive/10 bg-cream">
    <div class="mx-auto max-w-screen-2xl px-6 py-14 md:py-16">
      <dl class="grid gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
        {stats.map((s) => (
          <div>
            <dt class="meta text-olive/55">{s.label}</dt>
            <dd class="mt-2 font-display text-2xl font-bold tracking-tight text-olive md:text-3xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- How referrals work -->
  <Section size="tight" id="how" kicker="How to refer & book" title="Five ways your guests can book.">
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {channels.map((c, i) => (
        <li class="rounded-3xl border border-olive bg-snow p-8">
          <div class="flex items-center gap-3">
            <span class="meta text-olive/40">{String(i + 1).padStart(2, '0')}</span>
            {c.soon && <span class="meta-pill">Soon</span>}
          </div>
          <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">{c.title}</h3>
          <p class="mt-4 text-base leading-relaxed text-olive/75">{c.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- What guests actually book -->
  <Section size="tight" kicker="What we teach" title="Three product families. Seven levels.">
    <div class="grid gap-6 md:grid-cols-3">
      {products.map((p) => (
        <div class="flex flex-col rounded-3xl border border-olive bg-cream p-8">
          <p class="meta text-olive/55">{p.duration}</p>
          <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">{p.title}</h3>
          <p class="mt-4 text-base leading-relaxed text-olive/75">{p.detail}</p>
        </div>
      ))}
    </div>
    <p class="meta mt-8 text-olive/70">
      Full off-peak and peak pricing across every product is in the <a href="#enquire" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">2026/27 rate card</a>.
    </p>
  </Section>

  <!-- Who we partner with -->
  <Section size="tight" kicker="Who we partner with" title="If you look after guests in resort, we should talk.">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {partnerTypes.map((t) => (
        <div class="rounded-3xl border border-olive/20 bg-snow p-8">
          <h3 class="font-display text-xl font-bold tracking-tight md:text-2xl">{t.title}</h3>
          <p class="mt-4 text-base leading-relaxed text-olive/75">{t.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Social proof: existing partners across three categories -->
  <Section size="tight" kicker="Already partnered with" title="Operators sending us guests.">
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Chalets & accommodation: spans the full width, uses multi-column
           inside because the list is long (14 operators). -->
      <div class="rounded-3xl border border-olive bg-cream p-8 lg:col-span-3">
        <p class="meta text-olive/55">Chalets & accommodation</p>
        <ul class="mt-5 gap-x-8 space-y-3 sm:columns-2 lg:columns-3">
          {chaletPartners.map((p) => (
            <li class="break-inside-avoid">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-baseline gap-2 no-underline"
                >
                  <span class="font-display text-lg font-bold tracking-tight transition-colors group-hover:bg-yellow hover:text-snow">{p.name}</span>
                  <span aria-hidden="true" class="meta text-olive/40 transition-colors group-hover:text-pink">↗</span>
                </a>
              ) : (
                <span class="font-display text-lg font-bold tracking-tight">{p.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Booking agents column -->
      <div class="rounded-3xl border border-olive bg-cream p-8 lg:col-span-2">
        <p class="meta text-olive/55">Booking agents & tour operators</p>
        <ul class="mt-5 space-y-3 sm:columns-2">
          {bookingAgents.map((p) => (
            <li class="break-inside-avoid">
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-baseline gap-2 no-underline"
                >
                  <span class="font-display text-lg font-bold tracking-tight transition-colors group-hover:bg-yellow hover:text-snow">{p.name}</span>
                  <span aria-hidden="true" class="meta text-olive/40 transition-colors group-hover:text-pink">↗</span>
                </a>
              ) : (
                <span class="font-display text-lg font-bold tracking-tight">{p.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- In-resort businesses column -->
      <div class="rounded-3xl border border-olive bg-cream p-8">
        <p class="meta text-olive/55">In-resort businesses</p>
        <ul class="mt-5 space-y-3">
          {resortBusinesses.map((p) => (
            <li>
              {p.url ? (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-baseline gap-2 no-underline"
                >
                  <span class="font-display text-lg font-bold tracking-tight transition-colors group-hover:bg-yellow hover:text-snow">{p.name}</span>
                  <span aria-hidden="true" class="meta text-olive/40 transition-colors group-hover:text-pink">↗</span>
                </a>
              ) : (
                <span class="font-display text-lg font-bold tracking-tight">{p.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Accommodation referral: the reverse-direction relationship -->
  <section class="border-y border-olive/10 bg-cream px-6 py-10 md:py-14 lg:py-16">
    <div class="mx-auto max-w-screen-2xl">
      <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,2fr)_1fr] lg:gap-16">
        <div>
          <p><span class="meta-pill">Accommodation referral</span></p>
          <h2 class="mt-4 max-w-2xl text-3xl font-semibold leading-tight md:text-5xl">The other side of the deal.</h2>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-olive/80 md:text-lg">
            The relationship works both ways. Every week, guests ask us where to stay. We only recommend a handful of hand-picked chalet and accommodation operators we genuinely rate, and those partners pay us commission on the bookings we send.
          </p>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-olive/75 md:text-lg">
            Selective, curated, and worth the shelf space. If you run accommodation in Morzine, Avoriaz, Châtel or Les Gets and want to be considered for the shortlist, tell us in the enquiry form.
          </p>
        </div>
        <div class="lg:justify-self-end">
          <a
            href="/accommodation"
            class="inline-flex items-center rounded-full border border-olive px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-olive no-underline transition hover:bg-olive hover:text-snow"
          >
            See the current shortlist →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship: distinct from the referral partner programme -->
  <section id="sponsorship" class="border-y border-olive/10 bg-olive-deep px-6 py-10 text-salt md:py-14 lg:py-16">
    <div class="mx-auto max-w-screen-2xl">
      <div class="max-w-3xl">
        <p><span class="meta-pill">Sponsorship · Winter 2026/27</span></p>
        <h2 class="mt-4 text-4xl font-semibold leading-tight md:text-6xl">Not just seen. Recommended and remembered.</h2>
      </div>

      <div class="mt-10 grid items-start gap-10 lg:grid-cols-[1fr_minmax(0,420px)] lg:gap-16">
        <div class="space-y-5 text-base leading-relaxed text-salt/85 md:text-lg">
          <p>
            Sponsorship is different from the referral partner programme. Sponsors pay Peak a cash fee in return for logo placement across our uniforms and channels, dedicated digital content, and considered referrals to their brand, product or service.
          </p>
          <p>
            We're selective, three sponsors per season, no more. We only sponsor brands we'd genuinely recommend to our clients: the same people we teach every day, high-net-worth professionals in finance, law, tech and property from the UK, France, Switzerland, Germany and the US, average spend €1,700 a day.
          </p>
          <p>
            If the fit is right, sponsorship gets you in front of that audience with the endorsement of the region's most-recommended ski school. Not an ad they scroll past. A recommendation from a coach they trust.
          </p>
        </div>

        <aside class="rounded-3xl border border-salt/20 bg-olive p-8">
          <p class="meta text-salt/60">Currently sponsored by</p>
          <img
            src="/images/logos/douglas-elliman.svg"
            alt="Douglas Elliman"
            class="mt-5 h-8 w-auto max-w-full [filter:brightness(0)_invert(1)]"
            loading="lazy"
          />
          <div class="mt-4">
            <p class="font-display text-xl font-bold tracking-tight">Douglas Elliman France</p>
            <p class="meta mt-1 text-salt/60">Alpine real estate · Premier sponsor</p>
          </div>
          <p class="mt-6 text-base leading-relaxed text-salt/75">
            One Premier sponsor per industry category, so your placement stands on its own.
          </p>
        </aside>
      </div>

      <!-- Reach numbers -->
      <dl class="mt-14 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {sponsorReach.map((s) => (
          <div>
            <dt class="meta text-salt/55">{s.label}</dt>
            <dd class="mt-2 font-display text-3xl font-bold tracking-tight text-salt md:text-4xl">{s.value}</dd>
          </div>
        ))}
      </dl>

      <!-- Three tiers -->
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {sponsorTiers.map((tier) => (
          <div class="flex flex-col rounded-3xl border border-salt/15 bg-olive p-8">
            <div class="flex items-center gap-3">
              <span class={`inline-block h-3 w-3 ${tier.accent}`} style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);" aria-hidden="true"></span>
              <p class="meta text-salt/60">{tier.name} sponsor</p>
            </div>
            <p class="mt-4 font-display text-4xl font-bold tracking-tight md:text-5xl">{tier.threeYr}<span class="ml-2 font-display text-base font-normal text-salt/60">/ 3 yrs</span></p>
            <p class="mt-1 meta text-salt/60">or {tier.fiveYr} for 5 years</p>
            <ul class="mt-6 space-y-3 text-base leading-relaxed text-salt/85">
              {tier.highlights.map((h) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class={`mt-1.5 inline-block h-3 w-3 shrink-0 ${tier.accent}`} style="clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Add-on + CTA -->
      <div class="mt-10 grid gap-6 rounded-3xl border border-salt/20 bg-olive p-8 md:grid-cols-[1fr_auto] md:items-center md:gap-10 md:p-10">
        <div>
          <p class="meta text-salt/55">Add-on · any tier</p>
          <p class="mt-2 font-display text-2xl font-bold tracking-tight md:text-3xl">Co-branded content · €3,000 per season</p>
          <p class="mt-3 text-base leading-relaxed text-salt/80">Custom social posts, stories and blog features, plus the option to collaborate on events, giveaways and exclusive client experiences.</p>
        </div>
        <a
          href="#enquire"
          data-preselect-category="Sponsorship"
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-pink px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-ink hover:text-olive-deep"
        >
          Request the sponsorship deck →
        </a>
      </div>
    </div>
  </section>

  <!-- Enquiry form -->
  <Section size="tight" id="enquire" kicker="Get the rate card" title="Send us a note. We'll send you the details.">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,440px)_1fr] lg:gap-20">
      <div class="space-y-6">
        <p class="text-lg leading-relaxed text-olive/80 md:text-xl">
          Fill this in and the 2026/27 rate card lands in your inbox straight away, with full pricing, the commission mechanic, and the five ways your guests can book.
        </p>
        <ul class="space-y-3 text-base text-olive/75 md:text-lg">
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0" style="background-color:#EB437F; clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
            <span>Rate card by email as soon as you hit send.</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0" style="background-color:#EB437F; clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
            <span>Personal follow-up from our team within two working days.</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-1.5 inline-block h-3 w-3 shrink-0" style="background-color:#EB437F; clip-path: polygon(50% 0%, 100% 100%, 0% 100%);"></span>
            <span>No commitment. We'll answer questions before you sign anything.</span>
          </li>
        </ul>
        <p class="meta text-olive/55">
          Prefer to email? <a href="mailto:hello@peaksnowsports.com?subject=Partner%20enquiry" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">hello@peaksnowsports.com</a>
        </p>
      </div>
      <PartnerEnquiryForm />
    </div>
  </Section>

  <!-- FAQs -->
  <Section size="tight" kicker="FAQ" title="Partner questions, straight answers.">
    <ul class="divide-y divide-olive/10 border-y border-olive/10">
      {faqs.map((f) => (
        <li>
          <details class="group">
            <summary class="flex cursor-pointer items-baseline gap-6 py-6 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-display text-xl font-bold tracking-tight md:text-2xl">{f.q}</span>
              <span class="ml-auto font-display text-2xl text-olive/40 transition group-open:rotate-45">+</span>
            </summary>
            <p class="pb-8 pr-12 text-base leading-relaxed text-olive/75 md:text-lg">{f.a}</p>
          </details>
        </li>
      ))}
    </ul>
    <p class="meta mt-8 text-olive">
      Something we haven't covered? <a href="#enquire" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">Ask us in the enquiry</a> or email <a href="mailto:hello@peaksnowsports.com" class="underline underline-offset-4 hover:bg-yellow hover:text-snow">hello@peaksnowsports.com</a>.
    </p>
  </Section>

  <!-- Closing CTA band -->
  <section class="bg-olive-deep text-salt">
    <div class="mx-auto max-w-screen-2xl px-6 py-16 md:py-20">
      <p class="meta-pill">Peak Snowsports · Partner programme 2026/27</p>
      <h2 class="mt-6 max-w-3xl text-4xl leading-tight md:text-6xl">Ready to send your guests to a ski school you can stand behind?</h2>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#enquire"
          class="inline-flex items-center rounded-full bg-yellow px-8 py-4 font-display text-base font-bold uppercase tracking-tight text-snow no-underline transition hover:bg-ink"
        >
          Get the rate card →
        </a>
        <a
          href="mailto:hello@peaksnowsports.com?subject=Partner%20enquiry"
          class="inline-flex items-center rounded-full border border-salt/40 px-8 py-4 font-display text-base font-bold uppercase tracking-tight no-underline transition hover:border-yellow hover:bg-yellow hover:text-snow"
        >
          Email us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
