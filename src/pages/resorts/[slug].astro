---
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import { sanity, urlFor, allResortsQuery, resortBySlugQuery } from '../../lib/sanity';

type ImageRef = { asset?: { _ref?: string } } & Record<string, unknown>;

interface ResortFull {
  _id: string;
  name: string;
  slug: string;
  type: 'home' | 'product';
  product?: string;
  country?: string;
  parentArea?: string;
  knownFor?: string;
  hero?: ImageRef;
  altitude?: string;
  liftCount?: string;
  runDistance?: string;
  transferTime?: string;
  meetingPoints?: string[];
  body?: unknown;
  seoTitle?: string;
  seoDescription?: string;
}

interface ResortSummary {
  _id: string;
  name: string;
  slug: string;
  knownFor?: string;
  hero?: ImageRef;
}

export async function getStaticPaths() {
  const all = (await sanity.fetch<{ slug: string }[]>(allResortsQuery)) ?? [];
  return all.filter((r) => !!r.slug).map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const { resort, siblings } = await sanity.fetch<{
  resort: ResortFull | null;
  siblings: ResortSummary[];
}>(resortBySlugQuery, { slug });

if (!resort) {
  return Astro.redirect('/resorts');
}

const d = resort;

const stats = [
  d.altitude && { label: 'Altitude', value: d.altitude },
  d.liftCount && { label: 'Lifts', value: d.liftCount },
  d.runDistance && { label: 'Pistes', value: d.runDistance },
  d.transferTime && { label: 'Transfer', value: d.transferTime },
].filter(Boolean) as { label: string; value: string }[];

const heroDisplay = d.hero?.asset?._ref
  ? urlFor(d.hero).width(2400).height(1200).fit('crop').url()
  : undefined;
const heroAbsolute = heroDisplay ?? 'https://www.peaksnowsports.com/images/og/resorts.jpg';

const seoTitle =
  d.seoTitle ??
  `Ski lessons in ${d.name}${d.parentArea ? `, ${d.parentArea}` : ''} · Peak Snowsports`;
const seoDescription =
  d.seoDescription ??
  `${d.knownFor ?? ''} Ski lessons, kids' groups, off-piste and private instruction with Peak Snowsports.`.trim();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': d.type === 'home' ? 'SkiResort' : 'TouristDestination',
    name: d.name,
    description: d.knownFor,
    image: heroAbsolute,
    url: `https://www.peaksnowsports.com/resorts/${d.slug}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: d.name,
      addressCountry:
        d.country === 'Austria' ? 'AT' : d.country === 'Switzerland' ? 'CH' : 'FR',
    },
    containedInPlace: d.parentArea ? { '@type': 'Place', name: d.parentArea } : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Resorts', item: 'https://www.peaksnowsports.com/resorts' },
      { '@type': 'ListItem', position: 2, name: d.name, item: `https://www.peaksnowsports.com/resorts/${d.slug}` },
    ],
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} image={heroAbsolute} jsonLd={jsonLd}>
  <!-- Hero -->
  <nav aria-label="Breadcrumb" class="mx-auto max-w-screen-2xl px-6 pt-8 md:px-10">
    <p class="meta text-ink-45">
      <a href="/resorts" class="no-underline transition-colors hover:text-accent">Resorts</a>
      <span class="px-2" aria-hidden="true">/</span>
      <span class="text-ink-70">{d.country}{d.parentArea ? ` \u00B7 ${d.parentArea}` : ''}</span>
    </p>
  </nav>

  <section class="px-6 pt-10 md:px-10 md:pt-12">
    <div class="mx-auto max-w-screen-2xl">
      {d.type === 'product' && d.product && (
        <p class="meta mb-5 inline-flex items-center rounded-sm bg-accent px-3 py-1 text-snow">
          {d.product}
        </p>
      )}
      <h1 class="max-w-[14ch] text-6xl leading-[0.88] tracking-[-0.045em] md:text-7xl lg:text-8xl">
        {d.name}.
      </h1>
      {d.knownFor && (
        <p class="mt-7 max-w-[46ch] text-lg leading-relaxed text-ink-70 md:text-xl">{d.knownFor}</p>
      )}
    </div>
  </section>

  {heroDisplay && (
    <div class="mt-12 h-[42vh] min-h-[300px] w-full overflow-hidden bg-ink md:mt-14 md:h-[52vh]">
      <img src={heroDisplay} alt={d.name} class="h-full w-full object-cover" loading="eager" />
    </div>
  )}
  {!heroDisplay && <div class="pb-14"></div>}

  <!-- Stat pills -->
  {stats.length > 0 && (
    <section class="border-b border-olive/10 px-6 py-10">
      <div class="mx-auto flex max-w-screen-2xl flex-wrap gap-3">
        {stats.map((s) => (
          <span class="inline-flex items-center gap-3 rounded-sm border border-olive/20 px-5 py-3">
            <span class="meta text-olive/50">{s.label}</span>
            <span class="text-sm font-semibold text-olive">{s.value}</span>
          </span>
        ))}
      </div>
    </section>
  )}

  <!-- Body -->
  <Section>
    <div class="prose prose-lg max-w-3xl
      prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-a:underline-offset-4">
      <PortableText value={(d.body as any) ?? []} />
    </div>
  </Section>

  {d.type === 'home' && d.meetingPoints && d.meetingPoints.length > 0 && (
    <Section kicker="Meeting points" title="Where you'll find us.">
      <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {d.meetingPoints.map((mp) => (
          <div class="rounded-none border border-olive bg-snow px-6 py-5">
            <span class="meta text-olive/50">{d.name}</span>
            <p class="mt-2 font-display text-xl font-bold tracking-tight">{mp}</p>
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section>
    <div class="border-t border-olive/10 pt-12">
      <div class="flex flex-wrap gap-3">
        <a
          href="/book"
          class="inline-flex items-center rounded-sm bg-yellow px-8 py-4 font-display text-base font-semibold text-snow no-underline transition hover:bg-ink"
        >
          {d.type === 'product' ? `Enquire about ${d.product}` : `Book a lesson in ${d.name}`} →
        </a>
        <a
          href="/lessons"
          class="inline-flex items-center rounded-sm border border-olive/30 px-8 py-4 font-display text-base font-semibold no-underline transition hover:border-yellow hover:bg-yellow hover:text-snow"
        >
          See all lessons
        </a>
      </div>
    </div>
  </Section>

  {siblings && siblings.length > 0 && (
    <Section kicker={d.type === 'home' ? 'Where else we ski' : 'Other camps'} title="Keep exploring.">
      <ul class="divide-y divide-olive/10 border-y border-olive/10">
        {siblings.map((r) => (
          <li>
            <a
              href={`/resorts/${r.slug}`}
              class="group -mx-3 flex items-baseline gap-4 px-3 py-6 no-underline transition-colors hover:bg-yellow hover:text-snow md:gap-8"
            >
              <span class="font-display text-3xl font-bold tracking-tight md:text-5xl">
                {r.name}.
              </span>
              {r.knownFor && (
                <span class="meta hidden text-olive/50 md:inline">{r.knownFor}</span>
              )}
              <span class="ml-auto font-display text-2xl transition group-hover:translate-x-2 md:text-3xl">→</span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}
</BaseLayout>
