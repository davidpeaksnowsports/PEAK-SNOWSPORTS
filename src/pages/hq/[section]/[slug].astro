---
/**
 * One Peak HQ document. A slug that doesn't exist — or exists only in the
 * instructor hub — renders the same not-found page with a 404 status.
 */
export const prerender = false;

import HqLayout from '../../../layouts/HqLayout.astro';
import DocBody from '../../../components/doc/DocBody.astro';
import { safeSiteImage } from '../../../lib/hq/inline';
import { HQ_SECTIONS, getHqDoc, type HqSection } from '../../../lib/hq/content';
import { leaveFeedback } from '../../../lib/hq/feedback';
import { createHqClient, type HqUser } from '../../../lib/hq/supabase';

const key = Astro.params.section as HqSection;
const slug = Astro.params.slug as string;

const section = HQ_SECTIONS.find((s) => s.key === key);
const doc = section ? await getHqDoc(slug) : null;
const found = Boolean(section && doc && doc.hqSection === key);
if (!found) Astro.response.status = 404;

// "Was this unclear?" posts back to this page, then redirects (POST-redirect-
// GET), so a refresh never sends the note twice.
const user = Astro.locals.hqUser as HqUser;
let feedbackFailed = false;
if (found && doc && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'unclear') {
    const ok = await leaveFeedback(
      createHqClient(Astro.cookies, Astro.request),
      user.id,
      { slug: doc.slug, title: doc.title },
      form.get('note'),
    );
    if (ok) return Astro.redirect(`${Astro.url.pathname}?thanks=1#unclear`, 303);
    feedbackFailed = true;
  }
}
const thanked = Astro.url.searchParams.get('thanks') === '1';
const hero = safeSiteImage(doc?.heroImage);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{
  !found || !doc || !section ? (
    <HqLayout title="Not found" heading="Not found" intro="That document does not exist, or has been withdrawn.">
      <a href="/hq" class="text-accent">Back to Peak HQ</a>
    </HqLayout>
  ) : (
    <HqLayout title={doc.title}>
      <nav aria-label="Breadcrumb" class="mb-8">
        <a href={section.href} class="meta text-ink-45 hover:text-ink">
          &larr; {section.label}
        </a>
      </nav>

      <article class="max-w-3xl">
        {hero && (
          <img
            src={hero}
            alt=""
            class="mb-10 aspect-[21/9] w-full bg-paper-2 object-cover"
          />
        )}
        <header class="border-b border-ink/10 pb-8">
          <p class="meta text-ink-45">{section.label}</p>
          <h1 class="mt-4 font-display text-4xl font-bold leading-[0.95] tracking-tight md:text-6xl">{doc.title}</h1>
          {doc.summary && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-70 md:text-xl">{doc.summary}</p>}

          <dl class="meta mt-6 flex flex-wrap gap-x-8 gap-y-2 text-ink-45">
            {doc.version && (
              <div class="flex gap-2">
                <dt>Version</dt>
                <dd class="text-ink-70">{doc.version}</dd>
              </div>
            )}
            {doc.owner && (
              <div class="flex gap-2">
                <dt>Owner</dt>
                <dd class="text-ink-70">{doc.owner}</dd>
              </div>
            )}
            {doc.reviewedAt ? (
              <div class="flex gap-2">
                <dt>Last reviewed</dt>
                <dd class="text-ink-70">{dateFmt.format(new Date(doc.reviewedAt))}</dd>
              </div>
            ) : doc.updatedAt && (
              <div class="flex gap-2">
                <dt>Updated</dt>
                <dd class="text-ink-70">{dateFmt.format(new Date(doc.updatedAt))}</dd>
              </div>
            )}
          </dl>
        </header>

        {doc.version && (
          <p class="mt-8 border-l-2 border-accent bg-paper-2 px-5 py-4 text-sm text-ink-70">
            This document carries a version number. If it changes materially, we
            will tell you rather than quietly republishing it.
          </p>
        )}

        <div class="mt-4">
          <DocBody value={doc.body} />
        </div>

        <section id="unclear" aria-labelledby="unclear-heading" class="mt-16 border-t border-ink pt-8">
          {thanked ? (
            <p class="text-ink-70" role="status">
              Thanks. Your note has gone to the managers, and the page will be
              fixed. If you need an answer now, ask the other specialist or David.
            </p>
          ) : (
            <details open={feedbackFailed}>
              <summary id="unclear-heading" class="cursor-pointer font-display text-lg font-bold text-ink">
                Was this unclear?
              </summary>
              <form method="POST" class="mt-4 max-w-xl space-y-4">
                <input type="hidden" name="intent" value="unclear" />
                <label class="block">
                  <span class="block text-sm text-ink-70">
                    What was unclear or missing? Optional, but it helps.
                  </span>
                  <textarea
                    name="note"
                    rows="3"
                    maxlength="2000"
                    class="mt-2 w-full border border-ink/20 bg-paper p-3 text-ink focus:border-accent focus:outline-none"
                  />
                </label>
                {feedbackFailed && (
                  <p class="text-sm text-accent" role="alert">
                    That did not send. Try again, or tell David directly.
                  </p>
                )}
                <button
                  type="submit"
                  class="bg-accent px-5 py-3 font-display text-sm font-bold text-paper hover:bg-ink"
                >
                  Send to the managers
                </button>
              </form>
            </details>
          )}
        </section>
      </article>
    </HqLayout>
  )
}
