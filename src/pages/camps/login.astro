---
/**
 * Ski camp portal sign-in, and sign-up: they are the same thing here.
 *
 * A camper gives an email address and gets a link. No code, no password, no
 * separate sign-up form. Following the link lands on /camps/confirm, which
 * signs them in and makes them a camper (migration 0017). A first name is
 * optional and only used to greet them.
 *
 * Anyone who already has a Peak password (an instructor, a GAP student, a
 * camper who set one) can still use it, under "Use a password instead".
 *
 * Plain HTML forms posted to this route; no Supabase in the browser.
 */
export const prerender = false;

import CampsLayout from '../../layouts/CampsLayout.astro';
import { createCampsClient, isCampsConfigured, joinCamps } from '../../lib/camps/supabase';
import { publicUrl } from '../../lib/public-origin';

/**
 * Only same-site camp portal paths are accepted as a return destination.
 * Anything else (a full URL, a protocol-relative //evil.com, a path outside
 * /camps, or /campsx which merely starts with the same letters) is discarded.
 */
function safeNext(raw: string | null): string {
  if (!raw) return '/camps';
  if (raw.startsWith('//')) return '/camps';
  if (raw !== '/camps' && !raw.startsWith('/camps/') && !raw.startsWith('/camps?')) return '/camps';
  return raw;
}

const next = safeNext(Astro.url.searchParams.get('next'));
const linkProblem = Astro.url.searchParams.get('link');

let error: string | null = null;
let passwordError: string | null = null;
let sent = false;
let email = '';
let name = '';

if (Astro.request.method === 'POST' && isCampsConfigured) {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  email = String(form.get('email') ?? '').trim().slice(0, 200);
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  const supabase = createCampsClient(Astro.cookies, Astro.request);

  if (intent === 'link') {
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      error = 'Add your email address.';
    } else {
      const { error: otpError } = await supabase.auth.signInWithOtp({
        email,
        options: {
          shouldCreateUser: true,
          emailRedirectTo: publicUrl('/camps/confirm', Astro.request, Astro.url),
          // Only stored when this creates the account; used for the greeting.
          ...(name ? { data: { name } } : {}),
        },
      });
      if (otpError) {
        // Almost always Supabase's per-address rate limit. Saying so reveals
        // nothing about whether the address has an account.
        console.error('[camps] magic link failed:', otpError.message);
        error = 'We could not send a link just now. Wait a minute and try again.';
      } else {
        sent = true;
      }
    }
  } else if (intent === 'password') {
    const password = String(form.get('password') ?? '');
    const target = safeNext(String(form.get('next') ?? '') || null);
    if (!email || !password) {
      passwordError = 'Enter your email address and password.';
    } else {
      const { data: signedIn, error: signInError } =
        await supabase.auth.signInWithPassword({ email, password });
      if (signInError || !signedIn.user) {
        // Deliberately vague: "no such account" and "wrong password" read the
        // same, so this cannot be used to find out who has an account.
        passwordError = 'That email address and password do not match.';
      } else if (!(await joinCamps(supabase, signedIn.user))) {
        // Only a camper an admin has deactivated ends up here.
        await supabase.auth.signOut();
        passwordError =
          'This account cannot use the camp portal. Email hello@peaksnowsports.com and we will sort it.';
      } else {
        return Astro.redirect(target, 303);
      }
    }
  }
}

const field =
  'w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent';
const label = 'meta mb-2 block text-ink-70';
---

<CampsLayout title="Sign in" chrome={false}>
  <div class="mx-auto max-w-md py-8">
    <p class="meta mb-3 text-ink-45">Peak Snowsports</p>
    <h1 class="font-display text-4xl font-bold">Ski camp portal</h1>

    {
      !isCampsConfigured ? (
        <div class="mt-8 border-l-2 border-accent bg-paper-2 p-5">
          <p class="meta mb-2 text-accent">Not configured yet</p>
          <p class="text-ink-70">
            The camp portal needs <code class="font-mono text-sm">SUPABASE_URL</code> and{' '}
            <code class="font-mono text-sm">SUPABASE_ANON_KEY</code> before anyone
            can sign in. Add them in Vercel and redeploy.
          </p>
        </div>
      ) : sent ? (
        <div class="mt-8 border-l-2 border-accent bg-paper-2 p-5" role="status">
          <p class="text-ink">
            Check <strong>{email}</strong>. We have sent you a link: tap it and
            you are in.
          </p>
          <p class="mt-4 text-sm text-ink-70">
            Open it on this device. Nothing after a couple of minutes? Check spam,
            or <a href="/camps/login" class="text-accent">try again</a>.
          </p>
        </div>
      ) : (
        <>
          <p class="mt-4 text-ink-70">
            Your ski fit plan, the ski system, videos and everything for your
            week. Add your email and we will send you a link to get in. No
            password needed.
          </p>

          {linkProblem && (
            <p role="alert" class="mt-6 border-l-2 border-accent bg-paper-2 px-4 py-3 text-ink">
              {linkProblem === 'device'
                ? 'That link needs to be opened on the device you asked for it on. Ask for a new one below.'
                : linkProblem === 'denied'
                  ? 'This account cannot use the camp portal. Email hello@peaksnowsports.com and we will sort it.'
                  : 'That link has expired or has already been used. Ask for a new one below.'}
            </p>
          )}

          {error && (
            <p role="alert" class="mt-6 border-l-2 border-accent bg-paper-2 px-4 py-3 text-ink">
              {error}
            </p>
          )}

          <form method="POST" class="mt-8 space-y-5">
            <input type="hidden" name="intent" value="link" />
            <div>
              <label for="email" class={label}>Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required
                maxlength="200" value={email} class={field} />
            </div>
            <div>
              <label for="name" class={label}>First name <span class="normal-case text-ink-45">(optional)</span></label>
              <input id="name" name="name" type="text" autocomplete="given-name"
                maxlength="80" value={name} class={field} />
            </div>
            <button type="submit"
              class="w-full bg-accent px-6 py-3 font-display font-bold text-paper transition-colors hover:bg-ink">
              Email me a link
            </button>
          </form>

          <details class="mt-10 border-t border-ink/10 pt-6" open={Boolean(passwordError)}>
            <summary class="cursor-pointer font-display font-bold text-ink">
              Use a password instead
            </summary>
            <p class="mt-3 text-sm text-ink-70">
              If you already have a Peak login, from the GAP course or teaching
              with us, it works here too.
            </p>

            {passwordError && (
              <p role="alert" class="mt-5 border-l-2 border-accent bg-paper-2 px-4 py-3 text-ink">
                {passwordError}
              </p>
            )}

            <form method="POST" class="mt-5 space-y-5">
              <input type="hidden" name="intent" value="password" />
              <input type="hidden" name="next" value={next} />
              <div>
                <label for="pw-email" class={label}>Email</label>
                <input id="pw-email" name="email" type="email" autocomplete="email" required
                  value={email} class={field} />
              </div>
              <div>
                <label for="password" class={label}>Password</label>
                <input id="password" name="password" type="password"
                  autocomplete="current-password" required class={field} />
              </div>
              <button type="submit"
                class="w-full border border-ink/20 px-6 py-3 font-display font-bold text-ink transition-colors hover:border-ink">
                Sign in
              </button>
            </form>
            <p class="mt-4 text-sm">
              <a href="/camps/forgot-password" class="text-accent">Forgotten your password?</a>
            </p>
          </details>
        </>
      )
    }
  </div>
</CampsLayout>
