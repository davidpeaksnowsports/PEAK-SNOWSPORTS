---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import { Content } from '../data/cookies.md';
---

<BaseLayout
  title="Cookie Policy · Peak Snowsports"
  description="How Peak Snowsports uses cookies and similar technologies, the types of cookies we use, and how you can control them."
>
  <Hero
    kicker="Legal"
    headline="Cookie Policy"
    sub="What cookies are, why we use them, and how you can control them. Read alongside our Privacy Notice."
    variant="compact"
  />

  <article class="px-6 py-24 md:py-32">
    <div
      class="prose prose-lg mx-auto max-w-3xl
             prose-headings:font-display prose-headings:tracking-tight prose-headings:text-ink
             prose-h2:mt-20 prose-h2:text-3xl prose-h2:font-semibold md:prose-h2:text-4xl
             prose-h3:mt-12 prose-h3:text-2xl prose-h3:font-semibold
             prose-p:text-ink-70 prose-li:text-ink-70
             prose-a:text-accent prose-a:underline-offset-4 prose-a:decoration-accent
             prose-strong:text-ink"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
