---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SkiOperatorEmbed from '../components/booking/SkiOperatorEmbed.astro';
import { whatsappHref } from '../lib/whatsapp';
---

<BaseLayout
  title="Book a ski lesson · Morzine, Avoriaz, Châtel, Les Gets · Peak Snowsports"
  description="Live availability for private lessons, kids groups, family groups, off-piste and race coaching across Morzine, Avoriaz, Châtel and Les Gets. Hold your place with a small deposit."
>
  <!-- Hero -->
  <section class="bg-olive-deep text-salt">
    <div class="mx-auto max-w-screen-2xl px-6 py-20 md:py-24">
      <p><span class="meta-pill">Book a lesson</span></p>
      <h1 class="mt-6 max-w-4xl text-5xl font-semibold leading-[0.95] tracking-tight md:text-7xl lg:text-8xl">
        Live availability.<br />All resorts. All levels.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-salt/80 md:text-xl">
        Pick a product, pick a date. Hold your place with a small deposit. Prefer a specific instructor? Request them by name.
      </p>
    </div>
  </section>

  <!-- Embed -->
  <Section id="book">
    <SkiOperatorEmbed title="Peak Snowsports booking" class="overflow-hidden rounded-3xl border border-olive/10 bg-snow" />
    <p class="meta mt-6 text-olive/55">
      Booking delivered by SkiOperator. Trouble loading? <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:underline">Get in touch</a> and we'll book you in directly.
    </p>
  </Section>

  <!-- Talk to us fallback -->
  <Section kicker="Or talk to us" title="WhatsApp, phone, email — whatever works.">
    <ul class="max-w-3xl border-y border-olive/10">
      <li>
        <a
          href={whatsappHref('Hi Peak')}
          class="group -mx-3 flex items-baseline gap-4 border-b border-olive/10 px-3 py-5 no-underline transition-colors hover:bg-pink hover:text-snow"
        >
          <span class="meta text-olive/60 group-hover:text-snow">WhatsApp</span>
          <span class="flex-1 text-xl font-semibold">Message us</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a
          href="tel:+441483616522"
          class="group -mx-3 flex items-baseline gap-4 border-b border-olive/10 px-3 py-5 no-underline transition-colors hover:bg-pink hover:text-snow"
        >
          <span class="meta text-olive/60 group-hover:text-snow">Phone</span>
          <span class="flex-1 text-xl font-semibold">+44 1483 616 522</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a
          href="mailto:hello@peaksnowsports.com"
          class="group -mx-3 flex items-baseline gap-4 px-3 py-5 no-underline transition-colors hover:bg-pink hover:text-snow"
        >
          <span class="meta text-olive/60 group-hover:text-snow">Email</span>
          <span class="flex-1 text-xl font-semibold">hello@peaksnowsports.com</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </Section>

  <!-- Cross-nav -->
  <Section>
    <div class="border-t border-olive/15 pt-12">
      <p class="meta text-olive/65">While you're here</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/lessons"
          class="inline-flex items-center rounded-full border border-olive bg-snow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive no-underline transition hover:bg-olive hover:text-snow"
        >
          Browse lessons →
        </a>
        <a
          href="/ski-camps"
          class="inline-flex items-center rounded-full border border-olive bg-snow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive no-underline transition hover:bg-olive hover:text-snow"
        >
          Adult ski camps
        </a>
        <a
          href="/gap-course"
          class="inline-flex items-center rounded-full border border-olive bg-snow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive no-underline transition hover:bg-olive hover:text-snow"
        >
          GAP Course
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
