---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Section from '../../components/ui/Section.astro';
import SkiOperatorSecureEmbed from '../../components/booking/SkiOperatorSecureEmbed.astro';

// This page has its own SkiOperator embed, so its own sec_ key. Secure mode
// mints a short-lived token per request, so the page renders per request and
// must never be cached — a cached copy would serve an expired token.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// Same 7-level system as /lessons/group, we grade kids on the same ladder.
const levels = [
  {
    name: 'Beginner',
    headline: 'Total beginner, never skied before.',
    bullets: [
      'Learn how to use the equipment',
      'Balance and slide on a nursery slope',
      'Make a snowplough shape',
      'Use magic carpets',
    ],
  },
  {
    name: 'Improver',
    headline: 'Can snowplough turn and stop on a green run.',
    bullets: [
      'Get up after falling',
      'Snowplough traverse',
      'Follow the coach without cutting corners',
      'Use chairlifts (accompanied) and bubble lifts',
    ],
  },
  {
    name: 'Basic Intermediate',
    headline: 'Comfortable snowploughing on greens and easy blues. Ready for parallel.',
    bullets: [
      'Balance on the outside ski',
      'Side-slip (may leave the uphill ski behind)',
      'Parallel traverse with the lower ski gripping',
      'Use chairlifts independently',
    ],
  },
  {
    name: 'Intermediate',
    headline: 'All blue runs and easy reds. Parallel-turning with confidence.',
    bullets: [
      'Direct side-slip, controlling both skis',
      'Ski a corridor, speed and line under control',
      'Hold posture on steeper slopes',
      'Use all lifts',
    ],
  },
  {
    name: 'Basic Advanced',
    headline: 'Comfortable on most reds. Wants to handle changing snow and steeper slopes.',
    bullets: [
      'Lift inside ski at the fall line',
      'Diagonal side-slip with fore-and-aft control',
      'Learning short turns and pole plant',
      'Navigates the ski area',
    ],
  },
  {
    name: 'Advanced',
    headline: 'Happy on any colour. Working on grippy short turns and long carved turns.',
    bullets: [
      'Narrow corridor, speed and line under control',
      'Ski-to-snow contact maintained',
      'Roll edge-to-edge on a green, two clean tracks',
      'Funnel from short to medium to long radius',
      'Laps runs independently and leads around the area',
    ],
  },
  {
    name: 'Expert',
    headline: 'All-mountain confidence. Pushing technique on piste, off-piste, moguls, touring.',
    bullets: [
      'Linked turns in easy moguls',
      'Clean carving on reds and blacks',
      'Flowing turns in off-piste snow',
      'Avalanche scale and equipment',
      'Navigates variables; leads in trees or off-piste',
      'Deals with emergencies; tries green and blue freestyle features',
    ],
  },
];

const tiers = [
  {
    name: "Les P'tits",
    age: '4 – 5',
    duration: '2 hours',
    max: 'Max 4 skiers',
    note: 'Tiny groups for the youngest. Two hours is plenty for little legs — proper progression, no crowds.',
  },
  {
    name: 'Kids group',
    age: '5 – 7',
    duration: '3 hours',
    max: 'Max 6 skiers',
    note: 'Three hours of focused, playful coaching, the right length for shorter attention spans. Peak weeks run 4 hours with a structured break.',
  },
  {
    name: 'Kids group',
    age: '7 – 12',
    duration: '4 hours',
    max: 'Max 6 skiers',
    note: 'A full half-day on snow. Time to explore, learn properly and make friends.',
  },
];

// GCSE Ski PE. Source: the GCSE brief, instructor briefing script and
// instructor checklist (Oct 2026). Has its own SkiOperator embed below.
// Public groups only, in holiday and peak weeks. The brief also has a
// private version; David kept it off the website (Oct 2026).
const gcseCourse = {
  price: '€399',
  priceNote: 'per skier · 3-day course',
  facts: [
    ['Time', '3 hours × 3 days'],
    ['Group', 'Min 3, max 8'],
    ['Days', 'Mon, Wed, Fri, or three in a row'],
  ],
  body: 'Time is split between sharpening technique and filming the footage the exam board needs. We need three skiers to run a group, and it never goes over eight. Monday, Wednesday and Friday, or three days in a row if there is the interest.',
  plan: [
    ['Day 1', 'Technique, coached to hit every exam board criterion.'],
    ['Day 2', 'Warm up, then filming.'],
    ['Day 3', 'Filming and the timed race.'],
  ],
};

const gcseSkills = [
  { name: 'Basic turning', detail: 'Parallel or carved, left and right, with rising speed or gradient.' },
  { name: 'Stopping', detail: 'Parallel or skid stops to both sides, with a controlled finish.' },
  { name: 'Linked turns over distance', detail: 'A continuous run mixing narrow and wide turns, rhythm held throughout.' },
  { name: 'Traversing', detail: 'Both directions, at different angles and speeds, with clear edge control.' },
  { name: 'Skiing at speed', detail: 'Slalom, tight turns or moguls. Clear line choice and control at pace.' },
];


const whyJoin = [
  {
    label: 'Tiny groups',
    body: "Max 4 in Les P'tits and 6 in everything else. Real attention, no being lost in the crowd.",
  },
  {
    label: 'PEAK levels & medals',
    body: 'Sustainably-made medals when your child passes a PEAK level. Progression they can show off.',
  },
  {
    label: 'Built around fun',
    body: 'Activities, exploration and games. Empathy, teamwork and a little healthy competition.',
  },
  {
    label: 'Properly qualified',
    body: 'Every coach holds the highest qualification in their country and a full French Carte Pro.',
  },
  {
    label: 'Ski-school lift lanes',
    body: 'Skip the queues. More time on snow, less time standing around.',
  },
  {
    label: 'Long sessions for older kids',
    body: 'Four-hour groups for 8+, among the longest around. Real progression, not a token slot.',
  },
];

const bring = [
  'Gloves or mittens, mittens are warmer',
  'A waterproof for windy or snowy days',
  'A contact card in their pocket, the lift area gets busy',
  'A few euros for hot chocolate or juice',
  'Layers (one pair of socks only, more = colder feet)',
  'Helmet (compulsory), goggles and sunglasses',
  'Make sure they know where their lift pass lives',
  'Boots comfortable and skis at chin height, no poles for beginners',
  'SPF 30+ suncream and lip balm',
  'Slow-release energy snacks',
];

const faqs = [
  {
    q: 'What ages do you take?',
    a: "If they can walk, they can give it a go, though we wouldn't go below 3 in practice. Check kit sizes go small enough at our rental partners before you commit.",
  },
  {
    q: 'How big are the groups?',
    a: "Four max in Les P'tits (our 4–5 year olds), six max in everything else. We hold those numbers strictly, it's the whole point.",
  },
  {
    q: 'Are helmets compulsory?',
    a: 'Yes, for every child on a course with us. Bring goggles and sunglasses too.',
  },
  {
    q: "What if my child isn't the right level?",
    a: "We usually run several groups alongside so we can shuffle on day one. If that doesn't work, we offer the equivalent time as private lessons.",
  },
  {
    q: 'Lift pass?',
    a: 'Not included, buy at the lift office or through your tour operator. Kids 5 and under ski free.',
  },
  {
    q: 'Where do we drop off and pick up?',
    a: "Meeting points are in our locations section, and we send full details with your booking. You'll have direct contact with the coordinator or coach. Lost? Ring +44 1483 616 522.",
  },
  {
    q: 'Equipment hire?',
    a: "We work with a few trusted local partners, see the Partners section, and you'll get a discount when you book through us.",
  },
  {
    q: 'Do your coaches speak English?',
    a: "Yes, they're either from the UK or fluent.",
  },
  {
    q: 'Cancellation?',
    a: "Give us a month's notice and you're 100% refunded. Inside a month, we issue lesson credit for you or a gifted family member to use later.",
  },
  {
    q: 'What if the weather turns?',
    a: 'We run lessons in all weather. If the lifts and pistes are officially closed, we send a statement of fact you can take to your insurer.',
  },
];
---

<BaseLayout
  title="Kids & teens ski school in Morzine, Avoriaz, Châtel & Les Gets · Peak Snowsports"
  description="School-holiday kids' ski lessons across the Portes du Soleil for ages 4–12, plus GCSE Ski PE courses for teens. Max 6 per group, max 4 in Les P'tits (4–5 yrs). PEAK level system with medals."
  image="/images/og/lessons.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Children ski lessons',
    name: "Peak Snowsports Kids' & Teens' Ski School",
    description: "Holiday-week kids' ski groups for ages 4–12 across Morzine, Avoriaz, Châtel and Les Gets. Max 6 per group, max 4 in Les P'tits (4–5 yrs). Three-day GCSE Ski PE group courses for teens in holiday weeks.",
    provider: { '@id': 'https://www.peaksnowsports.com/#organization' },
    audience: { '@type': 'PeopleAudience', suggestedMinAge: 4, suggestedMaxAge: 16 },
  }}
>
  <Hero
    kicker="Lessons · Kids & teens"
    headline="Small groups. Big confidence."
    sub="School-holiday ski lessons for kids 4–12. Six max per group (four in Les P'tits). Sustainably-made medals when they pass a PEAK level. GCSE Ski PE courses for teens."
    primaryCta={{ href: '#book', label: 'Check availability' }}
    secondaryCta={{ href: '#levels', label: "Find their level" }}
    variant="full"
    video="/videos/technique-hands-on-hips.mp4"
    videoPoster="/videos/technique-hands-on-hips-poster.jpg"
    imageAlt="A young skier working a posture drill above Morzine."
  />

  <!-- Booking -->
  <Section id="book" kicker="Book your kid's place" title="Holiday weeks fill fast.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/85 md:text-xl">
      Strict on group sizes — six max in regular kids groups, four in Les P'tits (4–5 yrs). First come, first served. Pick a duration, level and week below.
    </p>
    <div class="mt-12">
      <SkiOperatorSecureEmbed title="Kids ski school" keyEnv="SKI_OPERATOR_KIDS_GROUPS" />
    </div>
    <p class="meta mt-6 text-olive/55">
      Booking delivered by SkiOperator. Trouble loading? <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:text-snow hover:underline">Get in touch</a>.
    </p>
  </Section>

  <!-- Welcome / overview -->
  <Section kicker="Welcome" title="Made for the school holidays.">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,460px)] lg:gap-20">
      <div class="space-y-10">
        <p class="text-xl font-medium leading-snug text-olive md:text-2xl">
          Kids learn through activities, exploration and games. Small groups, patient coaches, the same instructors who train the next generation of teachers. Medals when they earn them.
        </p>

        <dl class="grid gap-x-6 gap-y-6 border-y border-olive/10 py-6 sm:grid-cols-3">
          <div>
            <dt class="meta text-olive/50">Group size</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">6 max</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Ages</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">4 – 16</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">When</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">School hols</dd>
          </div>
        </dl>

        <div class="space-y-5 text-base leading-relaxed text-olive/75 md:text-lg">
          <p>
            Strict on group sizes, six max in regular kids groups, four in Les P'tits for our 4–5 year olds. It's the only way to give every child the 1-to-1 moments that actually move the needle. First come, first served.
          </p>
          <p>
            All on the PEAK 7-level system: every child gets graded honestly and earns a medal when they pass a level. Sustainably made, properly earned.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        <div class="rounded-none border border-olive bg-cream p-6">
          <p class="meta text-olive">Les P'tits · 4 – 5 yrs</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">2 hours · max 4</p>
          <p class="mt-1 text-sm text-olive/70">Tiny groups for the youngest.</p>
        </div>
        <div class="rounded-none border border-olive bg-cream p-6">
          <p class="meta text-olive">Kids group · 5 – 7 yrs</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">3 hours · max 6</p>
          <p class="mt-1 text-sm text-olive/70">Right length for shorter attention spans. 4 hrs in peak weeks.</p>
        </div>
        <div class="rounded-none border border-olive bg-cream p-6">
          <p class="meta text-olive">Kids group · 7 – 12 yrs</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">4 hours · max 6</p>
          <p class="mt-1 text-sm text-olive/70">Among the longest kids groups in the area.</p>
        </div>
        <a href="#gcse" class="block rounded-none border border-olive bg-cream p-6 no-underline transition-colors hover:bg-accent hover:text-paper">
          <p class="meta">GCSE Ski PE · 14 – 16 yrs</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">3 days · small groups, holiday weeks</p>
          <p class="mt-1 text-sm opacity-70">Coached and filmed for the GCSE PE skiing assessment. →</p>
        </a>
      </div>
    </div>
  </Section>

  <!-- Why join -->
  <Section kicker="Why join" title="What makes our kids groups different.">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {whyJoin.map((w) => (
        <li class="rounded-none border border-olive bg-cream p-6">
          <p class="meta text-olive/50">{w.label}</p>
          <p class="mt-3 text-base leading-relaxed text-olive/80 md:text-lg">{w.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Groups -->
  <Section kicker="Three groups" title="Pick your child's group.">
    <div class="grid gap-6 md:grid-cols-2">
      {tiers.map((t) => (
        <article class="rounded-none border border-olive bg-cream p-8 md:p-10">
          <p class="meta text-olive/50">{t.name} · Ages {t.age}</p>
          <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{t.duration}</h3>
          <p class="meta mt-3 inline-flex items-center rounded-sm bg-yellow px-3 py-1 text-snow">{t.max}</p>
          <p class="mt-6 text-base leading-relaxed text-olive/80 md:text-lg">{t.note}</p>
          <a
            href="#book"
            class="meta mt-8 inline-flex items-center gap-2 text-olive transition-colors hover:bg-yellow hover:text-snow"
          >
            Check availability →
          </a>
        </article>
      ))}
    </div>
  </Section>

  <!-- GCSE Ski PE -->
  <Section id="gcse" kicker="GCSE Ski PE · Teens 14 – 16" title="Taking GCSE PE on skis? This is the course.">
    <div class="max-w-3xl space-y-6 text-lg leading-relaxed text-olive/85 md:text-xl">
      <p class="text-xl font-medium leading-snug text-olive md:text-2xl">
        Three days of coaching and filming for the GCSE PE skiing assessment. We aim for top marks, and for skiing that carries on long after school.
      </p>
      <p>
        The footage we shoot is the evidence your child is graded on. The instructor coaches every skill to the exam board's criteria, films it on the spot and uploads it during the lesson. If a skill isn't clear on camera, we film it again there and then.
      </p>
      <p class="text-base text-olive/70 md:text-lg">
        For AQA, OCR and Edexcel candidates assessed in skiing (not snowboarding). Tell us your exam board when you book, so we can prepare the right criteria.
      </p>
    </div>

    <!-- The course, with its booking embed alongside. The embed is the
         source of truth for dates, so there is no separate week list. -->
    <article class="mt-16 grid rounded-none border border-olive bg-cream lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)]">
      <div class="p-8 md:p-10">
        <p class="meta text-olive/50">GCSE Ski PE · Group course</p>
        <p class="mt-3 font-display text-4xl font-bold tracking-tight md:text-5xl">{gcseCourse.price}</p>
        <p class="meta mt-1 text-olive/60">{gcseCourse.priceNote}</p>
        <dl class="mt-6 grid gap-4 border-y border-olive/10 py-5 sm:grid-cols-3">
          {gcseCourse.facts.map(([label, value]) => (
            <div>
              <dt class="meta text-olive/50">{label}</dt>
              <dd class="mt-1 font-display text-base font-bold tracking-tight">{value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 text-base leading-relaxed text-olive/80 md:text-lg">{gcseCourse.body}</p>
        <p class="meta mt-10 text-olive/55">How the three days run</p>
        <ol class="mt-4 space-y-4">
          {gcseCourse.plan.map(([label, text]) => (
            <li class="border-t border-olive/15 pt-4">
              <p class="meta text-accent">{label}</p>
              <p class="mt-1 text-base leading-relaxed text-olive/85 md:text-lg">{text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div id="book-gcse" class="scroll-mt-24 border-t border-olive bg-paper p-4 md:p-6 lg:border-l lg:border-t-0">
        <p class="meta px-1 pb-4 text-olive/60">Book · add your child's exam board in the skier details</p>
        <SkiOperatorSecureEmbed title="GCSE Ski PE" keyEnv="SKI_OPERATOR_GCSE_SKI_PE" />
      </div>
    </article>

    <!-- What gets filmed -->
    <div class="mt-20 grid items-start gap-12 lg:grid-cols-[minmax(0,380px)_1fr] lg:gap-20">
      <div>
        <h3 class="font-display text-2xl font-bold tracking-tight md:text-3xl">What gets filmed.</h3>
        <p class="mt-4 text-base leading-relaxed text-olive/75 md:text-lg">
          It starts with a short ID clip: name, exam board, date and location. Then the two parts of the assessment.
        </p>
        <p class="mt-4 text-base leading-relaxed text-olive/75 md:text-lg">
          We ask for control, decision making and consistency, not just speed. Ski to the brief and the marks follow.
        </p>
      </div>
      <div class="space-y-10">
        <div>
          <p class="meta text-olive/55">Part 1 · Skills · 10 marks</p>
          <p class="mt-2 text-base text-olive/75">Progressive drills, not full runs, each getting faster, steeper or more technical.</p>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {gcseSkills.map((sk, i) => (
              <li class="border-t border-olive/15 pt-4">
                <p class="meta text-accent">Skill {i + 1}</p>
                <p class="mt-1 font-display text-lg font-bold tracking-tight">{sk.name}</p>
                <p class="mt-1 text-sm leading-relaxed text-olive/75 md:text-base">{sk.detail}</p>
              </li>
            ))}
            <li class="border-t border-olive/15 pt-4">
              <p class="meta text-accent">Extras</p>
              <p class="mt-1 font-display text-lg font-bold tracking-tight">Handling kit</p>
              <p class="mt-1 text-sm leading-relaxed text-olive/75 md:text-base">Carrying skis, putting them on, herringbone and sidestep.</p>
            </li>
          </ol>
        </div>
        <div>
          <p class="meta text-olive/55">Part 2 · Full context · 15 marks</p>
          <p class="mt-2 text-base leading-relaxed text-olive/80 md:text-lg">
            Two timed runs around poles or gates, the same setup each time, just like a race. These need a closed piste, which we only have when the race club is running, so we'll confirm whether your week includes them.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Find their level -->
  <Section id="levels" kicker="Find their level" title="Where are they on the mountain?">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Read down until something sounds like your child. If they're between two, pick the lower, we move kids up on day one when it's a clear fit.
    </p>

    <!-- Peak Progress Book link -->
    <a
      href="/Ski level book (Booklets).pdf"
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center gap-3 rounded-none border border-olive bg-cream px-5 py-4 no-underline transition-colors hover:bg-pink hover:text-snow"
    >
      <span class="meta-pill">PDF</span>
      <span class="font-display text-base font-bold tracking-tight md:text-lg">Peak Progress Book</span>
      <span class="text-sm text-olive/70 group-hover:text-snow/85">What we assess in kids' groups · medals + progress</span>
      <span aria-hidden="true" class="ml-2">↗</span>
    </a>
    <ol class="mt-16 space-y-16">
      {levels.map((l, i) => (
        <li class="border-t border-olive/10 pt-10">
          <div class="grid gap-6 md:grid-cols-[5rem_1fr]">
            <span class="meta inline-flex h-14 w-14 items-center justify-center rounded-full bg-yellow text-snow">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="meta text-olive/50">Level {i + 1}</p>
              <h3 class="mt-1 font-display text-2xl font-bold tracking-tight md:text-4xl">{l.name}</h3>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-olive/80">{l.headline}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {l.bullets.map((b) => (
                  <li class="flex gap-3 text-base leading-relaxed text-olive/80">
                    <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- What to bring -->
  <Section kicker="On the day" title="What to bring.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Pack the night before. A cold or hungry kid won't remember the skiing.
    </p>
    <ul class="mt-12 grid gap-3 md:grid-cols-2">
      {bring.map((item) => (
        <li class="flex gap-3 border-b border-olive/10 pb-4 text-base leading-relaxed text-olive/80 md:text-lg">
          <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- FAQs (two-column accordion) -->
  <Section kicker="FAQs" title="The questions parents actually ask.">
    <ul class="grid gap-3 md:grid-cols-2 md:gap-4">
      {faqs.map((f) => (
        <li class="rounded-none border border-olive bg-snow">
          <details class="group">
            <summary class="flex cursor-pointer items-start justify-between gap-4 list-none px-5 py-4 [&::-webkit-details-marker]:hidden">
              <span class="font-display text-base font-bold tracking-tight text-olive md:text-lg">{f.q}</span>
              <span aria-hidden="true" class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-olive text-sm transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="border-t border-olive/15 px-5 py-4 text-base leading-relaxed text-olive/85">
              {f.a}
            </div>
          </details>
        </li>
      ))}
    </ul>
    <p class="meta mt-10 text-olive/65">
      Still not sure?
      <a href="tel:+441483616522" class="-mx-1 rounded px-1 underline-offset-4 transition-colors hover:bg-pink hover:text-snow hover:underline">+44 1483 616 522</a>
      or
      <a href="/contact" class="-mx-1 rounded px-1 underline-offset-4 transition-colors hover:bg-pink hover:text-snow hover:underline">drop us a line</a>.
    </p>
  </Section>
</BaseLayout>
