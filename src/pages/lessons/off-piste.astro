---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Section from '../../components/ui/Section.astro';
import SkiOperatorEmbed from '../../components/booking/SkiOperatorEmbed.astro';
import { sanity, lessonBySlugQuery } from '../../lib/sanity';

type Cta = { label?: string; href?: string };
type Fact = { label?: string; value?: string };

interface Lesson {
  _id: string;
  name: string;
  slug: string;
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroHeadline?: string;
  heroSub?: string;
  heroPrimaryCta?: Cta;
  heroSecondaryCta?: Cta;
  introKicker?: string;
  introTitle?: string;
  introBody?: string[];
  introFactTiles?: Fact[];
  contentSectionKicker?: string;
  contentSectionTitle?: string;
  contentItems?: string[];
  kitKicker?: string;
  kitTitle?: string;
  kitBody?: string;
  kitItems?: string[];
  bookingKicker?: string;
  bookingTitle?: string;
  archProductId?: string;
}

const lesson = (await sanity.fetch<Lesson | null>(lessonBySlugQuery, {
  slug: 'off-piste',
})) ?? ({} as Lesson);

const heroPrimary =
  lesson.heroPrimaryCta?.href && lesson.heroPrimaryCta.label
    ? { href: lesson.heroPrimaryCta.href, label: lesson.heroPrimaryCta.label }
    : undefined;
const heroSecondary =
  lesson.heroSecondaryCta?.href && lesson.heroSecondaryCta.label
    ? { href: lesson.heroSecondaryCta.href, label: lesson.heroSecondaryCta.label }
    : undefined;
---

<BaseLayout
  title={lesson.seoTitle}
  description={lesson.seoDescription}
  image="/images/og/lessons.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Off-piste skiing instruction',
    name: 'Off-piste & freeride · Peak Snowsports',
    description: lesson.seoDescription,
    provider: { '@id': 'https://www.peaksnowsports.com/#organization' },
    areaServed: ['Morzine', 'Avoriaz', 'Châtel', 'Les Gets', 'Portes du Soleil'],
  }}
>
  <Hero
    kicker={lesson.heroKicker}
    headline={lesson.heroHeadline ?? ''}
    sub={lesson.heroSub}
    primaryCta={heroPrimary}
    secondaryCta={heroSecondary}
    variant="compact"
  />

  <!-- Intro -->
  <Section kicker={lesson.introKicker} title={lesson.introTitle}>
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,420px)] lg:gap-20">
      <div class="space-y-6 text-lg leading-relaxed text-olive/85 md:text-xl">
        {(lesson.introBody ?? []).map((p) => <p>{p}</p>)}
      </div>

      <ul class="grid grid-cols-2 gap-3">
        {(lesson.introFactTiles ?? []).map((f) => (
          <li class="rounded-2xl border border-olive bg-cream px-5 py-4">
            <p class="meta text-olive/55">{f.label}</p>
            <p class="mt-2 font-display text-xl font-bold tracking-tight">{f.value}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Clinic content -->
  <Section id="what-we-cover" kicker={lesson.contentSectionKicker} title={lesson.contentSectionTitle}>
    <ul class="grid gap-4 md:grid-cols-2">
      {(lesson.contentItems ?? []).map((item) => (
        <li class="flex gap-4 rounded-2xl border border-olive bg-snow p-5">
          <span class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-pink" aria-hidden="true" />
          <span class="text-base leading-relaxed text-olive md:text-lg">{item}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Kit list -->
  {lesson.kitTitle && (
    <Section kicker={lesson.kitKicker} title={lesson.kitTitle}>
      {lesson.kitBody && (
        <p class="max-w-2xl text-lg leading-relaxed text-olive/85 md:text-xl">{lesson.kitBody}</p>
      )}
      <ul class="mt-10 grid gap-3 md:grid-cols-2">
        {(lesson.kitItems ?? []).map((item) => (
          <li class="flex gap-4 rounded-2xl bg-cream p-5">
            <span class="mt-2 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-pink" aria-hidden="true" />
            <span class="text-base leading-relaxed text-olive md:text-lg">{item}</span>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- Availability widget -->
  <Section id="availability" kicker={lesson.bookingKicker} title={lesson.bookingTitle}>
    <SkiOperatorEmbed title="Off-piste & freeride lessons" />
    <p class="meta mt-6 text-olive/55">
      Booking delivered by SkiOperator. Trouble loading? <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:underline">Get in touch</a>.
    </p>
  </Section>
</BaseLayout>
