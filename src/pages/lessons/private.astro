---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Hero from '../../components/hero/Hero.astro';
import SkiOperatorSecureEmbed from '../../components/booking/SkiOperatorSecureEmbed.astro';

// The booking embed uses SkiOperator's secure server mode: a fresh, short-lived
// token is minted server-side on every request. That means this page renders
// per request rather than at build time, and must never be cached — a cached
// copy would serve an expired token. Every other page stays static.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const whoItsFor = {
  group: ['Solo', 'Couples', 'Small groups'],
  level: ['Beginner', 'Intermediate', 'Advanced'],
};

// 2026/27 season pricing. "From" prices are the 1–2 skier rate; groups of
// 3–6 add €10–20 per session per the price sheet.
const offPeakPricing = [
  { label: '2.5 hours (PM only)', price: '€295' },
  { label: '3 hours', price: '€354' },
  { label: '4 hours', price: '€460' },
  { label: 'Full day · 6 hours', price: '€650' },
  { label: 'Full day · 7 hours', price: '€730' },
];
const peakPricing = [
  { label: '2.5 hours (PM only)', price: '€324.50' },
  { label: '3 hours', price: '€389.40' },
  { label: '4 hours', price: '€506' },
  { label: 'Full day · 6 hours (w/c 19 Dec)', price: '€715' },
  { label: 'Full day · 7 hours (Feb half term)', price: '€750' },
  { label: 'Full day · 7 hours (New Year & Easter)', price: '€803' },
];

const meetingPoints = [
  { resort: 'Morzine', points: 'Pleney bubble' },
  { resort: 'Avoriaz', points: 'Prodains bubble · Ardent bubble · Super M bubble' },
  { resort: 'Châtel', points: 'Pré la Joux' },
  { resort: 'Les Gets', points: 'Chavannes bubble' },
];

const instructors = [
  { name: 'Tom Peek', seasons: 12, langs: 'EN/FR', specs: ['Off-piste', 'Advanced', 'Race'] },
  { name: 'Eilidh', seasons: 8, langs: 'EN/FR', specs: ['Freeride', 'Intermediate', 'Family'] },
  { name: 'George', seasons: 10, langs: 'EN', specs: ['Family', 'Beginner', 'Kids'] },
];
---

<BaseLayout
  title="Private ski lessons in Morzine, Avoriaz, Châtel & Les Gets · Peak Snowsports"
  description="One-to-one private ski lessons with a dedicated Peak instructor. Half day to a full day. All levels, all four home resorts. Request your preferred instructor by name."
  image="/images/og/lessons.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Private ski lessons',
    name: 'Private ski lessons · Peak Snowsports',
    description: 'One-to-one private ski lessons across Morzine, Avoriaz, Châtel and Les Gets. Half day to a full day. All levels.',
    provider: { '@id': 'https://www.peaksnowsports.com/#organization' },
    areaServed: ['Morzine', 'Avoriaz', 'Châtel', 'Les Gets'],
  }}
>
  <!-- Breadcrumb + Hero -->
  <nav aria-label="Breadcrumb" class="mx-auto max-w-screen-2xl px-6 pt-8 md:px-10">
    <p class="meta text-ink-70">
      <a href="/lessons" class="no-underline transition-colors hover:text-accent">Lessons</a>
      <span class="px-2" aria-hidden="true">/</span>
      <span class="text-ink-70">Private lessons</span>
    </p>
  </nav>

  <Hero
    kicker="Private lessons"
    headline="One instructor. You, or your people."
    sub="Half day to a full day. All levels. All resorts."
    variant="compact"
    facts={[
      { label: 'From', value: '\u20AC295' },
      { label: 'Durations', value: '2.5h \u00B7 3h \u00B7 Full day' },
      { label: 'Starts', value: '09:15 \u00B7 13:00 \u00B7 14:00' },
      { label: 'Resorts', value: 'All three' },
    ]}
  />

  <!-- Details + booking.
       The embed sits in the right-hand column from xl up so it's in view
       straight under the hero rather than at the foot of the page. It comes
       first in source order, which puts it directly under the hero when the
       columns stack on phones, tablets and small laptops; grid placement
       below moves it back to the right on xl without reordering the markup.
       The split waits for xl (1280px) on purpose: at lg the copy column comes
       out narrower than the embed beside it, which reads as a mistake. -->
  <!-- pt override: with no hero media, Hero emits an empty 80px spacer.
       Section's own 96px top padding on top of that left a 176px dead
       band under the facts row. -->
  <Section rule={false} class="pt-6 md:pt-8 lg:pt-8">
    <div class="grid gap-x-10 gap-y-14 xl:grid-cols-[minmax(0,1fr)_minmax(0,480px)] xl:items-start">

      <div id="book" class="xl:col-start-2 xl:row-start-1">
        <p class="meta mb-5 text-ink-70">Ready to book</p>
        <SkiOperatorSecureEmbed title="Private lessons" class="overflow-hidden rounded-none border border-olive/10 bg-snow" />
        <p class="meta mt-5 text-olive/55">
          Booking delivered by SkiOperator. Trouble loading? <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:text-snow hover:underline">Get in touch</a> and we'll book you in directly.
        </p>
      </div>

      <div class="space-y-14 xl:col-start-1 xl:row-start-1">

        <!-- The clip runs alongside both of the short blocks rather than just
             the first. "What you get" is a two-line paragraph; on its own it
             left most of the column blank beside a portrait video. Paired with
             "Who it's for" as well, the two columns come out close in height.
             The source is 720x900 (4:5), NOT 9:16 — framing it 9:16 letterboxes
             it with black bars. nocookie domain: the player must not drop
             advertising cookies before a visitor has answered the consent
             banner. -->
        <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_300px] md:items-start">

          <div class="space-y-14">
            <div>
              <h2 class="text-3xl md:text-4xl">What you get</h2>
              <p class="mt-5 text-lg leading-relaxed text-olive/80">
                A dedicated instructor for the time you book. They'll meet you at a fixed point, ski with you, and tailor the lesson to what you want to get out of it.
              </p>
            </div>

            <div>
              <h2 class="text-3xl md:text-4xl">Who it's for</h2>
              <div class="mt-6 flex flex-wrap gap-2">
                {whoItsFor.group.map((g, i) => (
                  <span class={`meta rounded-sm border px-4 py-2 ${i === 2 ? 'border-accent bg-accent text-snow' : 'border-ink/20 text-ink-70'}`}>
                    {g}
                  </span>
                ))}
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {whoItsFor.level.map((l, i) => (
                  <span class={`meta rounded-sm border px-4 py-2 ${i === 2 ? 'border-accent bg-accent text-snow' : 'border-ink/20 text-ink-70'}`}>
                    {l}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <figure class="w-full max-w-[300px] md:mt-2">
            <div class="overflow-hidden rounded-none bg-brown">
              <iframe
                class="block aspect-[4/5] w-full"
                src="https://www.youtube-nocookie.com/embed/cW1JHtz86uk"
                title="Carve your skis this winter"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                allowfullscreen
                style="border:0;"
              ></iframe>
            </div>
            <figcaption class="meta mt-3 text-olive/60">Watch · Carve your skis this winter</figcaption>
          </figure>
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl">Duration &amp; pricing</h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-olive/75">
            "From" prices per group, 2026/27 season. Groups of 3&ndash;6 skiers add €10&ndash;20 per session. Sessions start 09:15, 13:00 and 14:00.
          </p>

          <!-- CSS-only tab toggle. Radios, labels, and tables are all direct
               siblings so Tailwind's peer-checked (general-sibling selector)
               can reach every element it needs to style. -->
          <div class="mt-8 max-w-xl">
            <input type="radio" name="private-price-view" id="price-offpeak" class="peer/off sr-only" checked />
            <label
              for="price-offpeak"
              role="tab"
              class="meta mr-2 inline-flex cursor-pointer items-center rounded-sm border border-olive/20 bg-cream px-5 py-2 text-olive/70 transition peer-checked/off:border-olive-deep peer-checked/off:bg-olive-deep peer-checked/off:text-salt"
            >Off-peak</label>
            <input type="radio" name="private-price-view" id="price-peak" class="peer/peak sr-only" />
            <label
              for="price-peak"
              role="tab"
              class="meta inline-flex cursor-pointer items-center rounded-sm border border-olive/20 bg-cream px-5 py-2 text-olive/70 transition peer-checked/peak:border-olive-deep peer-checked/peak:bg-olive-deep peer-checked/peak:text-salt"
            >Peak</label>

            <!-- Off-peak table -->
            <div class="mt-6 hidden peer-checked/off:block" role="tabpanel">
              <ul class="divide-y divide-olive/10 overflow-hidden rounded-none border border-olive/10">
                {offPeakPricing.map((p) => (
                  <li class="flex items-center justify-between bg-snow px-6 py-4">
                    <span class="text-sm">{p.label}</span>
                    <span class="font-display text-lg font-bold tracking-tight">{p.price}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Peak table -->
            <div class="mt-6 hidden peer-checked/peak:block" role="tabpanel">
              <ul class="divide-y divide-olive/10 overflow-hidden rounded-none border border-olive/10">
                {peakPricing.map((p) => (
                  <li class="flex items-center justify-between bg-snow px-6 py-4">
                    <span class="text-sm">{p.label}</span>
                    <span class="font-display text-lg font-bold tracking-tight">{p.price}</span>
                  </li>
                ))}
              </ul>
              <p class="meta mt-4 text-olive/60">
                Peak weeks 2026/27: w/c 19 Dec (6-hr day), w/c 26 Dec &middot; 27 Mar &middot; 3 Apr (7-hr day), w/c 13 &amp; 20 Feb (Feb half term, 7-hr day).
              </p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl">Meeting points</h2>
          <ul class="meta mt-6 space-y-2 text-olive/70">
            {meetingPoints.map((m) => (
              <li>
                <span class="text-olive">{m.resort}</span>
                <span class="px-2 text-olive/40">,</span>
                <span>{m.points}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

    </div>
  </Section>

  <!-- Trust strip on brown -->
  <section class="bg-ink text-snow">
    <div class="mx-auto max-w-screen-2xl px-6 py-16 md:px-10 md:py-20">
      <h2 class="text-3xl md:text-5xl">Your instructor in Morzine.</h2>
      <p class="mt-4 max-w-2xl text-lg text-salt/85">
        Browse, or let us match you. All Peak instructors are BASI-qualified.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {instructors.map((i) => (
          <a
            href={`/instructors/${i.name.toLowerCase().replace(/[^a-z]+/g, '-')}`}
            class="group block border-t border-snow/25 pt-5 no-underline transition-colors hover:border-accent"
          >
            <div class="flex items-center gap-4">
              <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full bg-olive-deep" aria-hidden="true"></div>
              <div>
                <p class="font-display text-lg font-semibold tracking-tight">{i.name}</p>
                <p class="meta mt-1 text-salt/60">{i.seasons} seasons &middot; {i.langs}</p>
              </div>
            </div>
            <p class="meta mt-5 text-salt/85">{i.specs.join(' · ')}</p>
          </a>
        ))}
      </div>

      <div class="mt-10">
        <a
          href="/instructors?resort=morzine"
          class="inline-flex items-center gap-2 rounded-sm border border-snow/30 px-6 py-3 font-display text-sm font-semibold no-underline transition-colors hover:border-snow"
        >
          Browse all Morzine instructors →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
