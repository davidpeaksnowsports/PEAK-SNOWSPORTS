---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/Card.astro';
import heroImage from '../../assets/images/hero-lessons.jpg';
import { sanity, lessonsPageQuery, allLessonsQuery } from '../../lib/sanity';

type Cta = { label?: string; href?: string };
type Fact = { label?: string; value?: string };

interface Lesson {
  _id: string;
  name: string;
  slug: string;
  order?: number;
  cardKicker?: string;
  cardBody?: string;
  externalHref?: string;
}

interface LessonsPage {
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroHeadline?: string;
  heroSub?: string;
  heroPrimaryCta?: Cta;
  heroSecondaryCta?: Cta;
  promoEnabled?: boolean;
  promoKicker?: string;
  promoBody?: string;
  promoCta?: Cta;
  productsKicker?: string;
  productsTitle?: string;
  philosophyKicker?: string;
  philosophyTitle?: string;
  philosophyParagraphs?: string[];
  philosophyFacts?: Fact[];
  peakProgressKicker?: string;
  peakProgressTitle?: string;
  peakProgressParagraphs?: string[];
  peakProgressFooter?: string;
  peakProgressFacts?: Fact[];
  levelsKicker?: string;
  levelsTitle?: string;
  levelsLead?: string;
  levels?: { label?: string; self?: string; skills?: string[]; lifts?: string }[];
  closingTitle?: string;
  closingBody?: string;
  closingPrimaryCta?: Cta;
  closingSecondaryCta?: Cta;
}

const [page, lessons] = (await Promise.all([
  sanity.fetch(lessonsPageQuery),
  sanity.fetch(allLessonsQuery),
])) as [LessonsPage | null, Lesson[]];

const cards = lessons.map((l) => ({
  href: l.externalHref ?? `/lessons/${l.slug}`,
  name: l.name,
  kicker: l.cardKicker,
  body: l.cardBody,
}));

// Render the promo body — supports **bold** spans inline so the discount
// code can be highlighted without leaving the studio.
function renderPromoBody(body: string | undefined) {
  if (!body) return [];
  return body.split(/(\*\*[^*]+\*\*)/g).map((chunk) => ({
    text: chunk.replace(/^\*\*|\*\*$/g, ''),
    bold: chunk.startsWith('**') && chunk.endsWith('**'),
  }));
}
const promoChunks = renderPromoBody(page?.promoBody);

const heroPrimary =
  page?.heroPrimaryCta?.href && page.heroPrimaryCta.label
    ? { href: page.heroPrimaryCta.href, label: page.heroPrimaryCta.label }
    : undefined;
const heroSecondary =
  page?.heroSecondaryCta?.href && page.heroSecondaryCta.label
    ? { href: page.heroSecondaryCta.href, label: page.heroSecondaryCta.label }
    : undefined;
---

<BaseLayout
  title={page?.seoTitle}
  description={page?.seoDescription}
  image="/images/og/lessons.jpg"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Ski lessons',
    name: 'Peak Snowsports Ski Lessons',
    description: page?.seoDescription,
    provider: { '@id': 'https://www.peaksnowsports.com/#organization' },
    areaServed: ['Morzine', 'Avoriaz', 'Châtel', 'Les Gets', 'Portes du Soleil'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Lesson products',
      itemListElement: cards.map((c) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: c.name,
          url: `https://www.peaksnowsports.com${c.href}`,
        },
      })),
    },
  }}
>
  <Hero
    kicker={page?.heroKicker}
    headline={page?.heroHeadline ?? ''}
    sub={page?.heroSub}
    primaryCta={heroPrimary}
    secondaryCta={heroSecondary}
    variant="compact"
    image={heroImage}
    imageAlt="A skier under a chairlift on a busy piste."
  />

  {page?.promoEnabled && page?.promoBody && (
    <section class="bg-olive-deep text-salt">
      <div class="mx-auto flex max-w-screen-2xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between">
        <div>
          {page.promoKicker && <p class="meta-pill">{page.promoKicker}</p>}
          <p class="mt-3 max-w-2xl text-lg leading-snug md:text-xl">
            {promoChunks.map((c) =>
              c.bold ? (
                <strong class="font-display tracking-tight">{c.text}</strong>
              ) : (
                <span>{c.text}</span>
              ),
            )}
          </p>
        </div>
        {page.promoCta?.href && page.promoCta.label && (
          <a
            href={page.promoCta.href}
            class="inline-flex shrink-0 items-center rounded-sm bg-yellow px-8 py-4 font-display text-sm font-semibold text-snow no-underline transition hover:bg-ink"
          >
            {page.promoCta.label}
          </a>
        )}
      </div>
    </section>
  )}

  <!-- Lesson products -->
  <Section kicker={page?.productsKicker} title={page?.productsTitle}>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((p) => (
        <Card href={p.href} kicker={p.kicker} title={p.name}>
          {p.body}
        </Card>
      ))}
    </div>
  </Section>

  <!-- Coaching philosophy -->
  <Section kicker={page?.philosophyKicker} title={page?.philosophyTitle}>
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="space-y-6 text-lg leading-relaxed text-olive/85 md:text-xl">
        {(page?.philosophyParagraphs ?? []).map((p) => <p>{p}</p>)}
      </div>
      <ul class="grid grid-cols-2 gap-4">
        {(page?.philosophyFacts ?? []).map((f) => (
          <li class="rounded-2xl border border-olive bg-cream px-5 py-4">
            <p class="meta text-olive/55">{f.label}</p>
            <p class="mt-2 font-display text-2xl font-bold tracking-tight">{f.value}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Peak Progress -->
  <Section kicker={page?.peakProgressKicker} title={page?.peakProgressTitle}>
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,440px)] lg:gap-20">
      <div class="space-y-6 text-lg leading-relaxed text-olive/85 md:text-xl">
        {(page?.peakProgressParagraphs ?? []).map((p) => <p>{p}</p>)}
        {page?.peakProgressFooter && (
          <p class="meta text-olive/60">{page.peakProgressFooter}</p>
        )}
      </div>
      <ul class="grid grid-cols-2 gap-3">
        {(page?.peakProgressFacts ?? []).map((f, i, arr) => (
          <li class={`rounded-2xl border border-olive bg-cream px-5 py-4 ${i === arr.length - 1 && arr.length % 2 === 1 ? 'col-span-2' : ''}`}>
            <p class="meta text-olive/55">{f.label}</p>
            <p class="mt-2 font-display text-xl font-bold tracking-tight">{f.value}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Find your level -->
  <Section id="levels" kicker={page?.levelsKicker} title={page?.levelsTitle}>
    {page?.levelsLead && (
      <p class="max-w-3xl text-lg leading-relaxed text-olive/80">{page.levelsLead}</p>
    )}
    <ol class="mt-16 space-y-12">
      {(page?.levels ?? []).map((l, i) => (
        <li class="border-t border-olive/15 pt-10">
          <div class="grid gap-6 md:grid-cols-[7rem_1fr]">
            <div>
              <span class="meta-pill">Level {String(i + 1).padStart(2, '0')}</span>
              <p class="mt-3 font-display text-xl font-bold tracking-tight text-olive md:text-2xl">{l.label}</p>
            </div>
            <div>
              {l.self && <p class="text-lg leading-relaxed text-olive md:text-xl">"{l.self}"</p>}
              <div class="mt-6 grid gap-6 md:grid-cols-[1fr_minmax(0,260px)]">
                <ul class="space-y-2">
                  {(l.skills ?? []).map((skill) => (
                    <li class="flex gap-3 text-base text-olive/80"><span class="text-pink">·</span><span>{skill}</span></li>
                  ))}
                </ul>
                {l.lifts && (
                  <div class="rounded-2xl border border-olive bg-cream px-5 py-4 md:self-start">
                    <p class="meta text-olive/55">Lifts</p>
                    <p class="mt-2 text-sm">{l.lifts}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Closing CTA -->
  <Section>
    <div class="border-t border-olive/15 pt-16">
      <h2 class="max-w-3xl text-4xl leading-tight md:text-6xl">{page?.closingTitle}</h2>
      {page?.closingBody && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-olive/80">{page.closingBody}</p>
      )}
      <div class="mt-10 flex flex-wrap gap-3">
        {page?.closingPrimaryCta?.href && page.closingPrimaryCta.label && (
          <a
            href={page.closingPrimaryCta.href}
            class="inline-flex items-center rounded-sm bg-yellow px-8 py-4 font-display text-base font-semibold text-snow no-underline transition hover:bg-ink"
          >
            {page.closingPrimaryCta.label}
          </a>
        )}
        {page?.closingSecondaryCta?.href && page.closingSecondaryCta.label && (
          <a
            href={page.closingSecondaryCta.href}
            class="inline-flex items-center rounded-sm border border-olive/30 px-8 py-4 font-display text-base font-semibold no-underline transition hover:border-yellow hover:bg-yellow hover:text-snow"
          >
            {page.closingSecondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
