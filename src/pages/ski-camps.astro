---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Section from '../components/ui/Section.astro';
import SkiOperatorSecureEmbed from '../components/booking/SkiOperatorSecureEmbed.astro';
import {
  sanity,
  urlFor,
  skiCampsPageQuery,
  skiCampsScheduleQuery,
  campLocationsQuery,
} from '../lib/sanity';

// The camps embed mints a short-lived SkiOperator token per request, so this
// page renders per request and must never be cached. Note this also moves the
// page's Sanity queries from build time to request time.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

type Cta = { label?: string; href?: string };
type FactT = { label?: string; value?: string };
type Tier = { name?: string; price?: number };
type Usp = { label?: string; body?: string };
type ImageRef = { asset?: { _ref?: string } };

interface CampLocation {
  _id: string;
  name?: string;
  slug?: { current?: string };
  area?: string;
  shortBlurb?: string;
  facts?: FactT[];
  pricingTbc?: boolean;
  pricingSubtitle?: string;
  pricingProvisionalNote?: string;
  tiers?: Tier[];
  accommodationHeadline?: string;
  accommodationLogo?: ImageRef;
  accommodationImage?: ImageRef;
  accommodationBody?: string;
  usps?: Usp[];
}

interface ScheduleEntry {
  _id: string;
  startDate: string;
  tag?: string | null;
  confirmed?: boolean;
  locations?: { _id: string; name?: string }[];
}

interface SkiCampsPage {
  seoTitle?: string;
  seoDescription?: string;
  heroKicker?: string;
  heroHeadline?: string;
  heroSub?: string;
  heroPrimaryCta?: Cta;
  heroSecondaryCta?: Cta;
  welcomeKicker?: string;
  welcomeTitle?: string;
  welcomeLead?: string;
  welcomeBullets?: string[];
  welcomeTiles?: { kicker?: string; headline?: string; body?: string }[];
  levels?: { name?: string; forWhom?: string; outcome?: string }[];
  lodgingOptions?: string[];
  onSnowLabel?: string;
  onSnow?: string[];
  offSnowLabel?: string;
  offSnow?: string[];
  accommodationKicker?: string;
  accommodationTitle?: string;
  accommodationLead?: string;
  valAccommodationCard?: { kicker?: string; headline?: string; body?: string };
  whereYouSkiKicker?: string;
  whereYouSkiTitle?: string;
  whereYouSkiLead?: string;
  whatWeCoverKicker?: string;
  whatWeCoverTitle?: string;
  whatWeCover?: { title?: string; body?: string }[];
  faqsKicker?: string;
  faqsTitle?: string;
  faqs?: { q?: string; a?: string }[];
  planBHeadline?: string;
  planBBody?: string;
  bookKicker?: string;
  bookTitle?: string;
  bookLead?: string;
  bookPrimaryCta?: Cta;
  bookSecondaryCta?: Cta;
  bookDisclaimer?: string;
}

const [page, schedule, locations] = (await Promise.all([
  sanity.fetch(skiCampsPageQuery),
  sanity.fetch(skiCampsScheduleQuery),
  sanity.fetch(campLocationsQuery),
])) as [SkiCampsPage | null, ScheduleEntry[], CampLocation[]];

// Pricing / accommodation / "Where you ski" cards all share campLocation data
// but want a stable display order. Slugs missing from the order array fall
// through to the end so a new location auto-appears without code changes.
const order = ['morzine-avoriaz', 'val-disere', 'verbier'];
const locationsBySlug = new Map(locations.map((l) => [l.slug?.current ?? '', l]));
const isDefined = <T,>(v: T | undefined): v is T => v !== undefined;
const orderedLocations: CampLocation[] = [
  ...order.map((s) => locationsBySlug.get(s)).filter(isDefined),
  ...locations.filter((l) => !order.includes(l.slug?.current ?? '')),
];
const pricing = orderedLocations;
const resorts = orderedLocations;
const morzine = locationsBySlug.get('morzine-avoriaz');

const priceFmt = new Intl.NumberFormat('en-GB');
const formatStart = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
const camps = schedule.map((c) => ({
  ...c,
  start: formatStart(c.startDate),
  locationNames: (c.locations ?? []).map((l) => l.name).filter(isDefined),
}));

// Aggregate offer range for structured data.
const allPrices = pricing
  .flatMap((p) => (p.tiers ?? []).map((t) => t.price))
  .filter(isDefined);
const lowPrice = allPrices.length ? Math.min(...allPrices) : undefined;
const highPrice = allPrices.length ? Math.max(...allPrices) : undefined;
const offerCount = allPrices.length;

const heroPrimary =
  page?.heroPrimaryCta?.href && page.heroPrimaryCta.label
    ? { href: page.heroPrimaryCta.href, label: page.heroPrimaryCta.label }
    : undefined;
const heroSecondary =
  page?.heroSecondaryCta?.href && page.heroSecondaryCta.label
    ? { href: page.heroSecondaryCta.href, label: page.heroSecondaryCta.label }
    : undefined;

const faqs = page?.faqs ?? [];
---

<BaseLayout
  title={page?.seoTitle}
  description={page?.seoDescription}
  image="/images/og/ski-camps.jpg"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: page?.seoTitle,
      description: page?.seoDescription,
      brand: { '@type': 'Organization', name: 'Peak Snowsports' },
      image: 'https://www.peaksnowsports.com/images/og/ski-camps.jpg',
      category: 'Adult ski performance camp',
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        ...(lowPrice !== undefined && { lowPrice }),
        ...(highPrice !== undefined && { highPrice }),
        availability: 'https://schema.org/InStock',
        url: 'https://www.peaksnowsports.com/ski-camps#book',
        offerCount,
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Hero
    kicker={page?.heroKicker}
    headline={page?.heroHeadline ?? ''}
    sub={page?.heroSub}
    primaryCta={heroPrimary}
    secondaryCta={heroSecondary}
    variant="full"
    video="/videos/carving.mp4"
    videoPoster="/videos/carving-poster.jpg"
    imageAlt="A skier carving an arc through soft snow above Avoriaz."
  />

  <!-- Welcome / overview -->
  <Section kicker={page?.welcomeKicker} title={page?.welcomeTitle}>
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,460px)] lg:gap-20">
      <div class="space-y-10">
        {page?.welcomeLead && (
          <p class="text-xl font-medium leading-snug text-olive md:text-2xl">{page.welcomeLead}</p>
        )}

        <dl class="grid gap-x-6 gap-y-6 border-y border-olive/10 py-6 sm:grid-cols-3">
          <div>
            <dt class="meta text-olive/50">On snow</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">5 days</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Group size</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">8 max</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Coaches</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">BASI L4 / Trainers</dd>
          </div>
        </dl>

        <div class="space-y-5 text-base leading-relaxed text-olive/75 md:text-lg">
          {(page?.welcomeBullets ?? []).map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="space-y-4">
        {(page?.welcomeTiles ?? []).map((t) => (
          <div class="rounded-none border border-olive bg-cream p-6">
            <p class="meta text-olive">{t.kicker}</p>
            <p class="mt-2 font-display text-xl font-bold tracking-tight">{t.headline}</p>
            {t.body && <p class="mt-1 text-sm text-olive/70">{t.body}</p>}
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Photo gallery -->
  <div class="mx-auto max-w-screen-2xl px-6 pb-16 md:pb-24">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      <div class="col-span-2 overflow-hidden rounded-none md:col-span-1">
        <img
          src="/images/ski-camps/camp-instructor.jpg"
          alt="Peak Snowsports instructor on the mountain above Avoriaz"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
      <div class="overflow-hidden rounded-none">
        <img
          src="/images/ski-camps/camp-lunch.jpg"
          alt="Camp group lunch at a mountain restaurant in the Portes du Soleil"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
      <div class="overflow-hidden rounded-none">
        <img
          src="/images/ski-camps/camp-group.jpg"
          alt="Ski camp group session on the slopes above Avoriaz"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
    </div>
  </div>

  <!-- Pick your level -->
  <Section id="camps" kicker="Two levels" title="Pick your level.">
    <div class="grid gap-6 md:grid-cols-2">
      {(page?.levels ?? []).map((l) => (
        <article class="rounded-none border border-olive bg-cream p-8 md:p-10">
          <p class="meta text-olive/50">Ski camp</p>
          <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{l.name}</h3>
          <p class="mt-5 text-base leading-relaxed text-olive/80 md:text-lg">{l.forWhom}</p>
          <p class="mt-4 text-base leading-relaxed text-olive/65 md:text-lg">{l.outcome}</p>

          <p class="meta mt-8 text-olive/50">Three ways to join</p>
          <ul class="mt-3 space-y-2">
            {(page?.lodgingOptions ?? []).map((opt) => (
              <li class="flex items-center gap-3 text-sm text-olive md:text-base">
                <span aria-hidden="true" class="text-olive/40">·</span>
                <span>{opt}</span>
              </li>
            ))}
          </ul>

          <a
            href="#book"
            class="mt-8 inline-flex items-center rounded-sm bg-yellow px-6 py-3 font-display text-sm font-semibold text-snow no-underline transition hover:bg-ink"
          >
            Check availability →
          </a>
        </article>
      ))}
    </div>
  </Section>

  <!-- Camp dates -->
  <Section id="dates" kicker="2026/27 season" title="Dates and locations.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Seven five-day camps across the season. Arrival to resort is the day before camp starts (Sunday). If you book accommodation, check-out is the Saturday after camp finishes.
    </p>
    <ul class="mt-12 divide-y divide-olive/10 border-y border-olive/10">
      {camps.map((c) => (
        <li class="grid gap-3 py-5 sm:grid-cols-[minmax(0,11rem)_1fr_auto] sm:items-center sm:gap-6">
          <p class="font-display text-lg font-bold tracking-tight md:text-xl">{c.start}</p>
          <p class="text-base leading-snug text-olive/80 md:text-lg">{c.locationNames.join(' · ')}</p>
          {c.tag ? (
            <span class="meta inline-flex w-fit items-center rounded-sm bg-yellow px-3 py-1 text-snow">{c.tag}</span>
          ) : (
            <span class="sm:block" aria-hidden="true" />
          )}
        </li>
      ))}
    </ul>
    <p class="meta mt-8 text-olive/55">All camps run Monday to Friday. We confirm each camp 6 weeks before it starts.</p>

    {page?.planBHeadline && (
      <div class="mt-10 rounded-none border border-olive bg-cream p-6 md:p-8">
        <p class="meta font-bold text-olive">{page.planBHeadline}</p>
        <p class="mt-3 text-base leading-relaxed text-olive/80 md:text-lg">{page.planBBody}</p>
      </div>
    )}
  </Section>

  <!-- Pricing -->
  <Section id="pricing" kicker="Pricing" title="Pick your camp. Pick your package.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Prices per person, in euros, for the full five-day camp. Accommodation packages include half-board, with arrival the Sunday before and check-out the Saturday after.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pricing.map((p) => (
        <article class="rounded-none border border-olive bg-cream p-8 md:p-10">
          <p class="meta font-bold text-olive">{p.pricingSubtitle}</p>
          <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{p.name}</h3>
          {p.pricingTbc ? (
            <>
              <p class="mt-8 font-display text-2xl font-bold tracking-tight md:text-3xl">Pricing TBC</p>
              <p class="mt-3 text-base leading-relaxed text-olive/75 md:text-lg">
                Our 14 Dec Verbier camp is being finalised. Get in touch and we'll share the latest on coaching rates, accommodation options and availability.
              </p>
              <a
                href="/contact"
                class="mt-8 inline-flex items-center rounded-sm bg-yellow px-6 py-3 font-display text-sm font-semibold text-snow no-underline transition hover:bg-ink"
              >
                Enquire →
              </a>
            </>
          ) : (
            <>
              <dl class="mt-8 divide-y divide-olive/10 border-y border-olive/10">
                {(p.tiers ?? []).map((t) => (
                  <div class="flex items-baseline justify-between gap-6 py-4">
                    <dt class="text-base text-olive/80 md:text-lg">{t.name}</dt>
                    <dd class="font-display text-2xl font-bold tracking-tight md:text-3xl">€{priceFmt.format(t.price ?? 0)}</dd>
                  </div>
                ))}
              </dl>
              {p.pricingProvisionalNote && (
                <p class="meta mt-4 text-olive/60">{p.pricingProvisionalNote}</p>
              )}
              <a
                href="#book"
                class="mt-8 inline-flex items-center rounded-sm bg-yellow px-6 py-3 font-display text-sm font-semibold text-snow no-underline transition hover:bg-ink"
              >
                Reserve a place →
              </a>
            </>
          )}
        </article>
      ))}
    </div>
  </Section>

  <!-- What's included -->
  <Section kicker="What you get" title="On the mountain. Off it.">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="meta font-bold text-olive">{page?.onSnowLabel}</p>
        <ul class="mt-6 space-y-4">
          {(page?.onSnow ?? []).map((item) => (
            <li class="flex gap-3 border-b border-olive/10 pb-4 text-base leading-relaxed text-olive/80 md:text-lg">
              <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="meta font-bold text-olive">{page?.offSnowLabel}</p>
        <ul class="mt-6 space-y-4">
          {(page?.offSnow ?? []).map((item) => (
            <li class="flex gap-3 border-b border-olive/10 pb-4 text-base leading-relaxed text-olive/80 md:text-lg">
              <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Where you stay -->
  <Section kicker={page?.accommodationKicker} title={page?.accommodationTitle}>
    {page?.accommodationLead && (
      <p class="-mt-2 mb-10 max-w-3xl text-base leading-relaxed text-olive/75 md:text-lg">{page.accommodationLead}</p>
    )}

    {morzine && (
      <>
        <div class="mb-8 flex flex-wrap items-center gap-6">
          {morzine.accommodationLogo && (
            <img
              src={urlFor(morzine.accommodationLogo).width(200).url()}
              alt={`${morzine.accommodationHeadline ?? morzine.name} logo`}
              class="h-20 w-auto rounded-none md:h-24"
            />
          )}
          <div>
            <p class="meta font-bold text-olive">{morzine.name}</p>
            <h3 class="mt-1 font-display text-3xl font-bold tracking-tight md:text-4xl">{morzine.accommodationHeadline}</h3>
          </div>
        </div>

        {morzine.accommodationBody && (
          <p class="mb-8 max-w-3xl text-base leading-relaxed text-olive/80 md:text-lg">{morzine.accommodationBody}</p>
        )}

        <div class="grid items-start gap-6 sm:grid-cols-[minmax(0,18rem)_1fr] sm:gap-8">
          {morzine.accommodationImage && (
            <figure class="overflow-hidden rounded-none bg-brown">
              <img
                src={urlFor(morzine.accommodationImage).width(600).height(750).fit('crop').url()}
                alt={`Accommodation at ${morzine.accommodationHeadline ?? morzine.name}`}
                loading="lazy"
                class="h-full w-full object-cover aspect-[4/5]"
              />
            </figure>
          )}
          <ul class="space-y-3">
            {(morzine.usps ?? []).map((u) => (
              <li class="rounded-none border border-olive bg-cream p-5">
                <p class="meta font-bold text-olive">{u.label}</p>
                <p class="mt-2 text-base leading-relaxed text-olive/80">{u.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </>
    )}

    {page?.valAccommodationCard?.headline && (
      <div class="mt-16 rounded-none border border-olive bg-cream p-8 md:p-12">
        <p class="meta font-bold text-olive">{page.valAccommodationCard.kicker}</p>
        <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{page.valAccommodationCard.headline}</h3>
        {page.valAccommodationCard.body && (
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-olive/80 md:text-lg">{page.valAccommodationCard.body}</p>
        )}
      </div>
    )}
  </Section>

  <!-- Where you ski -->
  <Section kicker={page?.whereYouSkiKicker} title={page?.whereYouSkiTitle}>
    {page?.whereYouSkiLead && (
      <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">{page.whereYouSkiLead}</p>
    )}
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {resorts.map((r) => (
        <article class="rounded-none border border-olive bg-cream p-8">
          <p class="meta text-olive/50">{r.area}</p>
          <h3 class="mt-2 font-display text-2xl font-bold tracking-tight md:text-3xl">{r.name}</h3>
          {r.shortBlurb && <p class="mt-4 text-base leading-relaxed text-olive/80">{r.shortBlurb}</p>}
          <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-olive/10 pt-5">
            {(r.facts ?? []).map((f) => (
              <div>
                <dt class="meta text-olive/50">{f.label}</dt>
                <dd class="mt-1 font-display text-lg font-bold tracking-tight">{f.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </Section>

  <!-- What we cover -->
  <Section kicker={page?.whatWeCoverKicker} title={page?.whatWeCoverTitle}>
    <ol class="space-y-16">
      {(page?.whatWeCover ?? []).map((c, i) => (
        <li class="border-t border-olive/10 pt-10">
          <div class="grid gap-6 md:grid-cols-[5rem_1fr]">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-pink font-display text-xl font-bold tracking-tight text-snow">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-2xl font-bold tracking-tight md:text-4xl">{c.title}</h3>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-olive/80">{c.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- FAQs -->
  <Section kicker={page?.faqsKicker} title={page?.faqsTitle}>
    <div class="max-w-3xl">
      <dl class="divide-y divide-olive/10 border-y border-olive/10">
        {faqs.map((f) => (
          <div class="py-6">
            <dt class="font-display text-xl font-bold tracking-tight md:text-2xl">{f.q}</dt>
            <dd class="mt-3 text-base leading-relaxed text-olive/80 md:text-lg">{f.a}</dd>
          </div>
        ))}
      </dl>
      <p class="meta mt-10 text-olive/55">
        Still not sure?
        <a href="tel:+441483616522" class="underline-offset-4 hover:bg-yellow hover:text-snow hover:underline">+44 1483 616 522</a>
        or
        <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:text-snow hover:underline">drop us a line</a>.
      </p>
    </div>
  </Section>

  <!-- Ready to book -->
  <Section id="book" kicker={page?.bookKicker} title={page?.bookTitle}>
    <div class="rounded-none bg-brown p-8 text-salt md:p-12">
      {page?.bookLead && (
        <p class="text-lg leading-relaxed text-salt/85 md:text-xl">{page.bookLead}</p>
      )}
      <div class="mt-10 flex flex-wrap gap-3">
        {page?.bookPrimaryCta?.href && (
          <a
            href={page.bookPrimaryCta.href}
            class="inline-flex items-center rounded-sm bg-yellow px-8 py-4 font-display text-base font-semibold text-snow no-underline transition hover:bg-ink"
          >
            {page.bookPrimaryCta.label}
          </a>
        )}
        {page?.bookSecondaryCta?.href && (
          <a
            href={page.bookSecondaryCta.href}
            class="inline-flex items-center rounded-sm border border-salt/40 px-8 py-4 font-display text-base font-semibold no-underline transition hover:border-yellow hover:bg-yellow hover:text-snow"
          >
            {page.bookSecondaryCta.label}
          </a>
        )}
      </div>
      {page?.bookDisclaimer && (
        <p class="meta font-bold mt-6 text-salt">{page.bookDisclaimer}</p>
      )}
    </div>

    <SkiOperatorSecureEmbed
      title="Adult ski camps"
      keyEnv="SKI_OPERATOR_SKI_CAMPS"
      class="mt-12 overflow-hidden rounded-none border border-olive/10 bg-snow"
    />
    <p class="meta mt-6 text-olive/55">
      Booking delivered by SkiOperator. Trouble loading? <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:text-snow hover:underline">Get in touch</a> and we'll book you in directly.
    </p>
  </Section>
</BaseLayout>
