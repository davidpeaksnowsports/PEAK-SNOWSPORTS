---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Section from '../components/ui/Section.astro';

const levels = [
  {
    name: 'Intermediate',
    forWhom:
      "Comfortable on blues and easy reds controlling your speed with parallel turns. You're now ready to refine those parallel turns on steeper reds, changing snow, bumps and the edges of off-piste. Still in a snow-plough? Check out our improver camp.",
    outcome:
      'Build solid foundations, then push past the intermediate plateau.',
  },
  {
    name: 'Advanced',
    forWhom:
      "Confident on red and black runs. Refining performance, efficiency and control across off-piste, steeps, bumps and variable snow. Ideal if you've plateaued or already done an intermediate camp.",
    outcome:
      'Sharpen your skiing with precision and control in all-mountain conditions.',
  },
];

const lodging = ['Coaching only', 'Shared accommodation', 'Private accommodation'];

const onSnow = [
  'Five+ hours coaching per day, breaks when the group needs them',
  'Full resort lift pass',
  'Performance video analysis sessions',
  'Technical ski-system workshop',
  'Equipment check workshop',
  "The best lunch spots, found and tested",
];

const offSnow = [
  'Half-board accommodation in resort',
  'Breakfast and dinner using local ingredients',
  'Daily yoga after skiing',
  'Barista-style in-house coffee',
  'Hot tub and ice bath',
  'Team dinner at a traditional local restaurant',
];

const camps = [
  { start: 'Mon 14 Dec 2026', locations: ['Verbier', 'Avoriaz'], tag: null },
  { start: 'Mon 4 Jan 2027', locations: ['Avoriaz'], tag: null },
  { start: 'Mon 11 Jan 2027', locations: ['Avoriaz'], tag: 'New date' },
  { start: 'Mon 18 Jan 2027', locations: ['Avoriaz', "Val d'Isère"], tag: null },
  { start: 'Mon 1 Mar 2027', locations: ['Avoriaz'], tag: null },
  { start: 'Mon 15 Mar 2027', locations: ['Avoriaz'], tag: 'New date' },
  { start: 'Mon 22 Mar 2027', locations: ['Avoriaz', "Val d'Isère"], tag: null },
];

const pricing = [
  {
    location: 'Morzine-Avoriaz',
    accommodation: 'The Fat Fox Lodge, Montriond',
    tiers: [
      { name: 'Coaching only', price: 699 },
      { name: 'Shared accommodation', price: 1899 },
      { name: 'Private accommodation', price: 2494 },
    ],
  },
  {
    location: "Val d'Isère",
    accommodation: 'Accommodation provider being finalised',
    tiers: [
      { name: 'Coaching only', price: 799 },
      { name: 'Shared accommodation', price: 1959 },
      { name: 'Private accommodation', price: 2649 },
    ],
  },
  {
    location: 'Verbier',
    accommodation: 'Accommodation and pricing being scoped',
    tbc: true,
    tiers: [],
  },
];

const priceFmt = new Intl.NumberFormat('en-GB');

const lodgeTiles = [
  {
    label: 'Food',
    body: 'Served around a big shared table in the Haberdashery, the central hub of the lodge.',
  },
  {
    label: 'Rooms',
    body: 'Twin or queen, all four with private bathrooms across the landing. Big windows over the Montriond forest.',
  },
  {
    label: 'Hosts',
    body: "Tess and Joe, snow-lovers who've roamed the globe and landed in Morzine.",
  },
];

const resorts = [
  {
    name: 'Morzine-Avoriaz',
    area: 'Portes du Soleil',
    body: "Europe's largest cross-border ski area — 600+ km linked, with Avoriaz at 1,800 m as your home mountain. Huge mix of pistes, off-piste and tree-skiing.",
    facts: [
      { label: 'Pistes', value: '291' },
      { label: 'From Geneva', value: '1.5 hr' },
    ],
  },
  {
    name: 'Verbier',
    area: 'Four Valleys',
    body: "Switzerland's flagship freeride mountain. Big terrain, big lines, legendary off-piste. Resort altitude 1,500 m, top lift 3,330 m.",
    facts: [
      { label: 'Pistes', value: '410+ km' },
      { label: 'From Geneva', value: '2 hr' },
    ],
  },
  {
    name: "Val d'Isère",
    area: 'Espace Killy',
    body: 'High-altitude snow-sure terrain linked with Tignes. Long descents, classic Alpine resort, world-class coaching ground at 1,850 m.',
    facts: [
      { label: 'Pistes', value: '300 km' },
      { label: 'From Geneva', value: '2.5 hr' },
    ],
  },
];

const content = [
  {
    title: 'Eight building blocks',
    body: 'The six essentials behind every good skier. Master the basics that let everything else click into place.',
  },
  {
    title: 'Ski fit',
    body: "Top tips for getting fit before the camp. What gym work transfers to snow, and what doesn't.",
  },
  {
    title: 'Performance analysis',
    body: 'Video review on every camp. Set benchmarks, fix the right things, see your motor skills improve fast.',
  },
  {
    title: 'Terrain',
    body: 'How to adjust the building blocks for piste, bumps, off-piste and steeps. Different ground, same fundamentals.',
  },
];

const faqs = [
  {
    q: 'What if the weather turns?',
    a: "We only stop skiing if the mountain is officially closed.",
  },
  {
    q: 'Cancellation policy?',
    a: 'Refunds on a sliding scale depending on the notice you give us. Full details in our terms and conditions.',
  },
  {
    q: "What if a camp doesn't get confirmed?",
    a: "In the unlikely event that we don't hit minimum numbers, we convert your booked coaching hours into private lessons of the same value across the same week. You still ski with us, you still get coached — just in a different format.",
  },
  {
    q: 'Equipment rental?',
    a: 'We work with local hire partners and can sort you a discount. Email us before you arrive.',
  },
  {
    q: 'Insurance?',
    a: 'Yes, make sure yours covers winter sports, and skiing into Switzerland (the Portes du Soleil crosses the border).',
  },
  {
    q: 'What if I turn out not to be the right level?',
    a: "We'll move you into another group, or offer the equivalent in private lessons, subject to availability.",
  },
  {
    q: 'How big are the groups?',
    a: '8 skiers max per group. We often run multiple groups, so we can move skiers around to the right level on day one. Half-board is limited to the first 8 bookings, after that, self-accommodate.',
  },
  {
    q: 'Where do we meet?',
    a: "Meeting points are resort-specific. If you book accommodation, you travel with the group each morning. If you self-accommodate, we send full meeting-point instructions with your booking confirmation.",
  },
  {
    q: 'When should I arrive?',
    a: 'Arrival to resort is the Sunday before camp starts. Camps run Monday to Friday. If you book accommodation, check-out is the Saturday after camp finishes.',
  },
  {
    q: 'Is the lift pass included?',
    a: "Yes, full lift pass for the resort area you're skiing in.",
  },
  {
    q: 'Who actually teaches?',
    a: 'Current, fully-qualified BASI instructors. The same coaches who run our performance courses and instructor exams.',
  },
];
---

<BaseLayout
  title="Adult ski camps · Morzine-Avoriaz, Verbier & Val d'Isère · Peak Snowsports"
  description="Five-day small-group ski camps in Morzine-Avoriaz, Verbier and Val d'Isère for intermediate and advanced skiers. Coached by BASI L4 ISTD and Trainers. 8 max per group. From €699 coaching only."
  image="/images/og/ski-camps.jpg"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: "Peak Snowsports Adult Ski Camps · Morzine-Avoriaz, Verbier & Val d'Isère",
      description: "Five-day small-group adult ski camps for intermediate and advanced skiers across Morzine-Avoriaz, Verbier and Val d'Isère. Eight max per group, coached by BASI Level 4 ISTD and Trainers.",
      brand: { '@type': 'Organization', name: 'Peak Snowsports' },
      image: 'https://peaksnowsports.com/images/og/ski-camps.jpg',
      category: 'Adult ski performance camp',
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        lowPrice: 699,
        highPrice: 2649,
        availability: 'https://schema.org/InStock',
        url: 'https://peaksnowsports.com/ski-camps#book',
        offerCount: 6,
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Hero
    kicker="Adult ski camps · Morzine-Avoriaz · Verbier · Val d'Isère"
    headline="Five days on snow. One serious step up."
    sub="Small-group ski camps for intermediate and advanced skiers across three resorts. Coached by BASI Level 4 ISTD and BASI Trainers. Half-board accommodation, or coaching only."
    primaryCta={{ href: '#dates', label: 'See dates & pricing' }}
    secondaryCta={{ href: '#book', label: 'Reserve your place' }}
    variant="full"
    video="/videos/carving.mp4"
    videoPoster="/videos/carving-poster.jpg"
    imageAlt="A skier carving an arc through soft snow above Avoriaz."
  />

  <!-- Welcome / overview -->
  <Section kicker="Welcome" title="Five days. Eight skiers. One real step up.">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_minmax(0,460px)] lg:gap-20">
      <div class="space-y-10">
        <p class="text-xl font-medium leading-snug text-olive md:text-2xl">
          Coached by the people who train other instructors. Eight skiers max per group. We meet you at the level you're at and take you to the one you want.
        </p>

        <dl class="grid gap-x-6 gap-y-6 border-y border-olive/10 py-6 sm:grid-cols-3">
          <div>
            <dt class="meta text-olive/50">On snow</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">5 days</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Group size</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">8 max</dd>
          </div>
          <div>
            <dt class="meta text-olive/50">Coaches</dt>
            <dd class="mt-1 font-display text-2xl font-bold tracking-tight">BASI L4 / Trainers</dd>
          </div>
        </dl>

        <div class="space-y-5 text-base leading-relaxed text-olive/75 md:text-lg">
          <p>
            Seven camps across the 2026/27 season in Morzine-Avoriaz, Verbier and Val d'Isère. Two levels: intermediate (stuck on blues and easy reds, ready to step up) and advanced (confident on red and black, want to refine).
          </p>
          <p>
            Half-board accommodation in resort: shared dinners, decent coffee, a hot tub, daily yoga, and a team that knows the area. Coaching only is also an option if you've already got somewhere to stay.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Camp dates</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">7 camps · Dec 2026 – Mar 2027</p>
          <p class="mt-1 text-sm text-olive/70">Full schedule and pricing below.</p>
        </div>
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Pricing from</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">€699 coaching only</p>
          <p class="mt-1 text-sm text-olive/70">Shared and private accommodation packages available.</p>
        </div>
        <div class="rounded-3xl border border-olive bg-cream p-6">
          <p class="meta text-olive">Arrival</p>
          <p class="mt-2 font-display text-xl font-bold tracking-tight">Day before · Sunday</p>
          <p class="mt-1 text-sm text-olive/70">If you book accommodation, check-out is the Saturday after camp.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Photo gallery -->
  <div class="mx-auto max-w-screen-2xl px-6 pb-16 md:pb-24">
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      <div class="col-span-2 overflow-hidden rounded-3xl md:col-span-1">
        <img
          src="/images/ski-camps/camp-instructor.jpg"
          alt="Peak Snowsports instructor on the mountain above Avoriaz"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
      <div class="overflow-hidden rounded-3xl">
        <img
          src="/images/ski-camps/camp-lunch.jpg"
          alt="Camp group lunch at a mountain restaurant in the Portes du Soleil"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
      <div class="overflow-hidden rounded-3xl">
        <img
          src="/images/ski-camps/camp-group.jpg"
          alt="Ski camp group session on the slopes above Avoriaz"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/3] md:aspect-auto md:h-80"
        />
      </div>
    </div>
  </div>

  <!-- Pick your level -->
  <Section id="camps" kicker="Two levels" title="Pick your level.">
    <div class="grid gap-6 md:grid-cols-2">
      {levels.map((l) => (
        <article class="rounded-3xl border border-olive bg-cream p-8 md:p-10">
          <p class="meta text-olive/50">Ski camp</p>
          <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{l.name}</h3>
          <p class="mt-5 text-base leading-relaxed text-olive/80 md:text-lg">{l.forWhom}</p>
          <p class="mt-4 text-base leading-relaxed text-olive/65 md:text-lg">{l.outcome}</p>

          <p class="meta mt-8 text-olive/50">Three ways to join</p>
          <ul class="mt-3 space-y-2">
            {lodging.map((opt) => (
              <li class="flex items-center gap-3 text-sm text-olive md:text-base">
                <span aria-hidden="true" class="text-olive/40">·</span>
                <span>{opt}</span>
              </li>
            ))}
          </ul>

          <a
            href="#book"
            class="mt-8 inline-flex items-center rounded-full bg-yellow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive-deep no-underline transition hover:bg-salt"
          >
            Check availability →
          </a>
        </article>
      ))}
    </div>
  </Section>

  <!-- Camp dates -->
  <Section id="dates" kicker="2026/27 season" title="Dates and locations.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Seven five-day camps across the season. Arrival to resort is the day before camp starts (Sunday). If you book accommodation, check-out is the Saturday after camp finishes.
    </p>
    <ul class="mt-12 divide-y divide-olive/10 border-y border-olive/10">
      {camps.map((c) => (
        <li class="grid gap-3 py-5 sm:grid-cols-[minmax(0,11rem)_1fr_auto] sm:items-center sm:gap-6">
          <p class="font-display text-lg font-bold tracking-tight md:text-xl">{c.start}</p>
          <p class="text-base leading-snug text-olive/80 md:text-lg">{c.locations.join(' · ')}</p>
          {c.tag ? (
            <span class="meta inline-flex w-fit items-center rounded-full bg-yellow px-3 py-1 text-olive-deep">{c.tag}</span>
          ) : (
            <span class="sm:block" aria-hidden="true" />
          )}
        </li>
      ))}
    </ul>
    <p class="meta mt-8 text-olive/55">All camps run Monday to Friday. We confirm each camp 6 weeks before it starts.</p>

    <div class="mt-10 rounded-3xl border border-olive bg-cream p-6 md:p-8">
      <p class="meta font-bold text-olive">If a camp doesn't run</p>
      <p class="mt-3 text-base leading-relaxed text-olive/80 md:text-lg">
        Each camp goes ahead once we hit minimum numbers — we confirm as soon as we do. In the unlikely event that a camp doesn't get confirmed, we convert your booked coaching hours into private lessons of the same value across the same week, so you still ski and we still coach.
      </p>
    </div>
  </Section>

  <!-- Pricing -->
  <Section id="pricing" kicker="Pricing" title="Pick your camp. Pick your package.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Prices per person, in euros, for the full five-day camp. Accommodation packages include half-board, with arrival the Sunday before and check-out the Saturday after.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pricing.map((p) => (
        <article class="rounded-3xl border border-olive bg-cream p-8 md:p-10">
          <p class="meta font-bold text-olive">{p.accommodation}</p>
          <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">{p.location}</h3>
          {p.tbc ? (
            <>
              <p class="mt-8 font-display text-2xl font-bold tracking-tight md:text-3xl">Pricing TBC</p>
              <p class="mt-3 text-base leading-relaxed text-olive/75 md:text-lg">
                Our 14 Dec Verbier camp is being finalised. Get in touch and we'll share the latest on coaching rates, accommodation options and availability.
              </p>
              <a
                href="/contact"
                class="mt-8 inline-flex items-center rounded-full bg-yellow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive-deep no-underline transition hover:bg-salt"
              >
                Enquire →
              </a>
            </>
          ) : (
            <>
              <dl class="mt-8 divide-y divide-olive/10 border-y border-olive/10">
                {p.tiers.map((t) => (
                  <div class="flex items-baseline justify-between gap-6 py-4">
                    <dt class="text-base text-olive/80 md:text-lg">{t.name}</dt>
                    <dd class="font-display text-2xl font-bold tracking-tight md:text-3xl">€{priceFmt.format(t.price)}</dd>
                  </div>
                ))}
              </dl>
              <a
                href="#book"
                class="mt-8 inline-flex items-center rounded-full bg-yellow px-6 py-3 font-display text-sm font-bold uppercase tracking-tight text-olive-deep no-underline transition hover:bg-salt"
              >
                Reserve a place →
              </a>
            </>
          )}
        </article>
      ))}
    </div>
  </Section>

  <!-- What's included -->
  <Section kicker="What you get" title="On the mountain. Off it.">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <p class="meta font-bold text-olive">On snow</p>
        <ul class="mt-6 space-y-4">
          {onSnow.map((item) => (
            <li class="flex gap-3 border-b border-olive/10 pb-4 text-base leading-relaxed text-olive/80 md:text-lg">
              <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="meta font-bold text-olive">Off snow (accommodation packages)</p>
        <ul class="mt-6 space-y-4">
          {offSnow.map((item) => (
            <li class="flex gap-3 border-b border-olive/10 pb-4 text-base leading-relaxed text-olive/80 md:text-lg">
              <span aria-hidden="true" class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-yellow" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Where you stay -->
  <Section kicker="Where you stay" title="Half-board accommodation by location.">
    <p class="-mt-2 mb-10 max-w-3xl text-base leading-relaxed text-olive/75 md:text-lg">
      Morzine-Avoriaz camps stay at The Fat Fox Lodge in Montriond. Val d'Isère accommodation is being finalised and will match the same standard. Coaching-only is available everywhere if you've got your own place sorted.
    </p>

    <!-- Morzine-Avoriaz · The Fat Fox Lodge -->
    <div class="mb-8 flex flex-wrap items-center gap-6">
      <img
        src="/images/fat-fox-lodge/logo.webp"
        alt="The Fat Fox Lodge"
        class="h-20 w-auto rounded-2xl md:h-24"
      />
      <div>
        <p class="meta font-bold text-olive">Morzine-Avoriaz</p>
        <h3 class="mt-1 font-display text-3xl font-bold tracking-tight md:text-4xl">The Fat Fox Lodge, Montriond.</h3>
      </div>
    </div>

    <p class="mb-8 max-w-3xl text-base leading-relaxed text-olive/80 md:text-lg">
      Tess and Joe built The Fat Fox Lodge for people who actually live the mountains. Nutritious food, a vibrant shared space, twin and queen rooms with private bathrooms, big windows over the Montriond forest. Natural, local, resourceful.
    </p>

    <div class="grid items-start gap-6 sm:grid-cols-[minmax(0,18rem)_1fr] sm:gap-8">
      <figure class="overflow-hidden rounded-3xl bg-brown">
        <img
          src="/images/fat-fox-lodge/living.webp"
          alt="The Haberdashery communal lounge at The Fat Fox Lodge"
          loading="lazy"
          class="h-full w-full object-cover aspect-[4/5]"
        />
      </figure>
      <ul class="space-y-3">
        {lodgeTiles.map((t) => (
          <li class="rounded-3xl border border-olive bg-cream p-5">
            <p class="meta font-bold text-olive">{t.label}</p>
            <p class="mt-2 text-base leading-relaxed text-olive/80">{t.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Val d'Isère -->
    <div class="mt-16 rounded-3xl border border-olive bg-cream p-8 md:p-12">
      <p class="meta font-bold text-olive">Val d'Isère</p>
      <h3 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">Accommodation, in line with The Fat Fox Lodge.</h3>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-olive/80 md:text-lg">
        We're finalising our Val d'Isère accommodation partner for the 2026/27 season. The standard will match The Fat Fox Lodge: half-board, shared dinners, decent coffee, and a place you'll be glad to come back to after a hard day on the hill. Drop us a line if you want the latest update before booking.
      </p>
    </div>
  </Section>

  <!-- Where you ski -->
  <Section kicker="Where you ski" title="Three resorts. One standard.">
    <p class="max-w-3xl text-lg leading-relaxed text-olive/80 md:text-xl">
      Pick the mountain that suits the camp you're after. Same coaching team, same group sizes, same five-day structure across all three.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {resorts.map((r) => (
        <article class="rounded-3xl border border-olive bg-cream p-8">
          <p class="meta text-olive/50">{r.area}</p>
          <h3 class="mt-2 font-display text-2xl font-bold tracking-tight md:text-3xl">{r.name}</h3>
          <p class="mt-4 text-base leading-relaxed text-olive/80">{r.body}</p>
          <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-olive/10 pt-5">
            {r.facts.map((f) => (
              <div>
                <dt class="meta text-olive/50">{f.label}</dt>
                <dd class="mt-1 font-display text-lg font-bold tracking-tight">{f.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </Section>

  <!-- What we cover -->
  <Section kicker="Camp content" title="What we'll cover.">
    <ol class="space-y-16">
      {content.map((c, i) => (
        <li class="border-t border-olive/10 pt-10">
          <div class="grid gap-6 md:grid-cols-[5rem_1fr]">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-pink font-display text-xl font-bold tracking-tight text-snow">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-2xl font-bold tracking-tight md:text-4xl">{c.title}</h3>
              <p class="mt-4 max-w-2xl text-lg leading-relaxed text-olive/80">{c.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <!-- FAQs -->
  <Section kicker="FAQs" title="The usual questions.">
    <div class="max-w-3xl">
      <dl class="divide-y divide-olive/10 border-y border-olive/10">
        {faqs.map((f) => (
          <div class="py-6">
