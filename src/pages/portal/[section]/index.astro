---
/**
 * Index for one portal section. Server-rendered, so no getStaticPaths — the
 * section is validated against the known list and anything else 404s.
 *
 * Static sibling routes (/portal/login, /portal/logout…) take precedence over
 * this dynamic one in Astro's route ordering, and the whitelist below is the
 * second line of defence.
 */
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import { filesForSection } from '../../../lib/portal/files';
import {
  KNOWLEDGE_CATEGORIES,
  SECTIONS,
  listDocs,
  isContentConfigured,
  type PortalSection,
} from '../../../lib/portal/content';
import { visibleTiers, type PortalUser } from '../../../lib/portal/supabase';

const user = Astro.locals.portalUser as PortalUser;
const key = Astro.params.section as PortalSection;

// The site has no /404 route, so rewriting to one would be a guess. Set the
// status and render a real page instead — the reader gets somewhere to go, and
// crawlers and monitoring still see a 404.
const section = SECTIONS.find((s) => s.key === key);
if (!section) Astro.response.status = 404;

const tiers = visibleTiers(user.role);
const docs = section ? await listDocs(tiers, key) : [];
const files = section ? filesForSection(key) : [];

// The knowledge hub groups by category; every other section is a flat list.
// Anything without a category still shows, under a heading of its own, so a
// new document is never invisible because nobody set the field.
const grouped =
  key === 'knowledge'
    ? [
        ...KNOWLEDGE_CATEGORIES.map((c) => ({
          label: c.label,
          blurb: c.blurb,
          docs: docs.filter((d) => d.knowledgeCategory === c.key),
        })),
        {
          label: 'Everything else',
          blurb: '',
          docs: docs.filter(
            (d) => !KNOWLEDGE_CATEGORIES.some((c) => c.key === d.knowledgeCategory),
          ),
        },
      ].filter((g) => g.docs.length > 0)
    : null;

/** Only tier 1 gets a badge. Tier 3 never reaches this page. */
const tierLabel = (tier: number) => (tier === 1 ? 'Versioned' : null);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

{
  !section ? (
    <PortalLayout
      title="Not found"
      heading="Not found"
      intro="That section does not exist. It may have been renamed."
    >
      <a href="/portal" class="text-accent">Back to the hub</a>
    </PortalLayout>
  ) : (
<PortalLayout title={section.label} kicker="Peak Snowsports" heading={section.label} intro={section.blurb}>
  {
    key === 'ops' && (
      <section aria-labelledby="accidents-heading" class="mb-16 border-b border-ink/10 pb-10">
        <h2 id="accidents-heading" class="font-display text-2xl font-bold">Accidents</h2>
        <p class="mt-2 max-w-2xl text-ink-70">
          File a report the same day, while you still remember the detail. It is
          what protects you if an accident later turns into a claim.
        </p>
        <p class="mt-5 flex flex-wrap gap-3">
          <a href="/portal/ops/report"
            class="inline-block bg-accent px-5 py-3 font-display font-bold text-paper no-underline transition-colors hover:bg-ink hover:no-underline">
            File an accident report
          </a>
          <a href="/portal/ops/reports"
            class="inline-block border border-ink/20 px-5 py-3 font-display font-bold text-ink no-underline transition-colors hover:border-ink hover:no-underline">
            Read filed reports
          </a>
        </p>
      </section>
    )
  }

  {
    files.length > 0 && (
      <section aria-labelledby="downloads-heading" class="mb-16 border-b border-ink/10 pb-10">
        <h2 id="downloads-heading" class="font-display text-2xl font-bold">Downloads</h2>
        <ul class="mt-5 divide-y divide-ink/10 border-t border-ink/10">
          {files.map((f) => (
            <li class="flex flex-col gap-2 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <span class="flex-1">
                <span class="font-display text-lg font-bold text-ink">{f.title}</span>
                <span class="mt-1 block max-w-2xl text-sm leading-relaxed text-ink-70">
                  {f.description}
                </span>
              </span>
              <a href={`/portal/file/${f.slug}`}
                class="meta shrink-0 border border-ink/20 px-4 py-3 text-ink no-underline transition-colors hover:border-ink hover:no-underline">
                Download
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    docs.length === 0 ? (
      <div class="border-l-2 border-ink/20 bg-paper-2 p-6">
        <p class="text-ink-70">
          {isContentConfigured
            ? 'Nothing has been published to this section yet.'
            : 'The document store is not connected yet, so every section is empty.'}
        </p>
      </div>
    ) : grouped ? (
      grouped.map((group) => (
        <section class="mb-12">
          <h2 class="font-display text-2xl font-bold">{group.label}</h2>
          {group.blurb && <p class="mt-1 text-ink-70">{group.blurb}</p>}
          <ul class="mt-4 border-t border-ink">
            {group.docs.map((doc) => (
              <li class="border-b border-ink/10">
                <a
                  href={`/portal/${doc.section}/${doc.slug}`}
                  class="group flex flex-col gap-1 py-5 no-underline hover:no-underline sm:flex-row sm:items-baseline sm:gap-6"
                >
                  <span class="flex-1">
                    <span class="font-display text-lg font-bold text-ink group-hover:text-accent">
                      {doc.title}
                    </span>
                    {doc.summary && (
                      <span class="mt-1 block max-w-2xl text-sm leading-relaxed text-ink-70">
                        {doc.summary}
                      </span>
                    )}
                  </span>
                  <span class="meta flex shrink-0 items-center gap-3 text-ink-45">
                    {tierLabel(doc.tier) && (
                      <span class="border border-ink/20 px-2 py-1">{tierLabel(doc.tier)}</span>
                    )}
                    {doc.updatedAt && <span>{dateFmt.format(new Date(doc.updatedAt))}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <ul class="border-t border-ink/10">
        {docs.map((doc) => (
          <li class="border-b border-ink/10">
            <a
              href={`/portal/${doc.section}/${doc.slug}`}
              class="group flex flex-col gap-1 py-5 no-underline hover:no-underline sm:flex-row sm:items-baseline sm:gap-6"
            >
              <span class="flex-1">
                <span class="font-display text-lg font-bold text-ink group-hover:text-accent">
                  {doc.title}
                </span>
                {doc.summary && (
                  <span class="mt-1 block max-w-2xl text-sm leading-relaxed text-ink-70">
                    {doc.summary}
                  </span>
                )}
              </span>

              <span class="meta flex shrink-0 items-center gap-3 text-ink-45">
                {tierLabel(doc.tier) && (
                  <span class="border border-ink/20 px-2 py-1">
                    {tierLabel(doc.tier)}
                  </span>
                )}
                {doc.updatedAt && (
                  <span>{dateFmt.format(new Date(doc.updatedAt))}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</PortalLayout>
  )
}
