---
/**
 * Landing page for the reset link in the email.
 *
 * Supabase sends the user here with a one-time `code`. Exchanging it creates a
 * short-lived session, which is what authorises the password change — so the
 * exchange has to happen before the form is shown, and the form itself just
 * calls updateUser against that session.
 */
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { createPortalClient, isPortalConfigured } from '../../lib/portal/supabase';

const MIN_LENGTH = 10;

let error: string | null = null;
let ready = false;

if (isPortalConfigured) {
  const supabase = createPortalClient(Astro.cookies, Astro.request);

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const password = String(form.get('password') ?? '');
    const confirm = String(form.get('confirm') ?? '');

    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (!user) {
      // No session means the exchanged link has lapsed. Hide the form — there
      // is nothing they can do here but start again.
      error =
        'That link has expired. Request a new one and use it within the hour.';
    } else if (password.length < MIN_LENGTH) {
      error = `Use at least ${MIN_LENGTH} characters.`;
      ready = true;
    } else if (password !== confirm) {
      error = 'The two passwords do not match.';
      ready = true;
    } else {
      const { error: updateError } = await supabase.auth.updateUser({ password });
      if (updateError) {
        error = updateError.message;
        ready = true;
      } else {
        return Astro.redirect('/portal', 303);
      }
    }
  } else {
    // Supabase surfaces its own failures as query params rather than an error
    // status, so a bad or reused link arrives looking like a normal request.
    const linkError = Astro.url.searchParams.get('error_description');
    const code = Astro.url.searchParams.get('code');

    if (linkError) {
      error = 'That link has expired or has already been used.';
    } else if (code) {
      const { error: exchangeError } =
        await supabase.auth.exchangeCodeForSession(code);
      if (exchangeError) {
        error = 'That link has expired or has already been used.';
      } else {
        ready = true;
      }
    } else {
      // Already holding a valid session — e.g. a refresh after the exchange.
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (user) ready = true;
      else error = 'Open the link from your reset email to set a new password.';
    }
  }
}
---

<PortalLayout title="Set a new password" chrome={false}>
  <div class="mx-auto max-w-md py-8">
    <p class="meta mb-3 text-ink-45">Peak Snowsports</p>
    <h1 class="font-display text-4xl font-bold">Set a new password</h1>

    {
      error && (
        <p
          role="alert"
          class="mt-6 border-l-2 border-accent bg-paper-2 px-4 py-3 text-ink"
        >
          {error}
        </p>
      )
    }

    {
      ready && (
        <form method="POST" class="mt-8 space-y-5">
          <div>
            <label for="password" class="meta mb-2 block text-ink-70">
              New password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength={MIN_LENGTH}
              required
              class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
            />
            <p class="mt-2 text-sm text-ink-45">
              At least {MIN_LENGTH} characters.
            </p>
          </div>

          <div>
            <label for="confirm" class="meta mb-2 block text-ink-70">
              Again, to be sure
            </label>
            <input
              id="confirm"
              name="confirm"
              type="password"
              autocomplete="new-password"
              minlength={MIN_LENGTH}
              required
              class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-accent px-6 py-3 font-display font-bold text-paper transition-colors hover:bg-ink"
          >
            Save and sign in
          </button>
        </form>
      )
    }

    {
      !ready && (
        <p class="mt-8">
          <a href="/portal/forgot-password" class="text-accent">
            Request a new link
          </a>
        </p>
      )
    }
  </div>
</PortalLayout>
