---
/**
 * Request a password reset link.
 *
 * Seasonal teams forget passwords between winters, so this is self-service:
 * Supabase sends the email, the link lands on /portal/reset-password. No
 * office involvement, which is the whole point.
 */
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { createPortalClient, isPortalConfigured } from '../../lib/portal/supabase';

let sent = false;
let error: string | null = null;
let email = '';

if (Astro.request.method === 'POST' && isPortalConfigured) {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();

  if (!email) {
    error = 'Enter the email address we hold for you.';
  } else {
    const supabase = createPortalClient(Astro.cookies, Astro.request);
    await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/portal/reset-password', Astro.url.origin).toString(),
    });
    // Always report success, even for an address with no account. Confirming
    // which emails are registered is exactly the leak this page invites.
    sent = true;
  }
}
---

<PortalLayout title="Reset your password" chrome={false}>
  <div class="mx-auto max-w-md py-8">
    <p class="meta mb-3 text-ink-45">Peak Snowsports</p>
    <h1 class="font-display text-4xl font-bold">Reset your password</h1>

    {
      sent ? (
        <div class="mt-8 border-l-2 border-accent bg-paper-2 p-5">
          <p class="text-ink">
            If we hold an account for <strong>{email}</strong>, a reset link is on
            its way. It expires in an hour.
          </p>
          <p class="mt-4 text-sm text-ink-70">
            Nothing arrived? Check spam, then ask the office — the address we
            hold for you may be a different one.
          </p>
        </div>
      ) : (
        <>
          <p class="mt-4 text-ink-70">
            We will email you a link to set a new one.
          </p>

          {error && (
            <p
              role="alert"
              class="mt-6 border-l-2 border-accent bg-paper-2 px-4 py-3 text-ink"
            >
              {error}
            </p>
          )}

          <form method="POST" class="mt-8 space-y-5">
            <div>
              <label for="email" class="meta mb-2 block text-ink-70">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                value={email}
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              />
            </div>

            <button
              type="submit"
              class="w-full bg-accent px-6 py-3 font-display font-bold text-paper transition-colors hover:bg-ink"
            >
              Send the link
            </button>
          </form>
        </>
      )
    }

    <p class="mt-12 border-t border-ink/10 pt-6 text-sm">
      <a href="/portal/login" class="text-accent">Back to sign in</a>
    </p>
  </div>
</PortalLayout>
