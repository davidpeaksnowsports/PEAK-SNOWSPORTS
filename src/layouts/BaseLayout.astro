---
import '../styles/global.css';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/nav/Footer.astro';
import ConsentBanner from '../components/analytics/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL for the page's Open Graph / Twitter image. Defaults to /images/og/default.jpg */
  image?: string;
  /** og:type — "website" for most pages, "article" for journal posts, "profile" for instructors */
  type?: 'website' | 'article' | 'profile';
  /** Override the canonical URL. Defaults to Astro.url against site. */
  canonical?: string;
  /** If true, emits <meta name="robots" content="noindex, follow"> — used on holding pages like /book */
  noindex?: boolean;
  /** Optional JSON-LD objects to inject in <head> (in addition to the sitewide Organization + WebSite blocks). */
  jsonLd?: object | object[];
}

const {
  title = 'Peak Snowsports · Ski school in Morzine, Avoriaz, Châtel & Les Gets',
  description = "Premium ski lessons across the Portes du Soleil. Private lessons, kids' groups, adult ski camps and the BASI GAP Course. Real coaches. Real names.",
  image = '/images/og/default.jpg',
  type = 'website',
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;

const SITE_URL = 'https://www.peaksnowsports.com';
const SITE_NAME = 'Peak Snowsports';

// Analytics: Plausible loads only when PUBLIC_PLAUSIBLE_DOMAIN is set (in
// Vercel env). Custom events are fired two ways: declaratively via
// data-analytics-event attributes (click-tracked sitewide by the delegation
// script below), and imperatively via window.plausible(...) from component
// scripts (e.g. enquiry-form success).
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
// Retargeting pixels are consent-gated: the banner + pixels render only when at
// least one ID is configured. Plausible (above) is cookieless and runs always.
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const hasMarketingPixels = Boolean(metaPixelId || googleAdsId);

// Canonical must point at the final, non-redirecting URL: www host, no
// trailing slash (the live site serves /gap-course, not /gap-course/). Strip
// any trailing slash from the pathname, keeping "/" for the root.
const canonicalPath = canonical ?? (Astro.url.pathname.replace(/\/+$/, '') || '/');
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();

const ogImage = image.startsWith('http') ? image : new URL(image, SITE_URL).toString();

// Sitewide JSON-LD: Organization + WebSite (with SearchAction).
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'SportsActivityLocation', 'LocalBusiness'],
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  alternateName: 'Peak Snowsports Ski School',
  url: SITE_URL,
  logo: `${SITE_URL}/images/logos/peak-menu-logo.png`,
  description:
    "Premium British-run ski school operating across Morzine, Avoriaz, Châtel and Les Gets in the Portes du Soleil. 20,000+ clients, 25+ instructors.",
  email: 'hello@peaksnowsports.com',
  telephone: '+44-1483-616522',
  areaServed: [
    { '@type': 'Place', name: 'Morzine, France' },
    { '@type': 'Place', name: 'Avoriaz, France' },
    { '@type': 'Place', name: 'Châtel, France' },
    { '@type': 'Place', name: 'Les Gets, France' },
    { '@type': 'Place', name: 'Portes du Soleil' },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Morzine',
    addressRegion: 'Haute-Savoie',
    addressCountry: 'FR',
  },
  sameAs: [
    'https://instagram.com/peaksnowsports',
    'https://www.youtube.com/@peaksnowsports9355',
  ],
  award: ["Tripadvisor Travellers' Choice 2026"],
  memberOf: {
    '@type': 'Organization',
    name: 'British Association of Snowsport Instructors',
    alternateName: 'BASI',
    url: 'https://www.basi.org.uk/',
  },
  knowsLanguage: ['en', 'fr'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: SITE_NAME,
  description:
    "Peak Snowsports — premium British-run ski school in Morzine, Avoriaz, Châtel and Les Gets. Private lessons, kids' groups, adult ski camps and the BASI GAP Course.",
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: ['en', 'fr'],
};

const pageJsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const allJsonLd = [orgJsonLd, websiteJsonLd, ...pageJsonLdArray];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Source+Sans+Pro:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD structured data -->
    {allJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Plausible (v2): cookieless, CNIL-exempt, runs without consent. The site
         id is baked into the hashed script URL, so PUBLIC_PLAUSIBLE_DOMAIN is
         just the on-switch — set it in Vercel Production so local/preview
         traffic stays out of the stats. The init stub also queues any
         window.plausible(...) custom events (peakTrack) until the script loads. -->
    {plausibleDomain && (
      <>
        <script async src="https://plausible.io/js/pa-DsSRPMC-4S6Z60WtE5d95.js"></script>
        <script is:inline>
          window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
          plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
          plausible.init();
        </script>
      </>
    )}

    <!-- Unified event dispatch: fan each goal out to whichever sinks are loaded.
         Plausible is always-on; fbq/gtag only exist after marketing consent. -->
    <script is:inline>
      // Map our goal names onto Meta standard events for better ad optimisation.
      var PEAK_META_STD = { 'Enquiry': 'Lead', 'Deposit Click': 'InitiateCheckout', 'Book Standard': 'InitiateCheckout', 'Book Upgraded': 'InitiateCheckout' };
      window.peakTrack = function (name, props) {
        try { if (window.plausible) window.plausible(name, props ? { props: props } : undefined); } catch (_) {}
        try {
          if (window.fbq) {
            var std = PEAK_META_STD[name];
            if (std) window.fbq('track', std, props || {});
            else window.fbq('trackCustom', name, props || {});
          }
        } catch (_) {}
        try { if (window.gtag) window.gtag('event', name, props || {}); } catch (_) {}
      };
      // Delegate clicks on [data-analytics-event] to a goal, with optional JSON
      // props in data-analytics-props.
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-analytics-event]');
        if (!el) return;
        var props;
        try { props = JSON.parse(el.getAttribute('data-analytics-props') || 'null'); } catch (_) { props = null; }
        window.peakTrack(el.getAttribute('data-analytics-event'), props);
      }, true);
    </script>
  </head>
  <body class="bg-snow font-sans text-olive">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    {hasMarketingPixels && <ConsentBanner metaPixelId={metaPixelId} googleAdsId={googleAdsId} />}
  </body>
</html>
