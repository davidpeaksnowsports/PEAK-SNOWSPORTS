---
import BaseLayout from './BaseLayout.astro';
import { urlFor } from '../lib/sanity';

type ImageRef = { asset?: { _ref?: string } } & Record<string, unknown>;

interface Props {
  title: string;
  /** Optional SEO-tuned title; falls back to display title */
  seoTitle?: string;
  description?: string;
  category?: string;
  author?: string;
  /** ISO date string for structured data */
  publishedAt?: Date | string;
  /** Human-readable date for display */
  date?: string;
  // Either a Sanity image ref (preferred) or a path under /public.
  hero?: ImageRef | string;
  heroAlt?: string;
  readingMinutes?: number;
  /** Permalink slug used in canonical + breadcrumbs */
  slug?: string;
}

const {
  title,
  seoTitle,
  description,
  category,
  author,
  publishedAt,
  date,
  hero,
  heroAlt = '',
  readingMinutes,
  slug,
} = Astro.props;

const SITE = 'https://www.peaksnowsports.com';
const pageTitle = seoTitle ?? `${title} · Peak Journal`;
const pageDescription = description ?? `${title} — written by ${author ?? 'the Peak Snowsports team'} for the Peak Journal.`;

// Resolve hero — accept either a Sanity image ref or a /public path string.
const heroDisplaySrc =
  typeof hero === 'string'
    ? hero
    : hero?.asset?._ref
      ? urlFor(hero).width(1600).height(900).fit('crop').url()
      : undefined;
const heroAbsoluteUrl =
  typeof hero === 'string' && hero
    ? new URL(hero, SITE).toString()
    : hero && (hero as ImageRef)?.asset?._ref
      ? (urlFor(hero as ImageRef).width(1600).height(900).fit('crop').url() ?? `${SITE}/images/og/journal.jpg`)
      : `${SITE}/images/og/journal.jpg`;
const canonical = slug ? `${SITE}/journal/${slug}` : undefined;

const publishedIso = publishedAt
  ? (publishedAt instanceof Date ? publishedAt.toISOString() : new Date(publishedAt).toISOString())
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: pageDescription,
    image: [heroAbsoluteUrl],
    author: author
      ? {
          '@type': 'Person',
          name: author,
          // If the author matches an instructor slug we can't resolve it here; leave URL undefined.
        }
      : { '@id': `${SITE}/#organization` },
    publisher: { '@id': `${SITE}/#organization` },
    datePublished: publishedIso,
    dateModified: publishedIso,
    mainEntityOfPage: canonical,
    articleSection: category,
  },
  ...(slug
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Journal', item: `${SITE}/journal` },
            ...(category
              ? [
                  {
                    '@type': 'ListItem',
                    position: 2,
                    name: category,
                    item: `${SITE}/journal/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
                  },
                ]
              : []),
            { '@type': 'ListItem', position: category ? 3 : 2, name: title, item: canonical },
          ],
        },
      ]
    : []),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={heroAbsoluteUrl}
  type="article"
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="px-6 pb-24 pt-16 md:pb-32 md:pt-24">
    <header class="mx-auto max-w-3xl">
      {category && (
        <a
          href={`/journal/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="meta inline-flex items-center rounded-sm bg-yellow px-3 py-1 text-snow no-underline transition hover:bg-ink"
        >
          {category}
        </a>
      )}
      <h1 class="mt-6 text-4xl leading-tight md:text-6xl">{title}</h1>
      <p class="meta mt-6 flex flex-wrap items-center gap-x-2 text-olive/60">
        {author && <span>{author}</span>}
        {author && date && <span>·</span>}
        {date && <span>{date}</span>}
        {(author || date) && readingMinutes && <span>·</span>}
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </p>
    </header>

    {heroDisplaySrc ? (
      <img
        src={heroDisplaySrc}
        alt={heroAlt}
        class="mx-auto mt-16 aspect-[16/9] w-full max-w-5xl rounded-3xl object-cover"
      />
    ) : (
      <div class="mx-auto mt-16 aspect-[16/9] max-w-5xl overflow-hidden rounded-3xl bg-brown" aria-hidden="true" />
    )}

    <div class="article-prose prose prose-lg mx-auto mt-16 max-w-2xl
      prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-snow
      prose-h2:mt-12 prose-h2:text-3xl md:prose-h2:text-4xl
      prose-h3:text-2xl
      prose-p:text-snow/80
      prose-li:text-snow/80 prose-li:marker:text-snow/40
      prose-strong:text-snow
      prose-a:text-snow prose-a:underline-offset-4 hover:prose-a:bg-yellow
      prose-blockquote:border-l-yellow prose-blockquote:not-italic prose-blockquote:font-display prose-blockquote:font-semibold prose-blockquote:text-snow
      prose-img:rounded-2xl">
      <slot />
    </div>
  </article>
</BaseLayout>
