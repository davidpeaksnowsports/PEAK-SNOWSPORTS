---
/**
 * "In a hurry": the six things a student reaches for under pressure.
 *
 * Rendered by GapLayout above the footer on every signed-in page, so the
 * emergency number is never more than a scroll away, wherever the student is.
 * Emergency contacts stays the one filled button.
 */
const links = [
  { href: '/gap/essentials#emergency', label: 'Emergency contacts' },
  { href: '/gap/resort', label: 'Resort map' },
  { href: '/gap/checklist', label: 'Packing list' },
  { href: '/gap/experience', label: 'Log experience hours' },
  { href: '/gap/checkin', label: 'Weekly check-in' },
  { href: '/gap/feedback', label: 'Ask for help' },
];
---

<section aria-labelledby="gap-hurry" class="border-t border-ink/10 pt-10">
  <h2 id="gap-hurry" class="font-display text-2xl font-bold">In a hurry</h2>
  <ul class="mt-6 flex flex-wrap gap-3">
    {
      links.map((l, i) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'inline-block px-5 py-3 font-display font-bold no-underline transition-colors hover:no-underline',
              i === 0
                ? 'bg-accent text-paper hover:bg-ink'
                : 'border border-ink/20 text-ink hover:border-ink',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
