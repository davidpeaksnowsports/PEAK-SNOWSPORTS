---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}

const { href, variant = 'primary', class: className = '', ...rest } = Astro.props;

// Winter Collection: 2px radius, sentence case, accent fill or hairline outline.
const base = 'inline-flex items-center justify-center gap-2 rounded-sm px-7 py-3.5 font-display text-sm font-semibold no-underline transition';
const variants = {
  primary: 'bg-accent text-snow hover:bg-ink',
  secondary: 'border border-ink/30 text-ink hover:border-ink',
  ghost: 'text-accent hover:text-ink',
};

const cls = `${base} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={cls} {...rest}><slot /></a>
) : (
  <button class={cls} {...rest}><slot /></button>
)}
