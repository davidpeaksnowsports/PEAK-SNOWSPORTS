---
/** Key figures as tiles, like the facts strip under the site's heroes. */
interface Props {
  node: { items?: { value?: string; label?: string }[] };
}
const items = Astro.props.node.items ?? [];
---
<dl class="not-prose my-8 grid grid-cols-2 gap-px border border-ink/10 bg-ink/10 md:grid-cols-4">
  {items.map((f) => (
    <div class="flex flex-col-reverse gap-2 bg-paper p-5">
      <dt class="text-sm leading-snug text-ink-70">{f.label}</dt>
      <dd class="font-display text-3xl font-bold leading-none tracking-tight text-ink">{f.value}</dd>
    </div>
  ))}
</dl>
