---
/**
 * Stages in order. Up to five read as a row with arrows on wide screens; more
 * become a numbered grid, three across, so a long sequence doesn't stack into
 * a tower. On a phone both are a single column, so nothing scrolls sideways.
 */
import { inlineMarkdown } from '../../lib/hq/inline';

interface Props {
  node: { steps?: { title?: string; text?: string }[] };
}
const steps = Astro.props.node.steps ?? [];
const row = steps.length <= 5;
---
{row ? (
  <ol class="not-prose my-8 flex flex-col gap-0 lg:flex-row lg:items-stretch">
    {steps.map((s, i) => (
      <li class="flex flex-col lg:flex-1 lg:flex-row lg:items-center">
        <div class="h-full flex-1 border border-ink/15 bg-paper p-4">
          <p class="meta text-accent">{String(i + 1).padStart(2, '0')}</p>
          <p class="mt-2 font-display text-base font-bold leading-snug tracking-tight text-ink">{s.title}</p>
          {s.text && <p class="mt-1 text-sm leading-relaxed text-ink-70 [&_a]:text-accent" set:html={inlineMarkdown(s.text)} />}
        </div>
        {i < steps.length - 1 && (
          <span aria-hidden="true" class="flex items-center justify-center py-1 text-ink-45 lg:px-1.5 lg:py-0">
            <span class="lg:hidden">↓</span>
            <span class="hidden lg:inline">→</span>
          </span>
        )}
      </li>
    ))}
  </ol>
) : (
  <ol class="not-prose my-8 grid gap-px border border-ink/15 bg-ink/15 sm:grid-cols-2 lg:grid-cols-3">
    {steps.map((s, i) => (
      <li class="flex gap-4 bg-paper p-4">
        <span class="meta inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-paper">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="min-w-0">
          <span class="block font-display text-base font-bold leading-snug tracking-tight text-ink">{s.title}</span>
          {s.text && <span class="mt-1 block text-sm leading-relaxed text-ink-70 [&_a]:text-accent" set:html={inlineMarkdown(s.text)} />}
        </span>
      </li>
    ))}
  </ol>
)}
