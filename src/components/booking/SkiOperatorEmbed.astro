---
/**
 * SkiOperator booking embed (publishable-key mode).
 *
 * Renders a static iframe pointed at SkiOperator. The pub_ key, tenant and
 * source origin are baked into the src at build time. No client-side JS, no
 * server token endpoint — SkiOperator gates access via the origin allowlist
 * configured in its admin (Settings → Embed).
 *
 * pub_ keys are safe in browser code. See https://www.ski-operator.com/docs/embed.
 *
 * Env (all PUBLIC_-prefixed — read at build time, inlined into HTML):
 *   PUBLIC_SKI_OPERATOR_TENANT      — tenant UUID
 *   PUBLIC_SKI_OPERATOR_PUBLIC_KEY  — pub_… key
 *
 * Checkout redirects the top-level browser to the payment provider, so we
 * deliberately do NOT set an iframe `sandbox` — a sandbox would break that
 * navigation.
 */
interface Props {
  /** Accessible iframe title. Announced by screen readers. */
  title: string;
  /** Optional Tailwind classes on the iframe wrapper. */
  class?: string;
}

const { title, class: className = '' } = Astro.props;

const APP_URL = 'https://www.ski-operator.com';
const EMBED_PATH = '/app/embed/products';

// Peak Snowsports tenant + pub_ key. Both are browser-safe per the SkiOperator
// docs — security is enforced by the origin allowlist on the SkiOperator side.
// Env vars override for reuse / rotation without touching this file.
const DEFAULT_TENANT = '6aa55bc3-cfc9-40e4-a4ce-541349868b5a';
const DEFAULT_PUBLIC_KEY = 'pub_149c82388384fa9dbb3d33388378b783a996';

const tenant = import.meta.env.PUBLIC_SKI_OPERATOR_TENANT || DEFAULT_TENANT;
const publicKey = import.meta.env.PUBLIC_SKI_OPERATOR_PUBLIC_KEY || DEFAULT_PUBLIC_KEY;

// The parent-site origin SkiOperator validates against its allowlist.
// `Astro.site` comes from `site:` in astro.config.mjs.
const sourceOrigin = Astro.site?.origin ?? '';

const configured = Boolean(tenant && publicKey && sourceOrigin);

const params = new URLSearchParams({
  embed: '1',
  tenant,
  sourceOrigin,
  public_key: publicKey,
});
const src = `${APP_URL}${EMBED_PATH}?${params.toString()}`;
---

{configured ? (
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="payment"
    class:list={['block w-full', className]}
    style="min-height:900px; border:0;"
  />
) : (
  <div class:list={['skioperator-embed', className]}>
    <p class="meta py-12 text-center text-olive/60">
      Booking widget not configured. <a href="/contact" class="underline-offset-4 hover:bg-yellow hover:underline">Get in touch</a> and we'll book you in directly.
    </p>
  </div>
)}
