---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Hero — type-led in the Winter Collection.
 *
 * The Summer hero overlaid the headline on a full-bleed image. Without colour
 * to hold the two apart, type has to carry the page, so the headline now sits
 * on paper at display size and the image follows as a bounded band. It trades
 * atmosphere for authority, which is the point of the monochrome direction.
 *
 * `facts` renders the metadata strip under the headline — the grid device that
 * gives the hero a second register without adding another surface.
 */
interface Props {
  kicker?: string;
  headline: string;
  sub?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  tertiaryCta?: { href: string; label: string };
  variant?: 'full' | 'compact';
  image?: ImageMetadata;
  imageAlt?: string;
  video?: string;
  videoPoster?: string;
  facts?: { label: string; value: string }[];
}

const {
  kicker,
  headline,
  sub,
  primaryCta,
  secondaryCta,
  tertiaryCta,
  variant = 'full',
  image,
  imageAlt = '',
  video,
  videoPoster,
  facts,
} = Astro.props;

const mediaHeight = variant === 'full' ? 'h-[42vh] min-h-[300px] md:h-[52vh]' : 'h-[30vh] min-h-[220px]';
const hasCta = primaryCta || secondaryCta || tertiaryCta;
---

<section class="bg-snow px-6 pt-16 md:px-10 md:pt-20">
  <div class="mx-auto max-w-screen-2xl">
    {kicker && <p class="meta mb-6 text-ink-70">{kicker}</p>}

    <h1 class="max-w-[16ch] text-5xl leading-[0.88] tracking-[-0.045em] md:text-7xl lg:text-8xl">
      {headline}
    </h1>

    <div class="mt-8 grid grid-cols-12 items-start gap-x-6 gap-y-8">
      {sub && (
        <p class="col-span-12 max-w-[46ch] text-lg leading-relaxed text-ink-70 md:col-span-6 md:text-xl">
          {sub}
        </p>
      )}
      {hasCta && (
        <div class="col-span-12 flex flex-wrap gap-3 md:col-span-6 md:justify-end">
          {primaryCta && (
            <a
              href={primaryCta.href}
              class="inline-flex items-center rounded-sm bg-accent px-7 py-3.5 font-display text-sm font-semibold text-snow no-underline transition hover:bg-ink"
            >
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="inline-flex items-center rounded-sm border border-ink/30 px-7 py-3.5 font-display text-sm font-semibold no-underline transition hover:border-ink"
            >
              {secondaryCta.label}
            </a>
          )}
          {tertiaryCta && (
            <a
              href={tertiaryCta.href}
              class="inline-flex items-center rounded-sm border border-ink/30 px-7 py-3.5 font-display text-sm font-semibold no-underline transition hover:border-ink"
            >
              {tertiaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>

    {facts && facts.length > 0 && (
      <dl class="mt-12 grid grid-cols-12 gap-x-6 gap-y-6 border-y border-ink/15 py-6">
        {facts.map((f) => (
          <div class="col-span-6 md:col-span-3">
            <dt class="meta text-ink-70">{f.label}</dt>
            <dd class="mt-2 font-display text-xl font-semibold tracking-tight">{f.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

{(video || image) && (
<div class={`relative w-full overflow-hidden bg-ink ${mediaHeight} ${facts ? '' : 'mt-14 md:mt-16'}`}>
  {video ? (
    <video
      class="h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={videoPoster}
      aria-label={imageAlt}
    >
      <source src={video} type="video/mp4" />
    </video>
  ) : image && (
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  )}
</div>
)}

{!video && !image && <div class="pb-16 md:pb-20"></div>}
