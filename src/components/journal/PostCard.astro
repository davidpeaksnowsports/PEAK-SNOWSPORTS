---
import { urlFor } from '../../lib/sanity';

type ImageRef = { asset?: { _ref?: string } } & Record<string, unknown>;

interface Props {
  title: string;
  category?: string;
  author?: string;
  date?: string;
  href?: string;
  // Either a Sanity image ref (preferred) or a path under /public.
  hero?: ImageRef | string;
  readingMinutes?: number;
  featured?: boolean;
}

const {
  title,
  category,
  author,
  date,
  href = '#',
  hero,
  readingMinutes,
  featured = false,
} = Astro.props;

const aspect = featured ? 'aspect-[16/9] md:aspect-[2/1]' : 'aspect-[16/10]';
const titleSize = featured ? 'text-2xl md:text-4xl' : 'text-xl md:text-2xl';

const width = featured ? 1600 : 900;
const height = featured ? 800 : 600;
const heroSrc =
  typeof hero === 'string'
    ? hero
    : hero?.asset?._ref
      ? urlFor(hero).width(width).height(height).fit('crop').url()
      : undefined;
---

<a href={href} class="group block no-underline">
  <div class={`w-full overflow-hidden rounded-none bg-brown ${aspect}`}>
    {heroSrc && (
      <img
        src={heroSrc}
        alt=""
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
        aria-hidden="true"
      />
    )}
  </div>

  <div class="mt-6">
    {category && (
      <span class="meta inline-flex items-center rounded-sm bg-yellow px-3 py-1 text-snow">
        {category}
      </span>
    )}
    <h3 class={`mt-4 font-semibold leading-snug underline-offset-4 group-hover:underline ${titleSize}`}>{title}</h3>
    {(author || date || readingMinutes) && (
      <p class="meta mt-4 flex flex-wrap items-center gap-x-2 text-olive/50">
        {author && <span>{author}</span>}
        {author && date && <span>·</span>}
        {date && <span>{date}</span>}
        {(author || date) && readingMinutes && <span>·</span>}
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </p>
    )}
  </div>
</a>
