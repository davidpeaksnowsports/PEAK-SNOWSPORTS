---
/**
 * A single vacancy on the /join board. Hairline column in the Card idiom —
 * top rule, kicker, title, blurb, then the terms that decide whether someone
 * clicks: where, when, and what kind of contract.
 */
interface Props {
  href: string;
  kicker: string;
  title: string;
  summary: string;
  locations: string[];
  employmentType: string;
  dates?: string;
  open?: boolean;
}

const { href, kicker, title, summary, locations, employmentType, dates, open = true } = Astro.props;

const facts = [
  { label: 'Where', value: locations.join(' · ') },
  { label: 'Contract', value: employmentType },
  dates ? { label: 'Season', value: dates } : null,
].filter((f) => f !== null) as { label: string; value: string }[];
---

<a
  href={href}
  class="group flex h-full flex-col border-t border-ink/25 pt-5 text-ink no-underline transition-colors hover:border-accent hover:no-underline"
>
  <div class="flex items-baseline justify-between gap-4">
    <p class="meta text-ink-70">{kicker}</p>
    <p class={`meta shrink-0 ${open ? 'text-accent' : 'text-ink-45'}`}>
      {open ? 'Open' : 'Closed'}
    </p>
  </div>

  <h3 class="mt-3 font-display text-2xl font-semibold leading-tight tracking-tight md:text-3xl">
    {title}
  </h3>

  <p class="mt-3 max-w-[42ch] text-base leading-relaxed text-ink-70">{summary}</p>

  <dl class="mt-6 space-y-2 border-t border-ink/10 pt-5">
    {facts.map((f) => (
      <div class="grid grid-cols-[5.5rem_1fr] gap-3">
        <dt class="meta text-ink-45">{f.label}</dt>
        <dd class="text-sm leading-snug text-ink-70">{f.value}</dd>
      </div>
    ))}
  </dl>

  <span class="mt-6 inline-flex items-center font-display text-sm font-semibold text-accent transition-colors group-hover:text-ink">
    Read the full role →
  </span>
</a>
